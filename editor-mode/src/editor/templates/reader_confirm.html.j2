<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ _('Conferma il messaggio') }}{% if site %} · {{ site }}{% endif %}</title>
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <section class="card pad">
    <h1 style="font-size: 22px;">{{ _('Conferma il messaggio') }}</h1>
    {% if state == 'ask' %}
    <p class="lead">{{ _('Il tuo messaggio alla redazione di {site}:', site=site) }}</p>
    <blockquote style="white-space: pre-wrap; margin: 0; padding: 12px 16px; border-left: 3px solid var(--line);">{{ message }}</blockquote>
    <form method="post" action="/feedback/confirm" style="display: flex; flex-direction: column; gap: 12px;">
      <input type="hidden" name="t" value="{{ token }}">
      <button class="btn pri" type="submit">{{ _('Conferma e invia alla redazione') }}</button>
    </form>
    {% elif state == 'confirmed' %}
    <p class="lead">{{ _('Grazie: il messaggio è arrivato alla redazione di {site}. Non viene pubblicato.', site=site) }}</p>
    {% elif state == 'already' %}
    <p class="lead">{{ _('Questo messaggio era già confermato.') }}</p>
    {% else %}
    <p class="lead">{{ _('Il link non vale più: i messaggi non confermati entro 48 ore vengono cancellati. Puoi scriverne uno nuovo dal sito.') }}</p>
    {% endif %}
    {% if back %}<a class="btn" href="https://{{ back }}/" rel="noopener">{{ _('Torna a {site}', site=site) }}</a>{% endif %}
  </section>
</main>
</body>
</html>
