{# The subscription of one newsroom: where it stands, the choice of a plan
   and its payment, the billing data, the cancellation. Shared by /account
   and the newsroom's own Piano page; `back` tells the forms where to return. #}
{% set sub = r.subscription %}
{% set c = r.customer or {} %}
      {% if not sub %}
        <p class="lead">{{ _('Nessun abbonamento registrato per questa redazione.') }}</p>
      {% elif sub.status == 'trialing' %}
        <p class="lead">{{ _('Sei in prova fino al <strong>{date}</strong> ({n} giorno). Scegli un piano prima di allora per continuare senza interruzioni.', date=sub.trial_ends_at.strftime('%d/%m/%Y'), n=sub.days_left) if sub.days_left == 1 else _('Sei in prova fino al <strong>{date}</strong> ({n} giorni). Scegli un piano prima di allora per continuare senza interruzioni.', date=sub.trial_ends_at.strftime('%d/%m/%Y'), n=sub.days_left) }}</p>
      {% elif sub.status == 'active' %}
        <p class="lead">{{ _('Piano {plan}, annuale.', plan=sub.plan_name) if sub.billing_interval == 'year' else _('Piano {plan}, mensile.', plan=sub.plan_name) }}{% if sub.current_period_end %} {{ _('Rinnovo il {date}.', date=sub.current_period_end.strftime('%d/%m/%Y')) }}{% endif %}</p>
      {% elif sub.status == 'past_due' %}
        <p class="error">{{ _("L'ultimo pagamento non è riuscito. Il circuito riprova nei prossimi giorni; se vuoi, paga di nuovo qui sotto.") }}</p>
      {% elif sub.status == 'canceled' %}
        <p class="lead">{% if sub.current_period_end %}{{ _('Abbonamento disdetto: la redazione resta attiva fino al {date}, poi si ferma. Puoi riattivarla scegliendo un piano.', date=sub.current_period_end.strftime('%d/%m/%Y')) }}{% else %}{{ _('Abbonamento disdetto: la redazione resta attiva, poi si ferma. Puoi riattivarla scegliendo un piano.') }}{% endif %}</p>
      {% elif sub.status == 'expired' and sub.desired_plan and sub.desired_plan == sub.plan_code %}
        <p class="lead">{{ _('<strong>Hai scelto il piano {plan}</strong>: la redazione parte appena il pagamento è confermato. Controlla i dati di fatturazione e vai al pagamento.', plan=sub.plan_name) }}</p>
      {% elif sub.status == 'expired' and r.active %}
        <p class="lead">{{ _('La prova o il periodo pagato è finito: ricevi solo le proposte, due al giorno per sito. Scegli un piano per scrivere bozze e pubblicare.') }}</p>
      {% else %}
        <p class="lead">{{ _('<strong>La redazione è ferma</strong>: la prova o il periodo pagato è finito. I tuoi siti, profili, fonti e bozze sono conservati: scegli un piano e riparte da dove era.') }}</p>
      {% endif %}

      {% if r.reseller %}
        <p class="hint">{{ _('Questa redazione è fatturata dal tuo rivenditore: per cambiare piano scrivi a lui.') }}</p>
      {% else %}
        {% set changing = sub and sub.status == 'active' %}
        {% if changing %}
        <details class="act" id="change-plan">
        <summary><span class="ico" aria-hidden="true">⇄</span>{{ _('Cambia piano') }}</summary>
        <p class="hint">{{ _('Il nuovo piano parte appena paghi, con un periodo intero; il piano attuale non si rinnova più. I giorni già pagati del piano attuale non vengono rimborsati: conviene cambiare vicino al rinnovo.') }}</p>
        {% else %}
        <h3>{{ _('Scegli il piano') }}</h3>
        {% endif %}
        {% set wished = plans|selectattr('code', 'equalto', sub.desired_plan)|first if sub and sub.desired_plan else none %}
        {% if wished and wished.code != sub.plan_code %}<p class="hint">{{ _('Sul sito hai scelto il piano {plan}: lo trovi già selezionato.', plan=wished.name) }}</p>{% endif %}
        {% if not r.customer %}<p class="hint">{{ _('Prima compila i dati di fatturazione qui sotto.') }}</p>{% endif %}
        <form method="post" action="/account/{{ r.tenant_id }}/checkout">
          {% if back %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
          {% for p in plans|selectattr('price_month_cents')|list %}
            <label class="card pad" style="cursor: pointer; display: block;">
              <span class="row"><input type="radio" name="plan" value="{{ p.code }}" {% if (changing and sub.plan_code == p.code) or (not changing and sub and sub.desired_plan == p.code) or (not changing and not (sub and sub.desired_plan in plans|selectattr('price_month_cents')|map(attribute='code')) and loop.first) %}checked{% endif %}> <strong>{{ p.name }}</strong></span>
              <div style="font-size: 22px; font-weight: 600; margin-top: 8px;">{{ money(p.price_month_cents, p.currency) }} <span class="hint">{{ _('al mese') }}</span></div>
              <div class="hint">{{ _("oppure {price} all'anno", price=money(p.price_year_cents, p.currency)) }}</div>
              <p class="hint">{{ p.description }}<br>
                {{ _('{n} sito', n=p.max_sites) if p.max_sites == 1 else _('{n} siti', n=p.max_sites) }}{% if p.max_drafts_month %} · {{ _('{n} articoli al mese', n=p.max_drafts_month) }}{% endif %}{% if p.max_active_sources %} · {{ _('{n} fonti attive', n=p.max_active_sources) }}{% endif %}</p>
            </label>
          {% endfor %}
          </div>
          <div class="row" style="margin-top: 12px; align-items: flex-end;">
            <label class="field">{{ _('Rinnovo') }}<select name="interval"><option value="month">{{ _('Mensile') }}</option><option value="year" {% if sub and (sub.billing_interval if changing else sub.desired_interval) == 'year' %}selected{% endif %}>{{ _('Annuale') }}</option></select></label>
            {% if online %}<button class="btn pri" type="submit" {% if not r.customer %}disabled{% endif %}>{{ _('Vai al pagamento') }}</button>
            {% else %}<span class="hint">{{ _("Il pagamento online non è ancora attivo: per attivare il piano contatta l'assistenza, lo registriamo noi.") }}</span>{% endif %}
          </div>
          <p class="hint">{{ _('Prezzi IVA esclusa. Il primo pagamento autorizza i rinnovi automatici, che puoi disdire quando vuoi da questa pagina.') }} {{ vat_note(r.customer) }}</p>
        </form>
        {% if changing %}</details>{% endif %}
      {% endif %}

      {# The billing data in one line, the form behind it: open only while they are missing. #}
      {% set town = [c.postal_code, c.city, ('(' ~ c.province ~ ')') if c.province else '']|select|join(' ') %}
      {% set place = [c.address, town]|select|join(', ') %}
      {% set fiscal = [(_('P.IVA {n}', n=c.vat_number) if c.vat_number else ''), (_('CF {n}', n=c.tax_code) if c.tax_code else ''), (_('SDI {n}', n=c.sdi_code) if c.sdi_code else ''), (_('PEC {n}', n=c.pec) if c.pec else '')]|select|join(' · ') %}
      <details class="act" data-tone="green" id="billing-{{ r.tenant_id }}" {% if not r.customer %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">€</span>{% if r.customer %}{{ _('Dati di fatturazione') }}<span class="sub">{{ c.name }}{% if fiscal %} · {{ fiscal }}{% endif %}{% if place %} · {{ place }}{% endif %} · {{ c.email }}</span>{% else %}{{ _('Dati di fatturazione') }}<span class="sub">{{ _('da compilare prima di pagare') }}</span>{% endif %}</summary>
        {% if r.customer and not (c.vat_number or c.tax_code) %}<p class="hint" style="margin: 0 14px;">{{ _('Per una fattura elettronica in Italia servono la partita IVA o il codice fiscale e il codice SDI o la PEC.') }}</p>{% endif %}
        <form method="post" action="/account/{{ r.tenant_id }}/customer" class="form-grid billing" style="margin-top: 8px;">
          {% if back %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
          <label class="field">{{ _('Tipo') }}<select name="kind"><option value="company">{{ _('Azienda o professionista') }}</option><option value="person" {% if c.kind == 'person' %}selected{% endif %}>{{ _('Privato') }}</option></select></label>
          <label class="field" style="grid-column: span 2;">{{ _('Ragione sociale o nome') }}<input name="name" value="{{ c.name or '' }}" required maxlength="200"></label>
          <label class="field">{{ _('Partita IVA') }}<input name="vat_number" value="{{ c.vat_number or '' }}" maxlength="40"></label>
          <label class="field">{{ _('Codice fiscale') }}<input name="tax_code" value="{{ c.tax_code or '' }}" maxlength="40"></label>
          <label class="field">{{ _('Codice destinatario SDI') }}<input name="sdi_code" value="{{ c.sdi_code or '' }}" maxlength="7"></label>
          <label class="field">{{ _('Email per le fatture') }}<input name="email" type="email" value="{{ c.email or me_email }}" required></label>
          <label class="field">{{ _('Telefono') }}<input name="phone" value="{{ c.phone or '' }}" maxlength="40"></label>
          <label class="field">{{ _('PEC') }}<input name="pec" type="email" value="{{ c.pec or '' }}"></label>
          <label class="field" style="grid-column: span 2;">{{ _('Indirizzo') }}<input name="address" value="{{ c.address or '' }}" maxlength="200"></label>
          <label class="field">{{ _('CAP') }}<input name="postal_code" value="{{ c.postal_code or '' }}" maxlength="20"></label>
          <label class="field">{{ _('Città') }}<input name="city" value="{{ c.city or '' }}" maxlength="100"></label>
          <label class="field">{{ _('Provincia') }}<input name="province" value="{{ c.province or '' }}" maxlength="10"></label>
          <label class="field">{{ _('Paese') }}<input name="country" value="{{ c.country or 'IT' }}" maxlength="2"></label>
          <div class="wide"><button class="btn" type="submit">{{ _('Salva i dati') }}</button></div>
        </form>
      </details>

      {# What was paid and refunded: the receipts of the newsroom. Checkouts
         left halfway are not payments and stay out. #}
      {% set pays = (r.payments or [])|rejectattr('status', 'in', ['open', 'canceled', 'expired'])|list %}
      {% if pays %}
      {% set what = {'first': _('primo pagamento'), 'recurring': _('rinnovo'), 'manual': _('pagamento registrato'), 'refund': _('rimborso'), 'credits': _('crediti')} %}
      {% set state = {'paid': ('green', _('pagato')), 'refunded': ('', _('rimborsato')), 'failed': ('red', _('non riuscito')), 'queued': ('amber', _('in corso')), 'pending': ('amber', _('in corso')), 'processing': ('amber', _('in corso'))} %}
      <h3 style="margin: 20px 0 6px;">{{ _('Pagamenti') }}</h3>
      <div class="scroll">
      <table class="tbl">
        <thead><tr><th>{{ _('Data') }}</th><th>{{ _('Cosa') }}</th><th>{{ _('Metodo') }}</th><th class="num">{{ _('Importo') }}</th><th>{{ _('Stato') }}</th></tr></thead>
        <tbody>
        {% for p in pays %}
        {% set st = state.get(p.status, ('', p.status)) %}
        <tr>
          <td class="num">{{ (p.paid_at or p.created_at).strftime('%d/%m/%Y') if (p.paid_at or p.created_at) else '–' }}</td>
          <td>{{ what.get(p.kind, p.kind) }}</td>
          <td>{{ _('online') if p.provider == 'mollie' else _('bonifico') }}</td>
          <td class="num">{{ '−' if p.kind == 'refund' }}{{ money(p.amount_cents, p.currency) }}</td>
          <td><span class="chip {{ st[0] }}">{{ st[1] }}</span></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
      {% endif %}

      {% if sub and sub.status in ('active', 'past_due', 'trialing') and not r.reseller %}
      <details class="act" data-tone="red">
        <summary><span class="ico" aria-hidden="true">✕</span>{{ _("Disdici l'abbonamento") }}</summary>
        <form method="post" action="/account/{{ r.tenant_id }}/cancel" style="margin-top: 8px;">
          {% if back %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
          <p class="hint">{{ _('Niente più rinnovi. La redazione resta attiva fino alla fine del periodo già pagato (o della prova), poi si ferma; i dati restano.') }}</p>
          <button class="btn danger" type="submit">{{ _('Disdici') }}</button>
        </form>
      </details>
      {% endif %}
