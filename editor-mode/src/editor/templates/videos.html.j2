{% extends "base.html.j2" %}
{% block title %}{{ _('Video social') }}{% endblock %}
{% block main %}
<header class="head">
  <div>
    <span class="kicker">{{ _('Video social') }}{% if site %} · {{ site.domain }}{% endif %}</span>
    <h1>{{ _('Video per Instagram, TikTok e YouTube Shorts') }}</h1>
    <p class="lead">{{ _('Dagli articoli e dai temi del momento, idee per clip verticali con voce e suono. Scegli l\'idea, il modello video la gira in qualche minuto, tu scarichi il video e lo pubblichi con il testo pronto. Nulla viene pubblicato da qui.') }}</p>
  </div>
</header>
{% if not vstate.on %}
<p class="notice">{{ _('I video non sono ancora attivi su questo server: l\'amministratore deve mettere una chiave di OpenRouter in Amministrazione › Impostazioni › Video social. Le idee si possono già scrivere.') }}</p>
{% endif %}
{% if site and caller.can('owner') %}
<section class="card pad" aria-labelledby="h-videos-day">
  <h2 id="h-videos-day">{{ _('Idee ogni mattina') }}</h2>
  {% if has_profile %}
  <form method="post" action="/ui/sites/{{ site.id }}/videos-per-day" class="row" style="gap: 8px; flex-wrap: wrap; align-items: end;">
    <label class="field">{{ _('Idee di video al giorno') }}<input name="n" type="number" min="0" max="10" value="{{ per_day }}" style="max-width: 90px;"></label>
    <label class="field">{{ _('Durata dei video') }}<select name="seconds">{% for x in (vstate.choices|map(attribute='seconds')|list or [10, 15, 20, 30]) %}<option value="{{ x }}"{% if x == seconds %} selected{% endif %}>{{ _('{n} secondi', n=x) }}</option>{% endfor %}</select></label>
    {% if vstate.montage %}<label class="field">{{ _('Scene per video') }}<select name="scenes">{% for x in range(1, vstate.max_scenes + 1) %}<option value="{{ x }}"{% if x == scenes %} selected{% endif %}>{{ x }}</option>{% endfor %}</select></label>{% endif %}
    <label class="field">{{ _('Lingua dei video') }}<select name="language">{% for code, name in vstate.languages.items() %}<option value="{{ code }}"{% if code == language %} selected{% endif %}>{{ _(name) }}</option>{% endfor %}</select></label>
    <button class="btn" type="submit">{{ _('Salva') }}</button>
  </form>
  <p class="hint">{{ _("All'ora del briefing il modello sceglie i temi più adatti a {domain}, prima quelli che stanno salendo e non sono ancora ovunque, e scrive un'idea di video per ognuno. Le idee sono gratis; si paga solo il video che fai girare. 0 le spegne.", domain=site.domain) }}</p>
  <p class="hint">{{ _("Le idee sono scritte nella lingua e per la durata scelte qui: la voce dura quanto il video. Su ogni idea puoi comunque scegliere un'altra durata prima di girarla, o rifarla in un'altra lingua.") }}</p>
  {% if vstate.montage %}<p class="hint">{{ _("Ogni scena è una clip a sé con la sua scritta in sovraimpressione e la sua parte di voce: più scene costano meno di una clip lunga (il modello fa pagare di più oltre i 15 secondi) e il video ha più ritmo. Per esempio 30 secondi in 3 scene sono 3 clip da 10 secondi.") }}</p>{% endif %}
  <p class="hint">{{ _("Oltre alle notizie guarda i social: i temi di cui si parla su Bluesky e quelli con Short in crescita su YouTube nelle ultime 48 ore passano avanti.") }}</p>
  {% else %}
  <p class="hint">{{ _('Approva prima il profilo in Sito e profilo: le idee partono dalla linea approvata.') }}</p>
  {% endif %}
</section>
{% endif %}
{% set made = videos|selectattr('status', 'in', ['queued', 'making', 'ready', 'failed'])|list %}
{% if made %}
{# What happened to the videos asked (Francesco, 2026-11-28: "non so che fine abbia fatto il video"). #}
<section class="card pad" aria-labelledby="h-videos-made">
  <h2 id="h-videos-made">{{ _('I tuoi video') }}</h2>
  {% for v in made[:10] %}
  <div class="row" style="justify-content: space-between; gap: 8px; padding: 6px 0; border-top: 1px solid var(--line);">
    <a href="#video-{{ v.id }}">{{ v.title }}</a>
    <span class="row" style="gap: 8px;">
      {% if v.seconds %}<span class="hint">{{ _('{n} secondi', n=v.seconds) }}</span>{% endif %}
      {% if v.status == 'ready' %}<span class="chip green">{{ _('Pronto') }}</span>{% if v.has_file %}<a class="btn sm pri" href="/videos/{{ v.id }}/file?download=1" download>{{ _('Scarica il video') }}</a>{% endif %}
      {% elif v.id in vstate.making %}<span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('In preparazione') }}</span>
      {% elif v.status == 'failed' %}<span class="chip amber" title="{{ (v.error or '')[:200] }}">{{ _('Non riuscito') }}</span>
      {% else %}<span class="chip amber">{{ _('Interrotto') }}</span>{% endif %}
    </span>
  </div>
  {% endfor %}
  <p class="hint">{{ _('Un video non riuscito o interrotto non costa crediti: lo rifai dalla sua scheda qui sotto.') }}</p>
</section>
{% endif %}
<section class="card pad" aria-labelledby="h-videos">
  <h2 id="h-videos">{{ _('Idee e video') }}</h2>
  {% if ideas_busy %}<p><span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('Idee in scrittura') }}</span></p>{% endif %}
  {% for v in videos %}
  <p class="hint" style="margin: 12px 0 0;">{% if v.draft_id %}{{ _('Dall\'articolo') }} <a href="/drafts/{{ v.draft_id }}">{{ v.article or ('#' ~ v.draft_id) }}</a>{% elif v.topic %}{{ _('Dal tema del momento «{topic}»', topic=v.topic) }}{% endif %}</p>
  {% with back='/videos#video-' ~ v.id %}{% include "_video.html.j2" %}{% endwith %}
  {% else %}
  <p class="empty">{{ _('Ancora nessuna idea. Chiedile dalla pagina di un articolo (riquadro «Video per i social») o da un tema in Trend e piano («Idee per i video»).') }}</p>
  {% endfor %}
  {% include "_video_cost.html.j2" %}
  <p class="hint">{{ _('Quando lo pubblichi, attiva l\'etichetta per i contenuti generati con l\'AI: Instagram, TikTok e YouTube la chiedono per i video realistici.') }} {{ _('I file restano qui 30 giorni, i testi sempre.') }}</p>
</section>
<script>
document.querySelectorAll('[data-copy]').forEach(function (b) {
  b.addEventListener('click', function () {
    var label = b.textContent;
    navigator.clipboard.writeText(document.getElementById(b.dataset.copy).value).then(function () {
      b.textContent = {{ _('Copiato')|string|tojson }};
      setTimeout(function () { b.textContent = label; }, 1500);
    });
  });
});
</script>
{% endblock %}
