{% extends "base.html.j2" %}
{% block title %}{{ _('Desk') }}{% endblock %}
{% block main %}
{# The Desk is the whole newsroom at a glance: every box is short and opens the page with the rest. #}
<header class="head">
  <div>
    <span class="kicker">{{ days[now.weekday()] }} {{ now.day }} {{ months[now.month - 1] }} · {{ one.domain if one else _('tutti i siti') }}</span>
    <h1>{{ _('Desk') }}</h1>
  </div>
  <div class="row">
    {% if briefing and (briefing.sent_email_at or briefing.sent_telegram_at) %}
      <span class="chip green">{{ _('Briefing inviato alle {time}', time=when(briefing.sent_email_at or briefing.sent_telegram_at, 'time')) }}</span>
    {% elif briefing %}
      <span class="chip amber">{{ _('Briefing pronto, non inviato') }}</span>
    {% else %}
      <span class="chip">{{ _('Briefing di oggi non ancora pronto') }}</span>
    {% endif %}
    <a class="btn" href="/trends">{{ _('Trend e piano') }}</a>
    {% if sites and caller.can('editor') %}
    <form class="inline" method="post" action="/ui/collect"><button class="btn pri" type="submit" title="{{ _('La raccolta legge le fonti di tutti i siti insieme, senza aspettare il giro orario.') }}">{{ _('Raccogli le notizie e il trend') }}</button></form>
    {% endif %}
  </div>
</header>
{% if starting or not sites %}{% with page="today" %}{% include "_help.html.j2" %}{% endwith %}{% endif %}

{% if starting and sites %}
{% set guide = (desk|selectattr('next')|list)[0] if desk else none %}
<section class="card pad" style="border-left: 4px solid var(--accent);">
  <h2>{{ _('Primi passi') }}</h2>
  <p class="lead">{% if guide %}{{ _('{domain}: il prossimo passo è «{step}».', domain=guide.domain, step=guide.next.title) }} {% endif %}{{ _('Il percorso guidato ti porta dal dominio al primo articolo pubblicato, un passo alla volta, con tutto quello che serve nella stessa pagina.') }}</p>
  <p><a class="btn pri" href="/start">{{ _('Continua i primi passi') }}</a></p>
</section>
{% endif %}

{% if not sites %}
<section class="card pad">
  <h2>{{ _('Inizia da un dominio') }}</h2>
  <p class="lead">{{ _('Redazia analizza il sito, propone un profilo editoriale con le prove e cerca le fonti da solo. Nulla parte prima della tua approvazione.') }}</p>
  {% if caller.can('owner') %}
  <form method="post" action="/ui/sites" class="form-grid">
    <label class="field">{{ _('Dominio') }}<input name="domain" placeholder="{{ _('esempio.it') }}" required></label>
    <div><button class="btn pri" type="submit">{{ _('Analizza il sito') }}</button></div>
  </form>
  {% endif %}
</section>
{% endif %}

{% for a in auto_cards %}
{% set day = a.day %}{% set last = a.last %}{% set cfg = a.cfg %}
<section class="card pad" aria-labelledby="h-auto-{{ a.site.id }}" style="border-left: 4px solid var(--teal);">
  <div class="row" style="justify-content: space-between; align-items: center;">
    <h2 id="h-auto-{{ a.site.id }}">{{ _('La redazione automatica di {domain}, oggi', domain=a.site.domain) }}</h2>
    <span class="chip green">{{ _('Accesa') }}</span>
  </div>
  <p class="lead"><strong>{{ _('Oggi: {p} pubblicati, {d} scartati, {h} fermati per te.', p=day.published, d=day.discarded, h=day.held) }}</strong>
  {% if not last %}{{ _('Non ha ancora fatto un giro: parte al prossimo giro orario.') }}
  {% elif last.waiting == 'plan' %}{{ _('fermo, il piano della redazione non comprende la redazione automatica.') }}
  {% elif last.waiting == 'month' %}{{ _('fermo, finiti gli articoli del mese del piano: riparte il mese prossimo, oppure chiedi più articoli.') }}
  {% elif last.waiting == 'hours' %}{{ _('fuori orario, riparte alle {h}.', h=cfg.hours[0]) }}
  {% elif last.done %}{{ _('Ha fatto gli articoli di oggi ({n} su {tot}) e riprende domani alle {h}:00.', n=last.done, tot=cfg.per_day, h='%02d'|format(cfg.hours[0])) }}{% if cfg.borrow or cfg.extra_credits %} {{ _('Se arriva una notizia importante può ancora uscirne una in più (fino a {a} anticipate dal giorno dopo, {c} con i crediti).', a=cfg.borrow, c=cfg.extra_credits) }}{% endif %}
  {% elif last.tried %}{{ _('fermo per oggi: ha già provato {t} articoli e ne ha tenuti {k}, gli altri non passavano i controlli. Riparte domani.', t=last.tried, k=last.kept) }}
  {% elif last.accepted %}{{ _('ha scelto {n} proposte, le scrive e le pubblica.', n=last.accepted|length) }}
  {% else %}{{ _('nessuna proposta adatta in quest\'ora: servono opportunità almeno {o} e notizie da almeno {f} fonti diverse. Riprova al prossimo giro.', o=cfg.min_opportunity|int, f=cfg.min_sources) }}{% endif %}</p>
  {% if day['items'] %}
  <ul class="plain">{% for x in day['items'][:8] %}<li>
    {% if x.publication == 'published' and a.urls.get(x.id) %}<a href="{{ a.urls[x.id] }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}<a href="/drafts/{{ x.id }}">{{ x.title }}</a>{% endif %}
    · {% if x.discarded is not none %}<span class="chip" title="{{ x.discarded }}">{{ _('scartato') }}</span>{% elif x.held %}<span class="chip amber" title="{{ x.held }}">{{ _('fermato') }}</span>{% elif x.publication == 'published' %}<span class="chip green">{{ _('pubblicato') }}</span>{% elif x.publication == 'failed' %}<span class="chip red">{{ _('pubblicazione non riuscita') }}</span>{% elif x.status == 'approved' %}<span class="chip">{{ _('approvato') }}</span>{% else %}<span class="chip">{{ _('in lavorazione') }}</span>{% endif %}
    {% if x.publication == 'published' and caller.can('owner') %}<a class="hint" href="/drafts/{{ x.id }}">{{ _('modifica o ritira') }}</a>{% endif %}
    {% if x.discarded %}<br><span class="hint">{{ _('Motivo:') }} {{ x.discarded[:240] }}</span>{% elif x.held %}<br><span class="hint">{{ _('Motivo:') }} {{ x.held[:240] }}</span>{% endif %}
  </li>{% endfor %}</ul>
  {% if day['items']|length > 8 %}<p class="hint"><a href="/drafts">{{ _('Vedi tutti ({n})', n=day['items']|length) }}</a></p>{% endif %}
  {% else %}<p class="hint">{{ _('Nessun articolo oggi per ora.') }}</p>{% endif %}
  {% if a.left_out %}
  <p class="notice-up">{{ _('Notizie di qualità rimaste fuori dal tetto di oggi: {n}. Si pubblicherebbero con più articoli al giorno.', n=a.left_out) }}
    {% if caller.can('owner') %}<a class="btn sm pri" href="/plan">{{ _('Sblocca più articoli') }}</a>{% endif %}</p>
  {% endif %}
  <p class="hint">{{ _('Sceglie da sola fra le proposte: quelle che non usa scadono dopo un giorno e mezzo, non devi deciderle. Tutti gli articoli sono in') }} <a href="/publications">{{ _('Pubblicazioni') }}</a>{% if caller.can('owner') %} · <a href="/switch?site={{ a.site.id }}&amp;back={{ '/site?tab=auto'|urlencode }}">{{ _('Cambia articoli al giorno e regole') }}</a>{% endif %}.</p>
</section>
{% endfor %}

{% if limits %}
<section class="limits" aria-label="{{ _('Limiti') }}">
  {% for x in limits %}
  <div class="limit {{ x.level }}" title="{{ x.note }}">
    <span class="top"><span>{{ x.label }}</span><strong>{{ x.used }} / {{ x.limit }}</strong></span>
    <span class="gauge"><i style="width: {{ x.pct }}%"></i></span>
    {% if x.note %}<small>{{ x.note }}</small>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

<section class="kpis" aria-label="{{ _('Riepilogo') }}">
  {% if decisions %}
  <a class="card kpi warn" href="#h-decide">
    <span class="label">{{ _('Da decidere') }}</span>
    <span class="value">{{ decisions }}</span>
    <span class="note">{{ profile_drafts|length|plural(_('profilo'), _('profili')) }} · {{ proposed_total|plural(_('proposta'), _('proposte')) }} · {{ pending_pubs|length|plural(_('pubblicazione'), _('pubblicazioni')) }}</span>
  </a>
  {% endif %}
  {% if proposed_total %}
  <a class="card kpi" href="/trends#h-plan">
    <span class="label">{{ _('Proposte nel piano') }}</span>
    <span class="value">{{ proposed_total }}</span>
    <span class="note">{{ _('{n} da stamattina', n=new_today|plural(_('nuova'), _('nuove'))) }}</span>
  </a>
  {% endif %}
  {% if drafts_ready %}
  <a class="card kpi" href="/drafts">
    <span class="label">{{ _('Bozze pronte') }}</span>
    <span class="value">{{ drafts_ready }}</span>
    <span class="note">{% if needs_review %}{{ _('{n} da rivedere a mano', n=needs_review) }}{% else %}{{ _('tutte con i controlli superati') }}{% endif %}</span>
  </a>
  {% endif %}
  <a class="card kpi{% if sites and not news_day %} bad{% endif %}" href="/trends">
    <span class="label">{{ _('Notizie in 24 ore') }}</span>
    <span class="value">{{ news_day }}</span>
    <span class="note">{% if sites and not news_day %}{{ _('nessuna: controlla la raccolta') }}{% else %}{{ _('ultimo giro alle {time}', time=when(last_fetch, 'time')) }}{% endif %}</span>
  </a>
  <a class="card kpi" href="/sources">
    <span class="label">{{ _('Fonti attive') }}</span>
    <span class="value">{{ collected.sources }}</span>
    <span class="note">{{ _('in tutti i siti') if sites|length > 1 and not one else _('del sito') }}</span>
  </a>
  {% if caller.operator %}
  <div class="card kpi">
    <span class="label">{{ _('Costo modello, 30 giorni') }}</span>
    <span class="value">{{ cost_month|num(2) }}</span>
    <span class="note" title="{{ _('ai prezzi di core.yaml') }}">{{ _('{n} chiamate', n=calls_month|tok) }}</span>
  </div>
  {% elif credit_state and credit_state.enabled %}
  <a class="card kpi{% if credit_state.pct >= 100 %} bad{% elif credit_state.pct >= 80 %} warn{% endif %}" href="/plan#crediti">
    <span class="label">{{ _('Crediti del mese') }}</span>
    <span class="value">{{ credit_state.month_left }}</span>
    <span class="note">{{ _('rimasti su {n}', n=credit_state.month) }}{% if credit_state.extra %} · {{ _('{n} extra', n=credit_state.extra) }}{% endif %}</span>
  </a>
  {% endif %}
</section>

<div class="board{% if not decisions %} even{% endif %}">
  {% if decisions %}
  <section class="card" aria-labelledby="h-decide">
    <div class="card-head"><h2 id="h-decide">{{ _('Da decidere') }}</h2><span class="hint">{{ _('Nulla esce senza il tuo sì') }}{% if proposed_total > 6 %} · <a href="/trends#h-plan">{{ _('Tutte ({n})', n=proposed_total) }}</a>{% endif %}</span></div>
    {% for p in profile_drafts %}
    <div class="item line">
      <span class="chip amber">{{ _('Profilo') }}</span>
      <div class="what"><strong>{{ p.domain }}</strong><span class="one">{{ _('v{version} da approvare', version=p.version) }}{% if p.changes %} · {{ p.changes|length|plural(_('cambiamento'), _('cambiamenti')) }}{% endif %}</span></div>
      <a class="btn sm pri" href="/switch?site={{ p.site_id }}&amp;back=/site">{{ _('Vedi il profilo') }}</a>
    </div>
    {% endfor %}
    {% for p in pending_pubs %}
    <div class="item line">
      <span class="chip blue">{{ _('Pubblicazione') }}</span>
      <div class="what"><strong>{{ p.title }}</strong><span class="one">{{ _('Verso {target}', target=p.target) }} · {{ _('come bozza') if p.mode == 'draft' else _('pubblicata subito') }}</span></div>
      <a class="btn sm" href="/drafts/{{ p.draft_id }}">{{ _('Leggi') }}</a>
      {% if caller.can('owner') %}
      <form class="inline" method="post" action="/ui/publications/{{ p.id }}/decision"><input type="hidden" name="accept" value="1"><button class="btn sm pri" type="submit">{{ _('Approva') }}</button></form>
      {% endif %}
    </div>
    {% endfor %}
    {% for p in proposed[:6] %}{% set d = explained.get(p.id) %}
    <details class="item line prop-line">
      <summary>
        <span class="chip">{{ p.domain }}</span>
        <span class="what"><strong>{{ d.title if d else p.title }}</strong><span class="one">{% if p.site_id in auto_sites %}<span class="chip teal" title="{{ _('La redazione automatica sceglie da sola fra queste proposte: puoi comunque accettarne una tu.') }}">{{ _('la sceglie la redazione automatica') }}</span> {% endif %}{% if d and d.single %}{{ _('notizia singola') }}{% elif d %}{{ d.format }}{% endif %}{% if d and d.news %} · {{ d.news[0].source }}{% endif %}</span></span>
        <span class="hint more">{{ _('dettagli') }}</span>
      </summary>
      <div class="detail">{% include "_proposal.html.j2" %}
        {% if caller.can('editor') %}
        <div class="row" style="margin-top: 10px;">
          {% with back='/#h-decide' %}{% include "_discard.html.j2" %}{% endwith %}
          <form class="inline" method="post" action="/ui/proposals/{{ p.id }}"><input type="hidden" name="accept" value="1"><input type="hidden" name="back" value="/#h-decide"><button class="btn sm pri" type="submit">{{ _('Accetta e scrivi la bozza') }}</button></form>
        </div>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  <div class="stack">
    {% include "_activity.html.j2" %}

    <section class="card" aria-labelledby="h-raccolta">
      <div class="card-head"><h2 id="h-raccolta">{{ _('Raccolta') }}</h2><span class="hint">{{ _('ogni ora') }} · <a href="/sources">{{ _('Fonti') }}</a></span></div>
      <div class="pad" style="gap: 8px;">
        <div class="trio">
          <div><span class="num">{{ collected.sources }}</span><small>{{ _('fonti attive') }}</small></div>
          <div><span class="num">{{ collected.today }}</span><small>{{ _('notizie oggi') }}</small></div>
          <div><span class="num">{{ when(last_fetch, 'time') }}</span><small>{{ _('ultimo giro') }}</small></div>
        </div>
        {% if core_trouble %}
        <span class="note warn">{{ _("L'ultimo giro non ha letto {n} fonti perché la redazione ha finito le letture del giorno: riparte domani, oppure alza il limite delle letture.", n=core_trouble.n) if core_trouble.limit else _("L'ultimo giro non ha letto {n} fonti perché il motore dell'agente non rispondeva: riprova da solo al prossimo giro.", n=core_trouble.n) }}</span>
        {% endif %}
        {% if stopped %}
        <details class="act sm" data-tone="amber" style="margin: 0;">
          <summary><span class="ico" aria-hidden="true">!</span>{{ _('{n} fonti sospese da sole negli ultimi 7 giorni', n=stopped|length) }}</summary>
          {% for x in stopped %}
          <div class="hint"><a href="/switch?site={{ x.site_id }}&amp;back={{ '/sources?status=suspended'|urlencode }}">{{ x.name }}</a>{% if sites|length > 1 %} · {{ x.domain }}{% endif %}: {{ x.status_reason|problem if x.status_reason else _('nessuna notizia recente') }}</div>
          {% endfor %}
        </details>
        {% endif %}
      </div>
    </section>
  </div>
</div>

{% if desk %}
<section class="card" aria-labelledby="h-desk">
  <div class="card-head"><h2 id="h-desk">{{ _('Siti') }}</h2><span class="hint">{{ _('{n} siti', n=desk|length) if desk|length != 1 else _('1 sito') }}{% if caller.can('owner') %} · <a href="/settings#h-sites">{{ _('+ Aggiungi un sito') }}</a>{% endif %}</span></div>
  <div class="scroll">
  <table class="sites">
    <thead><tr>
      <th>{{ _('Sito') }}</th><th>{{ _('Profilo') }}</th><th>{{ _('Fonti attive') }}</th><th>{{ _('Notizie 24 ore') }}</th>
      <th>{{ _('Proposte') }}</th><th>{{ _('Bozze') }}</th>{% if caller.operator %}<th>{{ _('Costo 30 giorni') }}</th>{% endif %}<th>{{ _('Prossimo passo') }}</th>{% if caller.can('editor') %}<th>{{ _('Lancia') }}</th>{% endif %}
    </tr></thead>
    <tbody>
    {% for x in desk %}
    <tr>
      <td><a href="/switch?site={{ x.id }}&amp;back=/site">{{ x.domain }}</a>{% if x.working %} <span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('al lavoro') }}</span>{% endif %}</td>
      <td>{% if x.pending %}<a class="chip amber" href="/switch?site={{ x.id }}&amp;back=/site">{{ _('v{version} da approvare', version=x.pending) }}</a>{% elif x.approved %}<span class="chip">{{ _('v{version} in uso', version=x.approved) }}</span>{% else %}<span class="chip">{{ _('in analisi') }}</span>{% endif %}</td>
      <td class="num"><a href="/switch?site={{ x.id }}&amp;back=/sources">{{ x.sources }}</a>{% if x.candidates %}<small>{{ _('{n} da valutare', n=x.candidates) }}</small>{% endif %}</td>
      <td class="num"><a href="/switch?site={{ x.id }}&amp;back=/trends">{{ x.news }}</a></td>
      <td class="num">{% if x.proposals %}<a class="chip amber" href="#h-decide">{{ x.proposals }}</a>{% else %}0{% endif %}</td>
      <td class="num"><a href="/switch?site={{ x.id }}&amp;back=/drafts">{{ x.drafts }}</a></td>
      {% if caller.operator %}<td class="num">{{ x.cost|num(2) }}<small>{{ _('1 chiamata') if x.calls == 1 else _('{n} chiamate', n=x.calls|tok) }}</small></td>{% endif %}
      <td>{% if x.next %}<strong style="font-weight: 500;">{{ x.next.title }}</strong>{% if x.next.busy %} <span class="chip teal">{{ _('In attesa') }}</span>{% else %} <span class="chip amber">{{ _('Tocca a te') }}</span>{% endif %}<small>{{ x.next.wait if x.next.busy else x.next.todo }}</small>{% else %}<span class="hint">{{ _('Tutto avviato') }}</span>{% endif %}</td>
      {% if caller.can('editor') %}
      <td><div class="row" style="gap: 6px; flex-wrap: nowrap;">
        {% if caller.can('owner') %}
        <form class="inline" method="post" action="/ui/sites/{{ x.id }}/review?back=/"><button class="btn sm" type="submit">{{ _('Analizza') }}</button></form>
        <form class="inline" method="post" action="/ui/sites/{{ x.id }}/discover?back=/"><button class="btn sm" type="submit">{{ _('Cerca fonti') }}</button></form>
        {% endif %}
        <form class="inline" method="post" action="/ui/proposals/now?back=/&amp;site={{ x.id }}"><button class="btn sm" type="submit">{{ _('Proponi') }}</button></form>
      </div></td>
      {% endif %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<div class="trio-cards">
  {% if not one and desk|length > 1 %}
  <section class="card" aria-labelledby="h-busy">
    <div class="card-head"><h2 id="h-busy">{{ _('Siti più attivi') }}</h2><span class="hint">{{ _('notizie 24 ore · proposte e bozze 7 giorni') }}</span></div>
    <div class="pad rank">
      {% set top = (busiest|map(attribute='news')|max) if busiest else 0 %}
      {% for x in busiest %}
      <div class="rank-row">
        <a href="/switch?site={{ x.id }}&amp;back=/trends">{{ x.domain }}</a>
        <div class="bar thin"><i style="width: {{ (100 * x.news / top)|round|int if top else 0 }}%"></i></div>
        <span class="num">{{ x.news }} · {{ x.proposals_week }} · {{ x.drafts_week }}</span>
      </div>
      {% else %}<p class="hint">{{ _('Ancora nessuna attività: lancia la raccolta.') }}</p>{% endfor %}
    </div>
  </section>
{% if caller.operator and desk|length > 1 %}
  <section class="card" aria-labelledby="h-cost">
    <div class="card-head"><h2 id="h-cost">{{ _('Siti più costosi') }}</h2><span class="hint">{{ _('30 giorni, ai prezzi di core.yaml') }}{% if caller.operator %} · <a href="/admin/usage">{{ _('Consumi') }}</a>{% endif %}</span></div>
    <div class="pad rank">
      {% set top = (costly|map(attribute='cost')|max) if costly else 0 %}
      {% for x in costly %}
      <div class="rank-row">
        <a href="/switch?site={{ x.id }}&amp;back=/site">{{ x.domain }}</a>
        <div class="bar thin"><i class="hype" style="width: {{ (100 * x.cost / top)|round|int if top else 0 }}%"></i></div>
        <span class="num" title="{{ _('{n} token', n=x.tokens|tok) }}">{{ x.cost|num(3) }} · {{ _('{n} chiamate', n=x.calls|tok) }}</span>
      </div>
      {% else %}<p class="hint">{{ _('Nessuna chiamata al modello negli ultimi 30 giorni.') }}</p>{% endfor %}
    </div>
  </section>
  {% endif %}
  {% endif %}
  <section class="card" aria-labelledby="h-latest">
    <div class="card-head"><h2 id="h-latest">{{ _('Ultime notizie') }}</h2><a class="hint" href="/trends">{{ _('Tutti i trend') }}</a></div>
    <div class="pad" style="gap: 8px;">
      {% for n in latest %}
      <div class="news-row"><a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a><small>{{ n.source }} · {{ when(n.published_at or n.fetched_at) }}</small></div>
      {% else %}<p class="hint">{{ _('Nessuna notizia ancora: lancia la raccolta.') }}</p>{% endfor %}
    </div>
  </section>
</div>
{% endif %}
{% endblock %}
