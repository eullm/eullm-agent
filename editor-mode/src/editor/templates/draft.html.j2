{% extends "base.html.j2" %}
{% block title %}{{ d.title }}{% endblock %}
{% block main %}
<header class="head">
  <div>
    <span class="kicker"><a href="/drafts">{{ _('Bozze') }}</a> · {% if d.translation_of and original %}{{ _('traduzione in {language} di', language=langs.get(d.language, d.language)) }} <a href="/drafts/{{ original.id }}">«{{ original.title|truncate(60) }}»</a>{% else %}{{ _('versione {n}', n=d.version) }}{% endif %} · {{ when(d.created_at) }}</span>
    <div class="row">
      {% set st = {'draft': ('blue', _('Pronta da leggere')), 'needs_review': ('amber', _('Da rivedere a mano')), 'approved': ('green', _('Approvata')), 'discarded': ('', _('Scartata dalla redazione automatica')), 'rejected': ('', _('Rifiutata'))}.get(draft_state(d.status, d.decided_by), ('', d.status)) %}
      <span class="chip {{ st[0] }}">{{ st[1] }}</span>
      {% if d.decided_by %}<span class="hint">{{ _('Approvata da {who} il {date}', who=d.decided_by, date=when(d.decided_at, 'day')) if d.status == 'approved' else _('Decisa da {who} il {date}', who=d.decided_by, date=when(d.decided_at, 'day')) }}</span>{% endif %}
    </div>
  </div>
  {% if caller.can('editor') and not editing %}
  <div class="row">
    <a class="btn" href="/drafts/{{ d.id }}?edit=1">{{ _('Modifica') }}</a>
    <form class="inline" method="post" action="/ui/drafts/{{ d.id }}/delete" onsubmit='return confirm({{ _('Eliminare questa bozza? La proposta torna accettata e potrai riscriverla. Gli articoli già inviati restano sul sito.')|string|tojson }})'><button class="btn danger" type="submit">{{ _('Elimina') }}</button></form>
  </div>
  {% endif %}
  {% if d.status in ('draft', 'needs_review') and caller.can('editor') and not editing %}
  <div class="row">
    <form class="inline" method="post" action="/ui/drafts/{{ d.id }}/decision"><input type="hidden" name="accept" value="0"><button class="btn" type="submit">{{ _('Rifiuta') }}</button></form>
    <form class="inline" method="post" action="/ui/drafts/{{ d.id }}/decision"><input type="hidden" name="accept" value="1"><button class="btn pri" type="submit">{{ _('Approva la bozza') }}</button></form>
  </div>
  {% endif %}
</header>

{% if auto_note and not editing %}
<section class="card pad why-auto">
  <h2>{{ _("Perché la redazione automatica l'ha scartata") if d.status == 'rejected' else _("Perché la redazione automatica l'ha fermata") }}</h2>
  <ul>{% for x in auto_note.split('; ') if x.strip() %}<li>{{ x }}</li>{% endfor %}</ul>
  <p class="hint">
    {% if newer %}{{ _('Al suo posto ha scritto la versione {n}:', n=newer.version) }} <a href="/drafts/{{ newer.id }}">{{ _('aprila') }}</a>. {% endif %}
    {% if caller.can('editor') %}{{ _("Se i motivi si possono correggere, premi «Modifica», sistema le frasi e approva la bozza: la pubblichi tu.") }}{% endif %}
  </p>
</section>
{% endif %}

{% if editing %}
<form method="post" action="/ui/drafts/{{ d.id }}/edit" class="card pad" style="display: flex; flex-direction: column; gap: 12px;" lang="{{ d.language or 'it' }}">
  <h2>{{ _('Modifica la bozza') }}</h2>
  <p class="hint">{{ _("Scrivi liberamente: un rigo per frase, «## » all'inizio del rigo per un sottotitolo, [1] [2] dopo una frase per le sue fonti (l'elenco è qui sotto). Puoi aggiungere, togliere e spostare frasi e sottotitoli. Una frase senza fonte è tua e va online così com'è; le frasi con le fonti vengono ricontrollate. Se la bozza era approvata, va riapprovata.") }}</p>
  <label class="field">{{ _('Titolo') }}<input name="title" value="{{ d.title }}" required minlength="5" maxlength="160"></label>
  <label class="field">{{ _('Sottotitolo') }}<input name="subtitle" value="{{ d.subtitle or '' }}" maxlength="300"></label>
  <label class="field">{{ _('Testo') }}<textarea name="body" rows="{{ [12, (body_text.count('\n') + 4)]|max }}" required style="font: 15px/1.6 var(--mono, monospace);">{{ body_text }}</textarea></label>
  {% if sources %}
  <div class="dashed">
    <strong>{{ _('Fonti da citare') }}</strong>
    {% for src in sources %}<span class="hint">[{{ src.n }}] {{ src.title }} · {{ src.source }}</span>{% endfor %}
  </div>
  {% endif %}
  <h3>{{ _('Google e risposte AI') }}</h3>
  <label class="field">{{ _('Frase chiave') }}<input name="seo_keyphrase" value="{{ sd.keyphrase or '' }}" maxlength="80"></label>
  <label class="field">{{ _('Titolo per Google') }}<input name="seo_title" value="{{ sd.title or '' }}" maxlength="70"></label>
  <label class="field">{{ _('Descrizione per Google') }}<input name="seo_description" value="{{ sd.description or '' }}" maxlength="170"></label>
  <label class="field">{{ _('Indirizzo') }}<input name="seo_slug" value="{{ sd.slug or '' }}" maxlength="80"></label>
  <div class="row"><a class="btn" href="/drafts/{{ d.id }}">{{ _('Annulla') }}</a><button class="btn pri" type="submit">{{ _('Salva le modifiche') }}</button></div>
</form>
{% else %}
<div class="cols">
  <article class="card article col-wide" lang="{{ d.language or 'it' }}">
    <h1>{{ d.title }}</h1>
    {% if d.subtitle %}<p class="sub">{{ d.subtitle }}</p>{% endif %}
    {% for sec in sections %}
      {% if sec.title %}<h2>{{ sec.title }}</h2>{% endif %}
      <p>{% for cl in sec.claims %}<span {% if cl.flagged %}class="flagged" title="{{ _('Da rivedere') }}"{% endif %}>{{ cl.text }}</span>{% for n in cl.refs %}<sup><a href="#src-{{ n }}" aria-label="{{ _('Fonte {n}', n=n) }}">{{ n }}</a></sup>{% endfor %}{{ ' ' if not loop.last }}{% endfor %}</p>
    {% else %}
      <p class="hint">{{ _('Questa bozza non ha frasi registrate.') }}</p>
    {% endfor %}
  </article>

  <div class="col-side">
    <section class="card pad" aria-labelledby="h-pub">
      <h2 id="h-pub">{{ _('Pubblicazione') }}</h2>
      {% for p in pubs %}
      <div class="list-row">
        <span>{{ p.name }} · {{ _('bozza') if p.mode == 'draft' else _('subito') }}</span>
        {% set ps = {'pending_approval': ('amber', _('In attesa del direttore')), 'approved': ('blue', _('In invio')), 'published': ('green', _('Pubblicata')), 'rejected': ('', _('Rifiutata')), 'failed': ('red', _('Non riuscita'))}.get(p.status, ('', p.status)) %}
        {% if p.withdrawn_at %}<span class="chip">{{ _('Ritirata il {d}', d=when(p.withdrawn_at)) }}</span>
        {% elif p.external_url %}<a class="chip {{ ps[0] }}" href="{{ p.external_url }}" rel="noopener noreferrer" target="_blank">{{ ps[1] }}{% if p.updated_at %} · {{ _('aggiornata il {d}', d=when(p.updated_at)) }}{% endif %}</a>{% else %}<span class="chip {{ ps[0] }}">{{ ps[1] }}</span>{% endif %}
      </div>
      {% if p.status == 'published' and p.mode == 'publish' and caller.can('owner') %}
        {% if p.id in changing %}
        <p class="hint"><span class="spin" aria-hidden="true"></span> {{ _('Modifica sul sito in corso: la segui nel riquadro Attività.') }}</p>
        {% else %}
        {% if p.id in stale_cover and d.status == 'approved' %}<p class="notice" style="margin: 6px 0;">{{ _('La copertina è cambiata dopo la pubblicazione: online c\'è ancora quella vecchia. Premi «Aggiorna sul sito» per sostituirla.') }}</p>{% endif %}
        <div class="row" style="flex-wrap: wrap; gap: 8px;">
          {% if d.status == 'approved' %}
          <form class="inline" method="post" action="/ui/publications/{{ p.id }}/update"><button class="btn sm" type="submit">{{ _('Rimetti online') if p.withdrawn_at else _('Aggiorna sul sito') }}</button></form>
          {% endif %}
          {% if not p.withdrawn_at %}
          <form class="inline row" method="post" action="/ui/publications/{{ p.id }}/withdraw" style="gap: 6px; align-items: center;">
            <label class="hint" style="display: flex; gap: 4px; align-items: center;"><input type="checkbox" name="confirm" value="1" required> {{ _('confermo') }}</label>
            <button class="btn sm" type="submit">{{ _('Ritira dal sito') }}</button>
          </form>
          {% endif %}
        </div>
        {% if p.error %}<p class="hint">{{ _("L'ultima modifica sul sito non è riuscita: {e}", e=p.error|truncate(160)) }}</p>{% endif %}
        {% endif %}
      {% endif %}
      {% endfor %}
      {% if pubs and d.status != 'approved' and pubs|selectattr('status', 'equalto', 'published')|list %}
      <p class="hint">{{ _('Hai modificato un articolo già pubblicato: approvalo di nuovo, poi «Aggiorna sul sito» lo sostituisce online allo stesso indirizzo.') }}</p>
      {% endif %}
      {% if replaces and online_old and caller.can('owner') %}
      <div class="dashed">
        <strong>{{ _('Questa è una nuova versione di un articolo già online') }}</strong>
        {% if d.status == 'approved' %}
          {% for o in online_old %}
          <form class="inline" method="post" action="/ui/publications/{{ o.id }}/update"><input type="hidden" name="draft_id" value="{{ d.id }}"><button class="btn sm pri" type="submit">{{ _('Pubblica al posto della versione online ({name})', name=o.name) }}</button></form>
          {% endfor %}
          <span class="hint">{{ _('Stesso indirizzo: chi aveva il link legge la nuova versione.') }}</span>
        {% else %}
          <span class="hint">{{ _('Rileggila e approvala: poi la metti online al posto della <a href="/drafts/{id}">versione pubblicata</a>.', id=replaces) }}</span>
        {% endif %}
      </div>
      {% endif %}
      {% if pubs|selectattr('status', 'equalto', 'published')|list and caller.can('editor') and not d.translation_of %}
      {% if redoing %}
      <p class="hint"><span class="spin" aria-hidden="true"></span> {{ _('Nuova versione in scrittura.') }}</p>
      {% else %}
      <details>
        <summary class="hint">{{ _("Rifai l'articolo") }}</summary>
        <form method="post" action="/ui/drafts/{{ d.id }}/redo" class="form-grid">
          <label class="field">{{ _('Cosa va cambiato') }}<textarea name="note" rows="3" required minlength="5" maxlength="1000" placeholder="{{ _('Es.: il titolo promette troppo; togli la parte sul mercato; usa il comunicato ufficiale per i numeri.') }}"></textarea></label>
          <div><button class="btn sm" type="submit">{{ _('Scrivi una nuova versione') }}</button></div>
        </form>
        <p class="hint">{{ _("La nuova versione non va online da sola: la rileggi, la approvi e la pubblichi al posto di questa.") }}</p>
      </details>
      {% endif %}
      {% endif %}
      {% if d.status == 'approved' and caller.can('editor') %}
        {% if targets %}
        <form method="post" action="/ui/drafts/{{ d.id }}/publish" class="form-grid">
          <label class="field">{{ _('Destinazione') }}<select name="target_id">{% for t in targets %}<option value="{{ t.id }}">{{ t.name }} · {{ _(kinds.get(t.kind, t.kind)) }}</option>{% endfor %}</select></label>
          {% if site_sections and not d.translation_of %}<label class="field">{{ _('Rubrica') }}<select name="section">{% if not sd.section %}<option value="">{{ _('Nessuna') }}</option>{% elif sd.section not in site_sections %}<option value="" selected>{{ sd.section }}</option>{% endif %}{% for x in site_sections %}<option value="{{ x }}" {% if sd.section == x %}selected{% endif %}>{{ x }}</option>{% endfor %}</select></label>{% endif %}
          <label class="field">{{ _('Modo') }}<select name="mode"><option value="draft">{{ _('Come bozza nel CMS') }}</option><option value="publish">{{ _('Pubblica subito') }}</option></select></label>
          <div><button class="btn pri" type="submit">{{ _('Chiedi la pubblicazione') }}</button></div>
        </form>
        <p class="hint">{{ _('Parte solo dopo il sì di un direttore.') }}</p>
        {% else %}
        <p class="hint">{{ _('Nessuna destinazione per questo sito: aggiungila da <a href="/publications">Pubblicazioni</a>.') }}</p>
        {% endif %}
      {% elif not pubs %}
      <p class="hint">{{ _('Si può pubblicare dopo aver approvato la bozza.') }}</p>
      {% endif %}
    </section>

    <section class="card pad" aria-labelledby="h-checks">
      <h2 id="h-checks">{{ _('Controlli automatici') }}</h2>
      <ul class="checks">
        {% for ch in checks %}
        <li><span class="{{ 'up' if ch.ok else 'down' }}" aria-hidden="true">{{ '✓' if ch.ok else '✕' }}</span><span>{{ _(ch.label) }}{% if not ch.ok %} <span class="sr">{{ _('non superato') }}</span>{% endif %}</span></li>
        {% endfor %}
      </ul>
      {% if flags %}
      <div class="dashed">
        <strong>{{ _('Frasi da rivedere') }}</strong>
        {% for f in flags[:8] %}<span class="hint">«{{ f.text|truncate(90) }}»: {{ f.problems|map('flag')|join('; ') }}</span>{% endfor %}
      </div>
      {% endif %}
    </section>

    {% if sd %}
    <section class="card pad" aria-labelledby="h-seo">
      <h2 id="h-seo">{{ _('Google e risposte AI') }} · {{ seo_checks|selectattr('ok')|list|length }}/{{ seo_checks|length }}</h2>
      <dl class="kv" style="margin: 0; display: grid; gap: 6px;">
        <div><dt class="hint">{{ _('Frase chiave') }}</dt><dd>{{ sd.keyphrase or '–' }}</dd></div>
        <div><dt class="hint">{{ _('Titolo per Google') }} ({{ (sd.title or '')|length }})</dt><dd>{{ sd.title or '–' }}</dd></div>
        <div><dt class="hint">{{ _('Descrizione per Google') }} ({{ (sd.description or '')|length }})</dt><dd>{{ sd.description or '–' }}</dd></div>
        <div><dt class="hint">{{ _('Indirizzo') }}</dt><dd><code>/{{ sd.slug }}</code></dd></div>
        {% if sd.links %}<div><dt class="hint">{{ _('Link ad altri articoli del sito') }}</dt><dd>{% for x in sd.links %}<a href="{{ x.url }}" rel="noopener noreferrer" target="_blank">{{ x.title }}</a>{{ '; ' if not loop.last }}{% endfor %}</dd></div>{% endif %}
      </dl>
      <ul class="checks">
        {% for ch in seo_checks %}
        <li><span class="{{ 'up' if ch.ok else 'down' }}" aria-hidden="true">{{ '✓' if ch.ok else '✕' }}</span><span>{{ ch.label }}{% if not ch.ok %} <span class="sr">{{ _('non superato') }}</span>{% endif %}</span></li>
        {% endfor %}
      </ul>
      {% if seo_checks|rejectattr('ok')|list %}<p class="hint">{{ _('Le voci con la croce non fermano la pubblicazione: aiutano Google e le risposte AI a trovare l\'articolo. Titolo, descrizione e frase chiave si correggono da Modifica.') }}</p>{% endif %}
      <p class="hint">{{ _("Alla pubblicazione titolo, descrizione, indirizzo e dati strutturati (articolo, fonti, domande frequenti) vanno al sito insieme al testo.") }}</p>
    </section>
    {% endif %}

    <section class="card pad" aria-labelledby="h-src">
      <h2 id="h-src">{{ _('Fonti') }} · {{ sources|length }}</h2>
      <p class="hint">{{ _('Clicca un numero nel testo per vedere da dove viene la frase.') }}</p>
      <ol class="srclist">
        {% for x in sources %}
        <li id="src-{{ x.n }}"><span class="n">{{ x.n }}</span><div><a href="{{ x.url }}" rel="noopener noreferrer" target="_blank">{{ x.title }}</a><small class="hint">{{ x.source }}{% if x.published_at %} · {{ when(x.published_at, 'day') }}{% endif %}</small></div></li>
        {% endfor %}
      </ol>
    </section>

    {% if image or images_on %}
    <section class="card pad" aria-labelledby="h-image">
      <h2 id="h-image">{{ _('Immagine di copertina') }}</h2>
      {% if image %}
      <img src="/media/{{ image.token }}" alt="{{ image.alt }}" width="{{ image.width or 1344 }}" height="{{ image.height or 768 }}" style="width: 100%; height: auto; border-radius: 8px;">
      <p class="hint">{{ _('Testo alternativo: {alt}', alt=image.alt) }}</p>
      {% endif %}
      {% if img_busy %}<span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('Immagine in preparazione') }}</span>
      {% elif caller.can('editor') %}
      <div class="row">
        {% if images_on %}<form class="inline" method="post" action="/ui/drafts/{{ d.id }}/image"><button class="btn sm" type="submit">{{ _('Rifai l\'immagine') if image else _('Crea l\'immagine') }}</button></form>{% endif %}
        {% if image %}<form class="inline" method="post" action="/ui/drafts/{{ d.id }}/image/delete"><button class="btn sm" type="submit">{{ _('Togli') }}</button></form>{% endif %}
      </div>
      {% endif %}
      {% if images_on and cover and cover.credits.enabled and not img_busy %}
      <p class="hint">{% if cover.cost %}{{ _('Le copertine gratuite di questo articolo sono finite: una nuova costa {n} crediti (te ne restano {left}).', n=cover.cost, left=cover.credits.left) }}{% elif image %}{{ _('Ancora {n} nuove copertine gratuite per questo articolo, poi si pagano in crediti.', n=cover.free) }}{% endif %}</p>
      {% endif %}
      <p class="hint">{{ _("Disegnata per l'articolo, mai presa dalle notizie di origine (hanno i diritti dei loro editori). Alla pubblicazione va al sito come immagine in evidenza.") }}</p>
    </section>
    {% endif %}

    <section class="card pad" aria-labelledby="h-langs">
      <h2 id="h-langs">{{ _('Lingue') }}</h2>
      {% if original %}
      <div class="list-row">
        <span>{{ langs.get(original.language, original.language or '–') }} · {{ _('originale') }}</span>
        {% if original.id == d.id %}<span class="hint">{{ _('questa') }}</span>{% else %}<a href="/drafts/{{ original.id }}">{{ _('Apri') }}</a>{% endif %}
      </div>
      {% endif %}
      {% for x in translations %}
      <div class="list-row">
        <span>{{ langs.get(x.language, x.language) }}</span>
        {% set ts = {'draft': ('blue', _('Pronta')), 'needs_review': ('amber', _('Da rivedere')), 'approved': ('green', _('Approvata')), 'discarded': ('', _('Scartata')), 'rejected': ('', _('Rifiutata'))}.get(draft_state(x.status, x.decided_by), ('', x.status)) %}
        {% if x.id == d.id %}<span class="chip {{ ts[0] }}">{{ ts[1] }}</span>{% else %}<a class="chip {{ ts[0] }}" href="/drafts/{{ x.id }}">{{ ts[1] }}</a>{% endif %}
      </div>
      {% endfor %}
      {% for code in wanted %}
      <div class="list-row">
        <span>{{ langs.get(code, code) }}</span>
        {% if code in translating %}<span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('In traduzione') }}</span>
        {% elif caller.can('editor') and can_translate %}<form class="inline" method="post" action="/ui/drafts/{{ d.id }}/translate"><input type="hidden" name="language" value="{{ code }}"><button class="btn sm" type="submit">{{ _('Traduci') }}</button></form>
        {% else %}<span class="hint">{{ _('da tradurre') }}</span>{% endif %}
      </div>
      {% endfor %}
      <p class="hint">{% if translations or wanted %}{{ _("Quando approvi l'originale, l'agente lo traduce da solo nelle altre lingue del sito. Ogni traduzione ha le stesse fonti e gli stessi controlli, si approva a parte e conta come un articolo del piano.") }}{% else %}{{ _('Il sito pubblica in una sola lingua. Le lingue in cui tradurre gli articoli approvati si scelgono in <a href="/site#h-languages">Sito e profilo</a>.') }}{% endif %}</p>
    </section>

    <section class="card pad" aria-labelledby="h-delivery">
      <h2 id="h-delivery">{{ _('Consegna') }}</h2>
      <div class="row" style="flex-wrap: wrap;">
        <a class="btn sm" href="/drafts/{{ d.id }}/package.zip" download>{{ _('Scarica il pacchetto') }}</a>
        <button class="btn sm" type="button" data-copy="body-html">{{ _('Copia HTML') }}</button>
        <button class="btn sm" type="button" data-copy="body-md">{{ _('Copia Markdown') }}</button>
      </div>
      <textarea id="body-html" hidden readonly>{{ body_html }}</textarea>
      <textarea id="body-md" hidden readonly>{{ d.body_md }}</textarea>
      <p class="hint">{{ _("Il pacchetto ZIP contiene la pagina pronta (article.html), il testo da incollare nel CMS (body.html), il Markdown per i siti statici, l'immagine e i campi per Google (meta.json). «Copia HTML» copia il testo senza titolo, da incollare nell'editor del CMS in modalità codice.") }}{% if d.status != 'approved' %} {{ _('Prima di pubblicarla, approva la bozza.') }}{% endif %}</p>
    </section>

  </div>
</div>
{% endif %}
<script>
document.querySelectorAll('[data-copy]').forEach(function (b) {
  b.addEventListener('click', function () {
    var label = b.textContent;
    navigator.clipboard.writeText(document.getElementById(b.dataset.copy).value).then(function () {
      b.textContent = {{ _('Copiato')|string|tojson }};
      setTimeout(function () { b.textContent = label; }, 1500);
    });
  });
});
</script>
{% endblock %}
