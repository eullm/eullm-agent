{# Console › Piani e crediti: the plans side by side (a column opens its
   window), then the price list of credits and the packs. #}
{% from "_admin_macros.html.j2" import dlg_head, dlg_foot with context %}
<header class="page-head">
  <div class="ph-text">
    <h1>{{ _('Piani e crediti') }}</h1>
    <p class="ph-sub row"><span>{{ _('prezzi IVA esclusa') }}</span><span class="chip {{ 'green' if online else '' }}" id="pagamenti" title="{{ _('Pagamenti online attivi (Mollie): il cliente sceglie il piano e paga dalla pagina Abbonamento; i rinnovi sono automatici.') if online else _('Registra i bonifici da Abbonamento di ogni redazione. Per i pagamenti online serve la chiave di Mollie (EDITOR_MOLLIE_API_KEY) nel file .env del server.') }}">{{ _('Pagamenti online: Mollie attivo') if online else _('Pagamenti online spenti: solo bonifici') }}</span></p>
  </div>
  <div class="ph-actions">
    <button class="btn" type="button" command="show-modal" commandfor="nuovo-pacchetto">+ {{ _('Nuovo pacchetto') }}</button>
    <button class="btn pri" type="button" command="show-modal" commandfor="nuovo-piano">+ {{ _('Nuovo piano') }}</button>
  </div>
</header>

<section class="card" id="piani" aria-labelledby="h-plans">
  <div class="card-head"><h2 id="h-plans">{{ _('Piani') }}</h2><span class="hint">{{ _('In verde quelli che il sito di vendita mostra.') }}</span></div>
  <div class="scroll">
  <table class="tbl plans-grid">
    <thead><tr><th></th>{% for p in plans %}<th class="num"><span class="plan-col">{{ p.name }}{% if p.public %} <span class="chip green">{{ _('sul sito') }}</span>{% endif %}</span></th>{% endfor %}</tr></thead>
    <tbody>
    {% set unlimited = _('senza limite') %}
    {% for label, key in [(_('Al mese'), 'price_month_cents'), (_("All'anno"), 'price_year_cents')] %}
    <tr><td>{{ label }}</td>{% for p in plans %}<td class="num">{{ money(p[key], p.currency) if p[key] is not none else '–' }}</td>{% endfor %}</tr>
    {% endfor %}
    <tr><td>{{ _('Giorni di prova') }}</td>{% for p in plans %}<td class="num">{{ p.trial_days or '–' }}</td>{% endfor %}</tr>
    {% for label, key in [(_('Siti'), 'max_sites'), (_('Lingue per sito'), 'max_languages'), (_('Fonti attive'), 'max_active_sources'), (_('Articoli al mese'), 'max_drafts_month'), (_('Crediti al mese'), 'credits_month'), (_('Accessi compresi'), 'max_users')] %}
    <tr><td>{{ label }}</td>{% for p in plans %}<td class="num">{{ p[key] if p[key] is not none else unlimited }}</td>{% endfor %}</tr>
    {% endfor %}
    <tr><td>{{ _('Redazione automatica') }}</td>{% for p in plans %}<td class="num">{{ _('Sì') if p.autopilot is not false else _('No') }}</td>{% endfor %}</tr>
    <tr><td>{{ _('Punto della Sera') }}</td>{% for p in plans %}<td class="num">{{ _('Sì') if p.evening else _('No') }}</td>{% endfor %}</tr>
    <tr><td>{{ _('Redazioni con questo piano') }}</td>{% for p in plans %}<td class="num">{{ subs.values()|selectattr('plan_code', 'equalto', p.code)|list|length }}</td>{% endfor %}</tr>
    <tr><td></td>{% for p in plans %}<td class="num"><button class="btn sm" type="button" command="show-modal" commandfor="p-{{ p.code }}">{{ _('Modifica') }}</button></td>{% endfor %}</tr>
    </tbody>
  </table>
  </div>
  <p class="hint foot-note">{{ _('Il sito pubblico legge i piani da <code>/api/public/plans</code>. Il piano "Prova" è quello di chi si iscrive.') }}</p>
</section>

<section class="card" id="crediti" aria-labelledby="h-credits">
  <div class="card-head"><h2 id="h-credits">{{ _('Crediti') }}</h2><span class="hint">{{ _('quello che va oltre il piano') }}</span></div>
  <div class="pad">
    <p class="lead">{{ _('Ogni piano dà crediti ogni mese. Si spendono per gli articoli e le traduzioni oltre quelli del piano e per le copertine rifatte dopo le {n} gratuite di ogni articolo. Finiti quelli del mese si usano i crediti extra dei pacchetti, che non scadono.', n=2) }}</p>
    <h3>{{ _('Listino') }}</h3>
    <form method="post" action="/admin/credits/prices" class="form-grid">
      <label class="field">{{ _('Articolo oltre il piano') }}<input name="article" inputmode="numeric" value="{{ credit_prices.article }}"></label>
      <label class="field">{{ _('Traduzione oltre il piano') }}<input name="translation" inputmode="numeric" value="{{ credit_prices.translation }}"></label>
      <label class="field">{{ _('Copertina rifatta') }}<input name="image" inputmode="numeric" value="{{ credit_prices.image }}"></label>
      <div><button class="btn" type="submit">{{ _('Salva il listino') }}</button></div>
    </form>
  </div>
  <div class="card-head sub-head"><h3>{{ _('Pacchetti') }}</h3><button class="btn sm" type="button" command="show-modal" commandfor="nuovo-pacchetto">+ {{ _('Nuovo pacchetto') }}</button></div>
  {% if packs %}
  <div class="scroll">
  <table class="tbl cards">
    <thead><tr><th>{{ _('Pacchetto') }}</th><th class="num">{{ _('Crediti') }}</th><th class="num">{{ _('Prezzo') }}</th><th>{{ _('In vendita') }}</th><th><span class="sr">{{ _('Azioni') }}</span></th></tr></thead>
    <tbody>
    {% for k in packs %}
    <tr {% if not k.active %}class="faded"{% endif %}>
      <td data-label="{{ _('Pacchetto') }}"><strong>{{ k.name }}</strong><small class="num">{{ k.code }}</small></td>
      <td class="num" data-label="{{ _('Crediti') }}">{{ k.credits }}</td>
      <td class="num" data-label="{{ _('Prezzo') }}">{{ money(k.price_cents, k.currency) }}</td>
      <td data-label="{{ _('In vendita') }}">{% if k.active %}<span class="chip green">{{ _('Sì') }}</span>{% else %}<span class="chip">{{ _('No') }}</span>{% endif %}</td>
      <td class="end"><button class="btn sm" type="button" command="show-modal" commandfor="k-{{ k.code }}">{{ _('Modifica') }}</button></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">{{ _('Nessun pacchetto: i clienti non possono comprare crediti extra.') }}</p>
  {% endif %}
  <p class="hint foot-note">{{ _("I clienti comprano i pacchetti in Il mio piano con Mollie; un bonifico lo registri nella scheda della redazione, in Crediti. Avvisiamo il direttore per email all'80% e al 100% dei crediti del mese.") }}</p>
</section>

{% for p in plans %}
<dialog id="p-{{ p.code }}" class="modal wide" aria-labelledby="p-{{ p.code }}-title">
  <form method="post" action="/admin/plans/{{ p.code }}">
    {{ dlg_head('p-' ~ p.code, p.name, _('codice {code}', code=p.code)) }}
    <div class="dlg-body">
      <div class="form-grid">
        <label class="field span-2">{{ _('Nome') }}<input name="name" value="{{ p.name }}" required autofocus></label>
        <label class="field">{{ _('Al mese (€)') }}<input name="price_month" inputmode="decimal" value="{{ '%.2f'|format(p.price_month_cents / 100) if p.price_month_cents is not none else '' }}"></label>
        <label class="field">{{ _("All'anno (€)") }}<input name="price_year" inputmode="decimal" value="{{ '%.2f'|format(p.price_year_cents / 100) if p.price_year_cents is not none else '' }}"></label>
        <label class="field">{{ _('Giorni di prova') }}<input name="trial_days" inputmode="numeric" value="{{ p.trial_days }}"></label>
        <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" value="{{ p.max_sites if p.max_sites is not none else '' }}"></label>
        <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" value="{{ p.max_languages if p.max_languages is not none else '' }}"></label>
        <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" value="{{ p.max_active_sources if p.max_active_sources is not none else '' }}"></label>
        <label class="field">{{ _('Articoli al mese') }}<input name="max_drafts_month" inputmode="numeric" value="{{ p.max_drafts_month if p.max_drafts_month is not none else '' }}"></label>
        <label class="field">{{ _('Crediti al mese') }}<input name="credits_month" inputmode="numeric" value="{{ p.credits_month if p.credits_month is not none else '' }}"></label>
        <label class="field">{{ _('Accessi compresi') }}<input name="max_users" inputmode="numeric" value="{{ p.max_users if p.max_users is not none else '' }}"></label>
        <label class="field">{{ _('Redazione automatica') }}<select name="autopilot"><option value="1" {% if p.autopilot is not false %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if p.autopilot is false %}selected{% endif %}>{{ _('No') }}</option></select></label>
        <label class="field">{{ _('Punto della Sera') }}<select name="evening"><option value="1" {% if p.evening %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not p.evening %}selected{% endif %}>{{ _('No') }}</option></select></label>
        <label class="field">{{ _('Sul sito') }}<select name="public"><option value="1" {% if p.public %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not p.public %}selected{% endif %}>{{ _('No') }}</option></select></label>
        <label class="field full">{{ _('Descrizione') }}<input name="description" value="{{ p.description }}"></label>
      </div>
      <p class="hint">{{ _('Vuoto vuol dire senza limite. Le redazioni già su questo piano prendono i nuovi limiti al prossimo pagamento.') }}</p>
    </div>
    <footer class="dlg-foot">
      {% if p.code != 'trial' %}<button class="btn danger left" type="button" command="show-modal" commandfor="p-{{ p.code }}--delete">{{ _('Elimina il piano {name}', name=p.name) }}</button>{% endif %}
      <button class="btn" type="button" command="close" commandfor="p-{{ p.code }}">{{ _('Annulla') }}</button>
      <button class="btn pri" type="submit">{{ _('Salva') }}</button>
    </footer>
  </form>
</dialog>
{% if p.code != 'trial' %}
<dialog id="p-{{ p.code }}--delete" class="modal" aria-labelledby="p-{{ p.code }}--delete-title" closedby="any">
  <form method="post" action="/admin/plans/{{ p.code }}/delete">
    {{ dlg_head('p-' ~ p.code ~ '--delete', _('Eliminare il piano {name}?', name=p.name)) }}
    <div class="dlg-body"><p>{{ _('Si può eliminare solo se nessuna redazione lo usa; il sito di vendita smette di mostrarlo.') }}</p></div>
    {{ dlg_foot('p-' ~ p.code ~ '--delete', _('Elimina il piano {name}', name=p.name), 'danger', safe=True) }}
  </form>
</dialog>
{% endif %}
{% endfor %}

<dialog id="nuovo-piano" class="modal" aria-labelledby="nuovo-piano-title">
  <form method="post" action="/admin/plans">
    {{ dlg_head('nuovo-piano', _('Nuovo piano'), _('Prezzi e limiti li scrivi subito dopo, nella sua finestra.')) }}
    <div class="dlg-body">
      <div class="form-grid">
        <label class="field span-2">{{ _('Nome del nuovo piano') }}<input name="name" required maxlength="100" placeholder="Pro Plus" autofocus></label>
        <label class="field">{{ _('Codice (facoltativo)') }}<input name="code" maxlength="40" pattern="[a-z0-9-]{1,40}" placeholder="{{ _('dal nome: pro-plus') }}"></label>
      </div>
    </div>
    {{ dlg_foot('nuovo-piano', _('Aggiungi un piano')) }}
  </form>
</dialog>

{% for k in packs %}
<dialog id="k-{{ k.code }}" class="modal" aria-labelledby="k-{{ k.code }}-title">
  <form method="post" action="/admin/credits/packs/{{ k.code }}">
    {{ dlg_head('k-' ~ k.code, k.name, _('codice {code}', code=k.code)) }}
    <div class="dlg-body">
      <div class="form-grid">
        <label class="field span-2">{{ _('Nome') }}<input name="name" value="{{ k.name }}" required autofocus></label>
        <label class="field">{{ _('Crediti') }}<input name="credits" inputmode="numeric" value="{{ k.credits }}" required></label>
        <label class="field">{{ _('Prezzo (€)') }}<input name="price" inputmode="decimal" value="{{ '%.2f'|format(k.price_cents / 100) }}" required></label>
        <label class="field">{{ _('Ordine') }}<input name="sort" inputmode="numeric" value="{{ k.sort }}"></label>
        <label class="field">{{ _('In vendita') }}<select name="active"><option value="1" {% if k.active %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not k.active %}selected{% endif %}>{{ _('No') }}</option></select></label>
      </div>
    </div>
    <footer class="dlg-foot">
      <button class="btn danger left" type="button" command="show-modal" commandfor="k-{{ k.code }}--delete">{{ _('Elimina il pacchetto {name}', name=k.name) }}</button>
      <button class="btn" type="button" command="close" commandfor="k-{{ k.code }}">{{ _('Annulla') }}</button>
      <button class="btn pri" type="submit">{{ _('Salva') }}</button>
    </footer>
  </form>
</dialog>
<dialog id="k-{{ k.code }}--delete" class="modal" aria-labelledby="k-{{ k.code }}--delete-title" closedby="any">
  <form method="post" action="/admin/credits/packs/{{ k.code }}/delete">
    {{ dlg_head('k-' ~ k.code ~ '--delete', _('Eliminare il pacchetto {name}?', name=k.name)) }}
    <div class="dlg-body"><p>{{ _('I crediti già comprati restano a chi li ha.') }}</p></div>
    {{ dlg_foot('k-' ~ k.code ~ '--delete', _('Elimina il pacchetto {name}', name=k.name), 'danger', safe=True) }}
  </form>
</dialog>
{% endfor %}

<dialog id="nuovo-pacchetto" class="modal" aria-labelledby="nuovo-pacchetto-title">
  <form method="post" action="/admin/credits/packs">
    {{ dlg_head('nuovo-pacchetto', _('Nuovo pacchetto di crediti')) }}
    <div class="dlg-body">
      <div class="form-grid">
        <label class="field">{{ _('Codice del nuovo pacchetto') }}<input name="code" required maxlength="40" pattern="[a-z0-9-]{1,40}" placeholder="xl" autofocus></label>
        <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100" placeholder="{{ _('10.000 crediti') }}"></label>
        <label class="field">{{ _('Crediti') }}<input name="credits" inputmode="numeric" required></label>
        <label class="field">{{ _('Prezzo (€)') }}<input name="price" inputmode="decimal" required></label>
      </div>
    </div>
    {{ dlg_foot('nuovo-pacchetto', _('Aggiungi un pacchetto')) }}
  </form>
</dialog>
