<!doctype html>
{# The console of whoever runs the service. This file is the frame (menu,
   search, notices); each section of the menu is its own file. #}
{% set titles = {'redazioni': _('Redazioni'), 'redazione': rooms[0].name if rooms else _('Redazioni'), 'nuova': _('Nuova redazione'),
                 'clienti': _('Clienti'), 'cliente': the_customer.name if the_customer else _('Clienti'), 'nuovo-cliente': _('Nuovo cliente'),
                 'pagamenti': _('Pagamenti'), 'cerca': _('Cerca'), 'rivenditori': _('Rivenditori'), 'piani': _('Piani e crediti'),
                 'operatori': _('Amministratori'), 'api': _('Chiavi API'), 'aggiornamenti': _('Aggiornamenti'), 'backup': _('Backup')} %}
{% set parts = {'redazioni': '_admin_rooms.html.j2', 'redazione': '_admin_room.html.j2', 'nuova': '_admin_new_room.html.j2',
                'clienti': '_admin_customers.html.j2', 'cliente': '_admin_customer.html.j2', 'nuovo-cliente': '_admin_new_customer.html.j2',
                'pagamenti': '_admin_payments.html.j2', 'cerca': '_admin_search.html.j2', 'rivenditori': '_admin_resellers.html.j2',
                'piani': '_admin_plans.html.j2', 'operatori': '_admin_operators.html.j2', 'api': '_admin_keys.html.j2',
                'aggiornamenti': '_admin_updates.html.j2', 'backup': '_admin_backup.html.j2'} %}
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titles.get(view) or _('Amministrazione') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
<div class="shell">
{% include "_admin_nav.html.j2" %}
<main class="main">
  {% include "_admin_top.html.j2" %}
  {% if notice %}<p class="{{ 'error' if notice_error else 'notice' }}" role="{{ 'alert' if notice_error else 'status' }}" id="top-notice">{{ notice }}</p>{% endif %}
  {% if error %}<p class="error" role="alert" id="top-error">{{ error }}{% if twin %} <a href="/admin/customers/{{ twin }}">{{ _('Apri il cliente') }}</a>{% endif %}</p>{% endif %}
  {% if updates.busy %}<p class="notice" role="status"><span>{{ _('Aggiornamento alla {version} in corso: non serve rilanciarlo.', version=(updates.pending or {}).version or (updates.status or {}).version) }}</span> <a href="/admin/updates">{{ _('Segui') }}</a></p>
  {% elif updates.newer and view != 'aggiornamenti' %}<p class="notice row" role="status" style="justify-content: space-between;"><span>{{ _('È disponibile la versione {version} (installata: {installed}).', version=updates.available.version, installed=updates.installed) }}</span><a href="/admin/updates">{{ _('Aggiorna') }}</a></p>{% endif %}
  {% if new %}
  <section class="card pad created" aria-labelledby="h-new">
    <h2 id="h-new">{{ new.what }}</h2>
    {% if new.link %}
      {% if new.link.sent %}<p class="lead">{{ _('Il link è partito per email a {email}.', email=new.link.email) }}</p>
      {% else %}<p class="lead">{{ _('Questo server non manda email: manda tu questo link a {email}. Si usa una volta.', email=new.link.email) }}</p>
      <div class="token">{{ new.link.url }}</div>{% endif %}
    {% endif %}
    {% if new.key %}<p class="lead">{{ _("Copiala adesso: non verrà più mostrata. Va nell'intestazione <code>Authorization: Bearer …</code> delle chiamate a <code>/api/operator/</code>.") }}</p><div class="token">{{ new.key }}</div>{% endif %}
    {% if new.note %}<p class="lead">{{ new.note }}</p>{% endif %}
    {% if new.warning %}<p class="error">{{ new.warning }}</p>{% endif %}
  </section>
  {% endif %}
  {% include parts.get(view, '_admin_rooms.html.j2') %}
</main>
</div>
{% include "_dialogs.html.j2" %}
{% include "_once.html.j2" %}
</body>
</html>
