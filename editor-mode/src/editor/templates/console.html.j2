    {% if notice and notice_at == 'clienti' %}<p class="notice" role="status" style="margin: 12px 16px 0;">{{ notice }}</p>{% endif %}
    {% if customers %}
    <div class="pad" style="overflow-x: auto;">
    <table class="tbl">
      <thead><tr><th>{{ _('Cliente') }}</th><th>{{ _('Fiscale') }}</th><th>{{ _('Indirizzo') }}</th><th>{{ _('Redazioni') }}</th><th>{{ _('Rivenditore') }}</th></tr></thead>
      <tbody>
      {% for c in customers %}
      <tr>
        <td><strong>{{ c.name }}</strong><br><span class="hint">{{ c.email }}{% if c.phone %} · {{ c.phone }}{% endif %}</span>{% if c.external_ref %}<br><span class="hint">{{ _('rif.') }} <span class="num">{{ c.external_ref }}</span></span>{% endif %}</td>
        <td class="hint">{% if c.vat_number %}{{ _('P.IVA') }} {{ c.vat_number }}<br>{% endif %}{% if c.tax_code %}{{ _('CF') }} {{ c.tax_code }}<br>{% endif %}{% if c.sdi_code %}SDI {{ c.sdi_code }}<br>{% endif %}{% if c.pec %}PEC {{ c.pec }}{% endif %}</td>
        <td class="hint">{{ c.address }}{% if c.city %}<br>{{ c.postal_code }} {{ c.city }}{% if c.province %} ({{ c.province }}){% endif %}{% endif %}<br>{{ c.country }}</td>
