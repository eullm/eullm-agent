<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Amministrazione') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
{% set labels = {'sites': _('Siti'), 'sources': _('Fonti attive'), 'items': _('Notizie oggi'), 'drafts': _('Bozze nel mese'), 'llm_cost': _('Costo modello nel mese')} %}
<div class="shell">
{% include "_admin_nav.html.j2" %}
<main class="main">
  <div class="topbar">{% include "_lang.html.j2" %}</div>
  {% if notice and (not notice_at or notice_at in ('operatori', 'api', 'nuova')) %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  {% if updates.newer and not updates.pending %}<p class="notice" role="status" style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;"><span>{{ _('È disponibile la versione {version} (installata: {installed}).', version=updates.available.version, installed=updates.installed) }}</span><a href="/admin/updates">{{ _('Aggiorna') }}</a></p>{% endif %}
  {% if new %}
  <section class="card pad" style="border-color: var(--accent);" aria-labelledby="h-new">
    <h2 id="h-new">{{ new.what }}</h2>
    {% if new.link %}
      {% if new.link.sent %}<p class="lead">{{ _('Il link è partito per email a {email}.', email=new.link.email) }}</p>
      {% else %}<p class="lead">{{ _('Questo server non manda email: manda tu questo link a {email}. Si usa una volta.', email=new.link.email) }}</p>
      <div class="token">{{ new.link.url }}</div>{% endif %}
    {% endif %}
    {% if new.key %}<p class="lead">{{ _("Copiala adesso: non verrà più mostrata. Va nell'intestazione <code>Authorization: Bearer …</code> delle chiamate a <code>/api/operator/</code>.") }}</p><div class="token">{{ new.key }}</div>{% endif %}
    {% if new.note %}<p class="lead">{{ new.note }}</p>{% endif %}
    {% if new.warning %}<p class="error">{{ new.warning }}</p>{% endif %}
  </section>
  {% endif %}

  {% set titles = {'redazioni': _('Redazioni'), 'nuova': _('Nuova redazione'), 'clienti': _('Clienti'), 'rivenditori': _('Rivenditori'), 'piani': _('Piani'), 'operatori': _('Amministratori'), 'api': _('Chiavi API'), 'aggiornamenti': _('Aggiornamenti')} %}
  {% if view == 'redazione' %}
  <header class="head">
    <div><a class="kicker" href="/admin">← {{ _('Redazioni') }}</a><h1>{{ rooms[0].name if rooms else '' }}</h1></div>
  </header>
  {% else %}
  <header class="head" id="{{ view }}">
    <div><span class="kicker">{{ _('Amministrazione') }}</span><h1>{{ titles[view] }}</h1></div>
    {% if view == 'redazioni' %}<span class="row"><span class="chip dark">{{ rooms|length }} {{ _('redazione') if rooms|length == 1 else _('redazioni') }}</span><a class="btn sm pri" href="/admin/new">+ {{ _('Nuova redazione') }}</a></span>{% endif %}
  </header>
  {% endif %}

  {% if view == 'redazioni' %}
{% with page="console" %}{% include "_help.html.j2" %}{% endwith %}
  {% if rooms %}
  <section class="card" aria-label="{{ _('Redazioni') }}">
    <div class="pad" style="padding-bottom: 0;">
      <input type="search" id="room-filter" class="search" placeholder="{{ _('Cerca per nome, id, piano o stato') }}" aria-label="{{ _('Cerca per nome, id, piano o stato') }}" autocomplete="off">
    </div>
    <div class="pad" style="overflow-x: auto;">
    <table class="tbl rooms">
      <thead><tr><th>{{ _('Redazione') }}</th><th>{{ _('Abbonamento') }}</th><th class="num">{{ _('Siti') }}</th><th class="num">{{ _('Bozze nel mese') }}</th><th class="num">{{ _('Costo modello nel mese') }}</th><th>{{ _('Dal') }}</th><th></th></tr></thead>
      <tbody>
      {% for r in rooms %}
      {% set sub = subs.get(r.tenant_id) %}
      <tr data-find="{{ (r.name ~ ' ' ~ r.tenant_id ~ ' ' ~ (sub.plan_name if sub else r.plan or '') ~ ' ' ~ (sub.label if sub else ''))|lower }}">
        <td><a class="room-name" href="/admin/newsrooms/{{ r.tenant_id }}">{{ r.name }}</a><br><span class="hint num">{{ r.tenant_id }}</span></td>
        <td>
          {% if sub %}<span class="chip {{ 'teal' if sub.status == 'trialing' else 'green' if sub.status == 'active' else 'amber' }}">{{ sub.plan_name }} · {{ sub.label }}</span>{% else %}<span class="hint">{{ r.plan or '–' }}</span>{% endif %}
          {% if r.hold == 'billing' %}<span class="chip amber">{{ _('Ferma') }}</span>{% elif r.active is sameas false %}<span class="chip red">{{ _('Sospesa') }}</span>{% endif %}
        </td>
        {% set us = r.usage.get('sites') or {} %}{% set ud = r.usage.get('drafts') or {} %}{% set uc = r.usage.get('llm_cost') or {} %}
        <td class="num">{{ (us.used or 0)|int }}{% if us.limit is not none and us.limit %} / {{ us.limit|int }}{% endif %}</td>
        <td class="num">{{ (ud.used or 0)|int }}{% if ud.limit is not none and ud.limit %} / {{ ud.limit|int }}{% endif %}</td>
        <td class="num">€ {{ (uc.used or 0)|num }}</td>
        <td class="hint num">{{ r.created_at.strftime('%d/%m/%Y') if r.created_at else '–' }}</td>
        <td><span class="row" style="justify-content: flex-end; flex-wrap: nowrap;"><a class="btn sm" href="/admin/newsrooms/{{ r.tenant_id }}">{{ _('Apri') }}</a><a class="btn sm" href="/admin/enter/{{ r.tenant_id }}">{{ _('Entra') }}</a></span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="empty" id="room-none" hidden>{{ _('Nessuna redazione corrisponde alla ricerca.') }}</p>
    </div>
  </section>
  <script>
  (function () {
    var box = document.getElementById('room-filter'), none = document.getElementById('room-none');
    var rows = Array.prototype.slice.call(document.querySelectorAll('table.rooms tbody tr'));
    box.addEventListener('input', function () {
      var q = box.value.trim().toLowerCase(), shown = 0;
      rows.forEach(function (tr) { var on = !q || tr.dataset.find.indexOf(q) >= 0; tr.hidden = !on; if (on) shown++; });
      none.hidden = shown > 0;
    });
  })();
  </script>
  {% else %}
  <p class="empty card">{{ _("Nessuna redazione: creane una da Nuova redazione, oppure lasciala creare al sistema di pagamento con l'API.") }}</p>
  {% endif %}
  {% endif %}

  {% if view == 'redazione' %}
  {% for r in rooms %}
  {% set here = 'r-' ~ r.tenant_id %}
  <section class="card" id="{{ here }}" aria-labelledby="h-{{ r.tenant_id }}">
    <div class="card-head">
      <div style="display: flex; flex-direction: column; gap: 2px;">
        <h2 id="h-{{ r.tenant_id }}">{{ r.name }}</h2>
        <span class="hint"><span class="num">{{ r.tenant_id }}</span> · {{ _('piano {plan}', plan=r.plan or '–') }} · {{ r.members }} {{ _('persona') if r.members == 1 else _('persone') }}{% if r.external_ref %} · {{ _('rif.') }} <span class="num">{{ r.external_ref }}</span>{% endif %} · {{ _('dal {date}', date=r.created_at.strftime('%d/%m/%Y') if r.created_at else '–') }}</span>
      </div>
      <div class="row">
        {% set sub = subs.get(r.tenant_id) %}
        {% if sub %}<span class="chip {{ 'teal' if sub.status == 'trialing' else 'green' if sub.status == 'active' else 'amber' }}">{{ sub.plan_name }} · {{ sub.label }}{% if sub.days_left is not none and sub.status != 'expired' %} · {{ _('{n} gg', n=sub.days_left) }}{% endif %}</span>{% endif %}
        {% if r.hold == 'billing' %}<span class="chip amber">{{ _('Ferma: piano da pagare') }}</span>{% elif r.active is sameas false %}<span class="chip red">{{ _('Sospesa') }}</span>{% else %}<span class="chip green">{{ _('Attiva') }}</span>{% endif %}
        <a class="btn sm" href="/admin/enter/{{ r.tenant_id }}">{{ _('Entra') }}</a>
        <form class="inline" method="post" action="/admin/newsrooms/{{ r.tenant_id }}/active">
          <input type="hidden" name="active" value="{{ '1' if r.active is sameas false else '0' }}">
          <button class="btn sm" type="submit">{{ _('Riattiva') if r.active is sameas false else _('Sospendi') }}</button>
        </form>
      </div>
    </div>
    <div class="pad">
      {% if notice and notice_at and (notice_at == here or notice_at.startswith(here ~ '--')) %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
      {% for what, u in r.usage.items() %}
      {% set pct = (100 * (u.used or 0) / u.limit)|round|int if u.limit else 0 %}
      <div class="meter">
        <span>{{ labels[what] }}</span>
        {% if u.limit %}<div class="bar" role="img" aria-label="{{ pct }}%"><i {% if pct >= 90 %}class="hype"{% endif %} style="width: {{ [pct, 100]|min }}%"></i></div>
        {% else %}<span class="hint">{{ _('senza limite') }}</span>{% endif %}
        <span class="num" style="text-align: right;">{% if what == 'llm_cost' %}€ {{ (u.used or 0)|num }}{% if u.limit is not none %} / {{ u.limit|num(0) }}{% endif %}{% else %}{{ (u.used or 0)|int }}{% if u.limit is not none %} / {{ u.limit|int }}{% endif %}{% endif %}</span>
      </div>
      {% endfor %}
      <details class="act" data-tone="green" id="{{ here }}--sub" {% if notice_at == here ~ '--sub' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">€</span>{{ _('Abbonamento') }}<span class="sub">{% if sub %}{{ sub.plan_name }}, {{ sub.label|lower }}{% if sub.current_period_end %}, {{ _('pagato fino al {date}', date=sub.current_period_end.strftime('%d/%m/%Y')) }}{% elif sub.trial_ends_at %}, {{ _('prova fino al {date}', date=sub.trial_ends_at.strftime('%d/%m/%Y')) }}{% endif %}{% if sub.provider == 'mollie' %} (Mollie){% elif sub.provider == 'reseller' %} ({{ _('rivenditore') }}){% endif %}{% endif %}</span></summary>
        <form method="post" action="/admin/subscriptions/{{ r.tenant_id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Piano') }}<select name="plan">{% for p in plans %}<option value="{{ p.code }}" {% if sub and sub.plan_code == p.code %}selected{% endif %}>{{ p.name }}</option>{% endfor %}</select></label>
          <label class="field">{{ _('Rinnovo') }}<select name="interval"><option value="month">{{ _('Mensile') }}</option><option value="year" {% if sub and sub.billing_interval == 'year' %}selected{% endif %}>{{ _('Annuale') }}</option></select></label>
          <label class="field">{{ _('Pagato fino al') }}<input name="paid_until" type="date"></label>
          <label class="field">{{ _('Importo ricevuto (€)') }}<input name="amount" inputmode="decimal" placeholder="{{ _('nessuno') }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        <p class="hint">{{ _('Con un importo registra un pagamento ricevuto (bonifico) e, senza data, allunga di un mese o un anno. Senza importo cambia solo il piano; senza data il piano non scade. I limiti del piano sostituiscono quelli della redazione.') }}</p>
      </details>
      {% set pays = payments.get(r.tenant_id, []) %}
      {% if pays %}
      <details class="act" data-tone="amber" id="{{ here }}--pay" {% if notice_at == here ~ '--pay' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">↺</span>{{ _('Pagamenti e rimborsi') }}<span class="sub">{{ pays|length }}</span></summary>
        <div style="overflow-x: auto;">
        <table class="tbl" style="margin-top: 8px;">
          <thead><tr><th>{{ _('Data') }}</th><th>{{ _('Tipo') }}</th><th class="num">{{ _('Importo') }}</th><th>{{ _('Stato') }}</th><th>{{ _('ID Mollie') }}</th></tr></thead>
          <tbody>
          {% for p in pays %}
            <tr>
              <td>{{ (p.paid_at or p.created_at).strftime('%d/%m/%Y %H:%M') if (p.paid_at or p.created_at) else '' }}</td>
              <td>{{ {'first': _('primo pagamento'), 'recurring': _('rinnovo'), 'manual': _('bonifico'), 'refund': _('rimborso'), 'credits': _('crediti')}.get(p.kind, p.kind) }}</td>
              <td class="num">{% if p.kind == 'refund' %}−{% endif %}{{ money(p.amount_cents, p.currency) }}</td>
              <td>{{ {'paid': _('pagato'), 'open': _('in attesa'), 'queued': _('in coda'), 'pending': _('in corso'), 'processing': _('in corso'), 'refunded': _('rimborsato'), 'canceled': _('annullato'), 'failed': _('non riuscito'), 'expired': _('scaduto')}.get(p.status, p.status) }}</td>
              <td><code>{{ p.provider_payment_id or '' }}</code></td>
            </tr>
            {% if p.refundable_cents and online %}
            <tr><td colspan="5">
              <details class="act sm" data-tone="red">
                <summary><span class="ico" aria-hidden="true">↺</span>{{ _('Rimborsa {payment}', payment=p.provider_payment_id) }}<span class="sub">{{ _('fino a {amount}', amount=money(p.refundable_cents, p.currency)) }}</span></summary>
                <form method="post" action="/admin/payments/{{ p.id }}/refund" class="form-grid" style="margin-top: 8px;">
                  <label class="field">{{ _('Importo (€)') }}<input name="amount" inputmode="decimal" placeholder="{{ (p.refundable_cents / 100)|num }}"></label>
                  <label class="field">{{ _('Poi') }}<select name="then">
                    <option value="none">{{ _("Solo il rimborso: l'abbonamento resta com'è") }}</option>
                    <option value="renewals">{{ _('Ferma i rinnovi: la redazione lavora fino a fine periodo') }}</option>
                    <option value="now">{{ _('Ferma subito la redazione e i rinnovi') }}</option>
                  </select></label>
                  <label class="field"><span><input type="checkbox" name="confirm" value="1" required> {{ _('Confermo: i soldi tornano al cliente e non si annulla') }}</span></label>
                  <div><button class="btn danger" type="submit">{{ _('Rimborsa') }}</button></div>
                </form>
                <p class="hint">{{ _('Vuoto rimborsa tutto quello che resta ({amount}). Il rimborso parte da Mollie e arriva sulla carta del cliente in qualche giorno lavorativo; Mollie trattiene la sua commissione.', amount=money(p.refundable_cents, p.currency)) }}</p>
              </details>
            </td></tr>
            {% endif %}
          {% endfor %}
          </tbody>
        </table>
        </div>
      </details>
      {% endif %}
      {% if single_room %}{% set c = room_customer or {} %}
      <details class="act" data-tone="teal" id="{{ here }}--customer" {% if notice_at == here ~ '--customer' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">☺</span>{{ _('Persone e cliente') }}<span class="sub">{% if room_customer %}{{ room_customer.name }}{% else %}{{ _('nessun cliente collegato') }}{% endif %}</span></summary>
        {% if notice and notice_at == here ~ '--customer' %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
        <h3 style="margin-top: 8px;">{{ _('Persone') }}</h3>
        {% for x in people %}
        <div class="list-row"><span>{{ x.email }}{% if x.name %} · {{ x.name }}{% endif %}</span><span>{{ {'owner': _('Direttore'), 'editor': _('Redattore'), 'viewer': _('Lettura')}.get(x.role, x.role) }}{% if not x.active %} · {{ _('invito non ancora accettato') }}{% endif %}</span></div>
        {% else %}<p class="hint">{{ _('Nessuna persona.') }}</p>{% endfor %}
        <h3 style="margin-top: 14px;">{{ _('Cliente') }}</h3>
        {% if room_customer %}<p>{{ room_customer.name }} · {{ room_customer.email }}{% if room_customer.vat_number %} · {{ _('P.IVA') }} {{ room_customer.vat_number }}{% endif %} · <a href="/admin/customers#c-{{ room_customer.id }}">{{ _('scheda cliente') }}</a></p>{% else %}<p class="hint">{{ _('Questa redazione non ha un cliente: collegane uno esistente o compila i dati qui sotto per crearlo.') }}</p>{% endif %}
        {% if customers %}
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/customer/link" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Cliente esistente') }}<select name="customer_id"><option value="">{{ _('nessuno') }}</option>{% for cu in customers %}<option value="{{ cu.id }}" {% if room_customer and room_customer.id == cu.id %}selected{% endif %}>{{ cu.name }} · {{ cu.email }}</option>{% endfor %}</select></label>
          <div><button class="btn" type="submit">{{ _('Collega') }}</button></div>
        </form>
        {% endif %}
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/customer" class="form-grid billing" style="margin-top: 12px;">
          <label class="field">{{ _('Tipo') }}<select name="kind"><option value="company">{{ _('Azienda o professionista') }}</option><option value="person" {% if c.kind == 'person' %}selected{% endif %}>{{ _('Privato') }}</option></select></label>
          <label class="field" style="grid-column: span 2;">{{ _('Ragione sociale o nome') }}<input name="name" value="{{ c.name or '' }}" required maxlength="200"></label>
          <label class="field">{{ _('Partita IVA') }}<input name="vat_number" value="{{ c.vat_number or '' }}" maxlength="40"></label>
          <label class="field">{{ _('Codice fiscale') }}<input name="tax_code" value="{{ c.tax_code or '' }}" maxlength="40"></label>
          <label class="field">{{ _('Codice destinatario SDI') }}<input name="sdi_code" value="{{ c.sdi_code or '' }}" maxlength="7"></label>
          <label class="field">{{ _('Email per le fatture') }}<input name="email" type="email" value="{{ c.email or ((people|selectattr('role', 'equalto', 'owner')|map(attribute='email')|first) or '') }}" required></label>
          <label class="field">{{ _('Telefono') }}<input name="phone" value="{{ c.phone or '' }}" maxlength="40"></label>
          <label class="field">{{ _('PEC') }}<input name="pec" type="email" value="{{ c.pec or '' }}"></label>
          <label class="field" style="grid-column: span 2;">{{ _('Indirizzo') }}<input name="address" value="{{ c.address or '' }}" maxlength="200"></label>
          <label class="field">{{ _('CAP') }}<input name="postal_code" value="{{ c.postal_code or '' }}" maxlength="20"></label>
          <label class="field">{{ _('Città') }}<input name="city" value="{{ c.city or '' }}" maxlength="100"></label>
          <label class="field">{{ _('Provincia') }}<input name="province" value="{{ c.province or '' }}" maxlength="10"></label>
          <label class="field">{{ _('Paese') }}<input name="country" value="{{ c.country or 'IT' }}" maxlength="2"></label>
          <div class="wide"><button class="btn" type="submit">{{ _('Salva i dati') if room_customer else _('Crea il cliente e collegalo') }}</button></div>
        </form>
      </details>
      {% endif %}
      {% set cr = credits.get(r.tenant_id) %}
      <details class="act" id="{{ here }}--credits" {% if notice_at == here ~ '--credits' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">◎</span>{{ _('Crediti') }}<span class="sub">{% if cr and cr.enabled %}{{ _('{left} di {month} del mese', left=cr.month_left, month=cr.month) }} · {{ _('{n} extra', n=cr.extra) }}{% else %}{{ _('crediti non attivi') }}{% endif %}</span></summary>
        {% if notice and notice_at == here ~ '--credits' %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
        {% if cr and cr.enabled %}
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/credits" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Crediti') }}<input name="credits" inputmode="numeric" required placeholder="500"></label>
          <label class="field">{{ _('Pagati (€)') }}<input name="amount" inputmode="decimal" placeholder="{{ _('vuoto: regalati') }}"></label>
          <label class="field">{{ _('Nota') }}<input name="note" maxlength="200" placeholder="{{ _('bonifico del 31/10') }}"></label>
          <div><button class="btn" type="submit">{{ _('Registra') }}</button></div>
        </form>
        <p class="hint">{{ _('Crediti extra: non scadono e si usano dopo quelli del mese. Con un importo resta anche il pagamento (un bonifico); un numero negativo corregge un errore.') }}</p>
        {% else %}
        <p class="hint">{{ _('Questa redazione non usa i crediti: metti i crediti al mese in "Nome, piano e limiti" (anche 0) per attivarli.') }}</p>
        {% endif %}
      </details>
      <details class="act" id="{{ here }}--edit" {% if notice_at == here ~ '--edit' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">✎</span>{{ _('Nome, piano e limiti') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Nome') }}<input name="name" value="{{ r.name }}" maxlength="100" required></label>
          <label class="field">{{ _('Piano') }}<input name="plan" value="{{ r.plan or '' }}" maxlength="60"></label>
          <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" value="{{ r.max_sites if r.max_sites is not none else '' }}"></label>
          <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" value="{{ r.max_active_sources if r.max_active_sources is not none else '' }}"></label>
          <label class="field">{{ _('Notizie al giorno') }}<input name="max_items_per_day" inputmode="numeric" value="{{ r.max_items_per_day if r.max_items_per_day is not none else '' }}"></label>
          <label class="field">{{ _('Bozze al mese') }}<input name="max_drafts_month" inputmode="numeric" value="{{ r.max_drafts_month if r.max_drafts_month is not none else '' }}"></label>
          <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" value="{{ r.max_languages if r.max_languages is not none else '' }}"></label>
          <label class="field">{{ _('Crediti al mese') }}<input name="credits_month" inputmode="numeric" value="{{ r.credits_month if r.credits_month is not none else '' }}"></label>
          <label class="field">{{ _('Costo modello al mese (€)') }}<input name="max_llm_cost_month" inputmode="decimal" value="{{ (r.max_llm_cost_month|string)|replace('.', ',') if r.max_llm_cost_month is not none else '' }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        <p class="hint">{{ _('Vuoto vuol dire senza limite. Il costo del modello diventa anche il limite della redazione nel Core.') }}</p>
      </details>
      <details class="act" data-tone="teal" id="{{ here }}--invite" {% if notice_at == here ~ '--invite' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">+</span>{{ _('Invita una persona') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/invite" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
          <label class="field">{{ _('Ruolo') }}<select name="role"><option value="owner" selected>{{ _('Direttore') }}</option><option value="editor">{{ _('Redattore') }}</option><option value="viewer">{{ _('Lettura') }}</option></select></label>
          <div><button class="btn" type="submit">{{ _("Crea l'invito") }}</button></div>
        </form>
      </details>
      <details class="act" data-tone="red" id="{{ here }}--delete" {% if notice_at == here ~ '--delete' %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">✕</span>{{ _('Cancella la redazione') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/delete" class="form-grid" style="margin-top: 8px;">
