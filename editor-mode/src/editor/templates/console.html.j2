        <span class="row">
          {% if x.active %}<form class="inline" method="post" action="/admin/resellers/{{ x.id }}/key"><button class="btn sm" type="submit">{{ _('Nuova chiave') }}</button></form>{% else %}<span class="chip">{{ _('Disattivato') }}</span>{% endif %}
          <form class="inline" method="post" action="/admin/resellers/{{ x.id }}/active"><input type="hidden" name="active" value="{{ '0' if x.active else '1' }}"><button class="btn sm" type="submit">{{ _('Disattiva') if x.active else _('Riattiva') }}</button></form>
        </span>
      </div>
      <details class="act sm" id="v-{{ x.id }}" {% if notice_at == 'v-' ~ x.id %}open{% endif %}>
        <summary><span class="ico" aria-hidden="true">✎</span>{{ _('Modifica o elimina {name}', name=x.name) }}</summary>
        {% if notice and notice_at == 'v-' ~ x.id %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
        <form method="post" action="/admin/resellers/{{ x.id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Nome') }}<input name="name" value="{{ x.name }}" required maxlength="100"></label>
          <label class="field">{{ _('Email') }}<input name="email" type="email" value="{{ x.email }}" required></label>
          <label class="field">{{ _('Sconto (%)') }}<input name="discount" inputmode="decimal" value="{{ x.discount_pct|num(0) if x.discount_pct else '0' }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        {% if not x.customers %}
        <form method="post" action="/admin/resellers/{{ x.id }}/delete" onsubmit='return confirm({{ _('Eliminare {name} e le sue chiavi API?', name=x.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il rivenditore') }}</button></form>
        {% else %}
        <p class="hint">{{ _('Ha dei clienti: si può solo disattivare.') }}</p>
        {% endif %}
      </details>
      {% endfor %}
      <form method="post" action="/admin/resellers" class="form-grid">
        <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100"></label>
        <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
        <label class="field">{{ _('Sconto (%)') }}<input name="discount" inputmode="decimal" value="0"></label>
        <div><button class="btn" type="submit">{{ _('Aggiungi rivenditore') }}</button></div>
      </form>
    </section>
    <section class="card pad col-side" aria-labelledby="h-pay">
      <h2 id="h-pay">{{ _('Pagamenti') }}</h2>
