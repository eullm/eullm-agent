      <label class="field">{{ _('Costo modello al mese (€)') }}<input name="max_llm_cost_month" inputmode="decimal" placeholder="{{ _('senza limite') }}"></label>
      <div><button class="btn pri" type="submit">{{ _('Crea la redazione') }}</button></div>
    </form>
  </section>
  {% endif %}

  {% if view == 'clienti' %}
  <section class="card" id="clienti" aria-labelledby="h-customers">
