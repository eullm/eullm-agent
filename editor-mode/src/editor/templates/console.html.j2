        <td class="hint">{{ reseller_names.get(c.reseller_id) or _('diretto') }}</td>
      </tr>
      <tr><td colspan="5">
        <details class="act sm" id="c-{{ c.id }}" {% if notice_at == 'c-' ~ c.id %}open{% endif %}>
          <summary><span class="ico" aria-hidden="true">✎</span>{{ _('Modifica o elimina {name}', name=c.name) }}</summary>
          {% if notice and notice_at == 'c-' ~ c.id %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
          <form method="post" action="/admin/customers/{{ c.id }}" class="form-grid" style="margin-top: 8px;">
            <label class="field">{{ _('Tipo') }}<select name="kind"><option value="company">{{ _('Azienda o professionista') }}</option><option value="person" {% if c.kind == 'person' %}selected{% endif %}>{{ _('Privato') }}</option></select></label>
            {% for f, label in [('name', _('Nome o ragione sociale')), ('email', _('Email')), ('phone', _('Telefono')), ('vat_number', _('P.IVA')), ('tax_code', _('Codice fiscale')), ('address', _('Indirizzo')), ('postal_code', _('CAP')), ('city', _('Città')), ('province', _('Provincia')), ('country', _('Paese')), ('sdi_code', _('Codice SDI')), ('pec', 'PEC')] %}
            <label class="field">{{ label }}<input name="{{ f }}" value="{{ c[f] or '' }}"{% if f in ('name', 'email') %} required{% endif %}></label>
            {% endfor %}
            <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
          </form>
          {% if not c.newsrooms %}
          <form method="post" action="/admin/customers/{{ c.id }}/delete" onsubmit='return confirm({{ _('Eliminare il cliente {name}?', name=c.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il cliente') }}</button></form>
          {% else %}
          <p class="hint">{{ _('Si può eliminare quando non ha più redazioni.') }}</p>
          {% endif %}
        </details>
      </td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <p class="empty">{{ _('Nessun cliente: arrivano dal sito con <code>POST /api/operator/signup</code>, o dai rivenditori.') }}</p>
    {% endif %}
    {% set orphans = rooms|selectattr('customer_id', 'none')|list %}
