      {% else %}<p class="lead">{{ _('Pagamenti online non configurati: registra i bonifici da "Abbonamento" di ogni redazione. Per attivarli metti <code>EDITOR_MOLLIE_API_KEY</code> nel <code>.env</code>.') }}</p>{% endif %}
    </section>
  </div>
  {% endif %}

  {% if view == 'piani' %}
  <section class="card" id="piani" aria-labelledby="h-plans">
    <div class="card-head"><h2 id="h-plans">{{ _('Piani') }}</h2>
    {% if notice and notice_at == 'piani' %}<p class="notice" role="status" style="margin: 0 16px;">{{ notice }}</p>{% endif %}<span class="hint">{{ _('prezzi IVA esclusa') }}</span></div>
    <div class="pad">
    {% for p in plans %}
    <details class="act" id="p-{{ p.code }}" {% if p.public %}data-tone="green"{% endif %} {% if notice_at == 'p-' ~ p.code %}open{% endif %}>
    <summary><span class="ico" aria-hidden="true">€</span>{{ p.name }}<span class="sub">{% if p.price_month_cents is not none %}{{ money(p.price_month_cents, p.currency) }} {{ _('al mese') }}{% endif %}{% if p.price_year_cents is not none %} · {{ money(p.price_year_cents, p.currency) }} {{ _("all'anno") }}{% endif %}{% if p.trial_days %} · {{ _('{n} giorni di prova', n=p.trial_days) }}{% endif %} · {{ _('sul sito') if p.public else _('non sul sito') }}</span></summary>
    {% if notice and notice_at == 'p-' ~ p.code %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
    <form method="post" action="/admin/plans/{{ p.code }}" class="form-grid" style="margin: 12px 16px 16px;">
      <label class="field">{{ _('Nome') }} <span class="num">({{ p.code }})</span><input name="name" value="{{ p.name }}" required></label>
      <label class="field">{{ _('Al mese (€)') }}<input name="price_month" inputmode="decimal" value="{{ '%.2f'|format(p.price_month_cents / 100) if p.price_month_cents is not none else '' }}"></label>
      <label class="field">{{ _("All'anno (€)") }}<input name="price_year" inputmode="decimal" value="{{ '%.2f'|format(p.price_year_cents / 100) if p.price_year_cents is not none else '' }}"></label>
      <label class="field">{{ _('Giorni di prova') }}<input name="trial_days" inputmode="numeric" value="{{ p.trial_days }}"></label>
      <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" value="{{ p.max_sites if p.max_sites is not none else '' }}"></label>
      <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" value="{{ p.max_languages if p.max_languages is not none else '' }}"></label>
      <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" value="{{ p.max_active_sources if p.max_active_sources is not none else '' }}"></label>
      <label class="field">{{ _('Notizie al giorno') }}<input name="max_items_per_day" inputmode="numeric" value="{{ p.max_items_per_day if p.max_items_per_day is not none else '' }}"></label>
      <label class="field">{{ _('Articoli al mese') }}<input name="max_drafts_month" inputmode="numeric" value="{{ p.max_drafts_month if p.max_drafts_month is not none else '' }}"></label>
      <label class="field">{{ _('Crediti al mese') }}<input name="credits_month" inputmode="numeric" value="{{ p.credits_month if p.credits_month is not none else '' }}"></label>
      <label class="field">{{ _('Descrizione') }}<input name="description" value="{{ p.description }}"></label>
      <label class="field">{{ _('Redazione automatica') }}<select name="autopilot"><option value="1" {% if p.autopilot is not false %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if p.autopilot is false %}selected{% endif %}>{{ _('No') }}</option></select></label>
      <label class="field">{{ _('Sul sito') }}<select name="public"><option value="1" {% if p.public %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not p.public %}selected{% endif %}>{{ _('No') }}</option></select></label>
      <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
    </form>
    {% if p.code != 'trial' %}
    <form method="post" action="/admin/plans/{{ p.code }}/delete" style="margin: -4px 16px 16px;" onsubmit='return confirm({{ _('Eliminare il piano {name}?', name=p.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il piano {name}', name=p.name) }}</button></form>
    {% endif %}
    </details>
    {% endfor %}
    <form method="post" action="/admin/plans" class="form-grid" style="margin: 20px 0 16px;">
      <label class="field">{{ _('Codice del nuovo piano') }}<input name="code" required maxlength="40" pattern="[a-z0-9-]{1,40}" placeholder="pro-plus"></label>
      <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100"></label>
      <div><button class="btn" type="submit">{{ _('Aggiungi un piano') }}</button></div>
    </form>
    <p class="hint">{{ _('Il sito pubblico legge i piani da <code>/api/public/plans</code>. Il piano "Prova" è quello di chi si iscrive.') }}</p>
    </div>
  </section>

  <section class="card" id="crediti" aria-labelledby="h-credits">
    <div class="card-head"><h2 id="h-credits">{{ _('Crediti') }}</h2>
    {% if notice and notice_at == 'crediti' %}<p class="notice" role="status" style="margin: 0 16px;">{{ notice }}</p>{% endif %}<span class="hint">{{ _('quello che va oltre il piano') }}</span></div>
    <div class="pad">
    <p class="lead">{{ _('Ogni piano dà crediti ogni mese. Si spendono per gli articoli e le traduzioni oltre quelli del piano e per le copertine rifatte dopo le {n} gratuite di ogni articolo. Finiti quelli del mese si usano i crediti extra dei pacchetti, che non scadono.', n=2) }}</p>
    <h3>{{ _('Listino') }}</h3>
    <form method="post" action="/admin/credits/prices" class="form-grid" style="margin-bottom: 16px;">
      <label class="field">{{ _('Articolo oltre il piano') }}<input name="article" inputmode="numeric" value="{{ credit_prices.article }}"></label>
      <label class="field">{{ _('Traduzione oltre il piano') }}<input name="translation" inputmode="numeric" value="{{ credit_prices.translation }}"></label>
      <label class="field">{{ _('Copertina rifatta') }}<input name="image" inputmode="numeric" value="{{ credit_prices.image }}"></label>
      <div><button class="btn" type="submit">{{ _('Salva il listino') }}</button></div>
    </form>
    <h3>{{ _('Pacchetti') }}</h3>
    {% for k in packs %}
    <details class="act" id="k-{{ k.code }}" {% if k.active %}data-tone="green"{% endif %}>
      <summary><span class="ico" aria-hidden="true">◎</span>{{ k.name }}<span class="sub">{{ _('{n} crediti', n=k.credits) }} · {{ money(k.price_cents, k.currency) }} · {{ _('in vendita') if k.active else _('non in vendita') }}</span></summary>
      <form method="post" action="/admin/credits/packs/{{ k.code }}" class="form-grid" style="margin: 12px 16px 16px;">
        <label class="field">{{ _('Nome') }} <span class="num">({{ k.code }})</span><input name="name" value="{{ k.name }}" required></label>
        <label class="field">{{ _('Crediti') }}<input name="credits" inputmode="numeric" value="{{ k.credits }}" required></label>
        <label class="field">{{ _('Prezzo (€)') }}<input name="price" inputmode="decimal" value="{{ '%.2f'|format(k.price_cents / 100) }}" required></label>
        <label class="field">{{ _('Ordine') }}<input name="sort" inputmode="numeric" value="{{ k.sort }}"></label>
        <label class="field">{{ _('In vendita') }}<select name="active"><option value="1" {% if k.active %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not k.active %}selected{% endif %}>{{ _('No') }}</option></select></label>
        <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
      </form>
      <form method="post" action="/admin/credits/packs/{{ k.code }}/delete" style="margin: -4px 16px 16px;" onsubmit='return confirm({{ _('Eliminare il pacchetto {name}?', name=k.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il pacchetto {name}', name=k.name) }}</button></form>
    </details>
    {% endfor %}
    <form method="post" action="/admin/credits/packs" class="form-grid" style="margin: 20px 0 16px;">
      <label class="field">{{ _('Codice del nuovo pacchetto') }}<input name="code" required maxlength="40" pattern="[a-z0-9-]{1,40}" placeholder="xl"></label>
      <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100" placeholder="{{ _('10.000 crediti') }}"></label>
      <label class="field">{{ _('Crediti') }}<input name="credits" inputmode="numeric" required></label>
      <label class="field">{{ _('Prezzo (€)') }}<input name="price" inputmode="decimal" required></label>
      <div><button class="btn" type="submit">{{ _('Aggiungi un pacchetto') }}</button></div>
    </form>
    <p class="hint">{{ _("I clienti comprano i pacchetti in Il mio piano con Mollie; un bonifico lo registri nella scheda della redazione, in Crediti. Avvisiamo il direttore per email all'80% e al 100% dei crediti del mese.") }}</p>
    </div>
  </section>
  {% endif %}

  {% if view == 'aggiornamenti' %}
  <section class="card pad" id="aggiornamenti" aria-labelledby="h-updates">
    <h2 id="h-updates">{{ _('Aggiornamenti') }}</h2>
    {% if notice and notice_at == 'aggiornamenti' %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
    {% set st = updates.status or {} %}
    {% set av = updates.available or {} %}
    <div class="list-row"><span>{{ _('Versione installata') }}</span><span class="num">{{ updates.installed }}</span></div>
    {% if updates.enabled %}
    <div class="list-row"><span>{{ _('Ultima versione') }}</span><span class="num">{% if av.version %}{% if av.url %}<a href="{{ av.url }}" rel="noopener" target="_blank">{{ av.version }}</a>{% else %}{{ av.version }}{% endif %}{% else %}–{% endif %}</span></div>
    {% if av.checked_at %}<p class="hint">{{ _('Controllata il {date} alle {time}. Il controllo si ripete ogni 6 ore.', date=av.checked_at[8:10] ~ '/' ~ av.checked_at[5:7], time=av.checked_at[11:16] ~ ' UTC') }}{% if av.error %} {{ _('Ultimo controllo non riuscito: {error}', error=av.error) }}{% endif %}</p>{% endif %}
    {% if updates.pending %}
      {% if updates.stale %}<p class="error">{{ _('La richiesta di aggiornamento alla {version} aspetta da più di 5 minuti: sul server lo script update.sh non è installato o il cron non gira (vedi deploy/server/README.md, "Updating from the console").', version=updates.pending.version) }}</p>
      {% else %}<p class="lead">{{ _('Aggiornamento alla {version} chiesto: il server lo prende entro un minuto.', version=updates.pending.version) }}</p>{% endif %}
    {% elif st.state == 'running' %}
      <p class="lead">{{ _('Aggiornamento alla {version} in corso: {step}.', version=st.version, step={'backup': _('backup del database'), 'pull': _('download della versione'), 'restart': _('riavvio'), 'check': _('verifica')}.get(st.step, st.step)) }}</p>
    {% elif updates.newer %}
      <form method="post" action="/admin/updates/apply" onsubmit='return confirm({{ _('Aggiornare alla versione {version}? Prima viene fatto un backup; il pannello resta fermo per qualche secondo.', version=av.version)|string|tojson }})'>
        <input type="hidden" name="version" value="{{ av.version }}">
        <button class="btn pri" type="submit">{{ _('Aggiorna alla {version}', version=av.version) }}</button>
      </form>
      <p class="hint">{{ _('Leggi le note della versione prima di aggiornare: il link è sul numero di versione.') }}</p>
    {% else %}
      <p class="hint">{{ _('Il server è aggiornato.') }}</p>
    {% endif %}
    {% if st.state in ('done', 'failed') %}
      {% if st.state == 'done' %}<p class="hint">{{ _('Ultimo aggiornamento: dalla {old} alla {version}, il {date}.', old=st['from'], version=st.version, date=st.at[8:10] ~ '/' ~ st.at[5:7] ~ ' ' ~ st.at[11:16] ~ ' UTC') }}</p>
      {% else %}<p class="error">{{ _('Aggiornamento alla {version} non riuscito durante: {step}.', version=st.version, step={'backup': _('backup del database'), 'pull': _('download della versione'), 'restart': _('riavvio'), 'check': _('verifica')}.get(st.step, st.step)) }}
        {% if st.step in ('backup', 'pull') %}{{ _('Non è cambiato niente: il server è ancora alla {old}.', old=st['from']) }}{% else %}{{ _('La {version} è installata ma non risponde come dovrebbe: guarda il registro. Il backup fatto prima è nella cartella backup del server.', version=st.version) }}{% endif %}</p>{% endif %}
      {% if updates.log %}<details class="act sm"><summary><span class="ico" aria-hidden="true">≡</span>{{ _('Registro') }}</summary><pre style="white-space: pre-wrap; font-size: 12px;">{{ updates.log }}</pre></details>{% endif %}
    {% endif %}
    <form method="post" action="/admin/updates/check" style="margin-top: 8px;"><button class="btn sm" type="submit">{{ _('Controlla adesso') }}</button></form>
    {% if updates.pending or st.state == 'running' %}
    {% set target = (updates.pending or {}).version or st.version %}
    <p class="notice" role="status" id="update-wait" data-target="{{ target }}">{{ _('Il pannello si ferma per qualche secondo durante il riavvio e torna da solo quando la {version} risponde: non serve ricaricare la pagina. I lavori in corso tornano in coda e ripartono, i dati non si toccano.', version=target) }}</p>
    <script>
    /* Waits for the new version: errors while the server restarts (503, 500,
       no answer) are expected and ignored; the page reloads once /api/health
       answers with the target version. */
    (function () {
      var box = document.getElementById('update-wait');
      var target = box.dataset.target, tries = 0;
      function poll() {
        fetch('/api/health', {cache: 'no-store'})
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (h) {
            // The new version answers, or ten minutes went by (the panel then shows what happened).
            if ((h && h.version === target) || ++tries > 200) location.replace('/admin/updates?updated=' + Date.now() + '#aggiornamenti');
            else setTimeout(poll, 3000);
          })
          .catch(function () { setTimeout(poll, 3000); });
      }
      setTimeout(poll, 3000);
    })();
    </script>
    {% endif %}
    {% else %}
    <p class="hint">{{ _('Per aggiornare da qui serve lo script update.sh sul server: vedi deploy/server/README.md, "Updating from the console". Senza, si aggiorna dal terminale.') }}</p>
    {% endif %}
    {% if installs.seen %}
    <h3 id="installazioni" style="margin-top: 18px;">{{ _('Installazioni di Redazia') }}</h3>
    <p class="hint">{{ _("Ogni installazione chiede a questo server l'ultima versione ogni 6 ore, con un identificativo casuale e la versione installata. Chi ha EDITOR_TELEMETRY=off non viene contato.") }}</p>
    <div class="list-row"><span>{{ _('Attive negli ultimi 7 giorni') }}</span><span class="num">{{ installs.active }}</span></div>
    {% for v, n in installs.versions %}<div class="list-row"><span class="hint">{{ _('versione {version}', version=v) }}</span><span class="num">{{ n }}</span></div>{% endfor %}
    <div class="list-row"><span>{{ _('Nuove negli ultimi 30 giorni') }}</span><span class="num">{{ installs.new_30 }}</span></div>
    <div class="list-row"><span>{{ _('Viste in tutto') }}</span><span class="num">{{ installs.seen }}</span></div>
    {% endif %}
  </section>
  {% endif %}

  {% if view == 'operatori' %}
  <div class="cols">
    <section class="card pad col-wide" id="operatori" aria-labelledby="h-ops">
      <h2 id="h-ops">{{ _('Amministratori') }}</h2>
      {% for o in operators %}
      <div class="list-row"><span>{{ o.name or o.email }}{% if o.name %} <span class="hint">{{ o.email }}</span>{% endif %}</span><span class="row">{% if not o.password_hash %}<span class="chip amber">{{ _('Invito non accettato') }}</span>{% endif %}{% if o.id != me.user_id %}<form class="inline" method="post" action="/admin/operators/{{ o.id }}/remove" onsubmit='return confirm({{ _('Togliere la console a {email}? Le sue redazioni restano.', email=o.email)|string|tojson }})'><button class="btn sm" type="submit">{{ _('Togli') }}</button></form>{% endif %}</span></div>
      {% endfor %}
      {% for i in pending %}
      <div class="list-row"><span>{{ i.email }}</span><span class="row"><span class="chip">{{ _('Invitato, scade {date}', date=i.expires_at.strftime('%d/%m')) }}</span><form class="inline" method="post" action="/admin/invites/{{ i.token_sha256 }}/revoke"><button class="btn sm" type="submit">{{ _('Annulla') }}</button></form></span></div>
      {% endfor %}
      <form method="post" action="/admin/operators" class="form-grid">
        <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
        <div><button class="btn" type="submit">{{ _('Invita un amministratore') }}</button></div>
      </form>
      <form method="post" action="/admin/reset" class="form-grid">
        <label class="field">{{ _('Email di un account') }}<input name="email" type="email" required></label>
        <div><button class="btn" type="submit">{{ _('Link per nuova password') }}</button></div>
      </form>
    </section>
  </div>
  {% endif %}

  {% if view == 'api' %}
  <div class="cols">
    <section class="card pad col-side" id="api" aria-labelledby="h-keys">
      <h2 id="h-keys">{{ _('Chiavi API') }}</h2>
      <p class="hint">{{ _('Per il sistema di pagamento: con una chiave crea, aggiorna e sospende le redazioni da <code>/api/operator/tenants</code>.') }}</p>
      {% for k in keys %}
      <div class="list-row">
        <span>{{ k.name }} <span class="hint">{{ k.created_at.strftime('%d/%m/%Y') if k.created_at else '' }}</span></span>
        {% if k.revoked_at %}<span class="chip">{{ _('Revocata') }}</span>{% else %}<form class="inline" method="post" action="/admin/keys/{{ k.id }}/revoke"><button class="btn sm" type="submit">{{ _('Revoca') }}</button></form>{% endif %}
      </div>
      {% endfor %}
      <form method="post" action="/admin/keys" class="form-grid">
        <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100" placeholder="{{ _('pagamenti') }}"></label>
        <div><button class="btn" type="submit">{{ _('Crea chiave') }}</button></div>
      </form>
    </section>
  </div>
  {% endif %}
</main>
</div>
{% include "_once.html.j2" %}
</body>
</html>
