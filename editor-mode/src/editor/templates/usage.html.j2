<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Consumi del modello') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
<style>
.card-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 20px; border-top: 1px solid var(--line-2); }
.card-foot .hint { font-size: 13px; }
.route-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); column-gap: 40px; padding-top: 4px; padding-bottom: 4px; }
.route { display: grid; grid-template-columns: minmax(0, 1fr) 170px; align-items: center; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line-2); font-size: 14px; color: var(--ink-2); }
.route input, .price-tbl input:not([type=checkbox]) { width: 100%; min-width: 0; min-height: 34px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; font: 400 14px var(--sans); color: var(--ink); background: var(--surface); box-sizing: border-box; }
.route input::placeholder, .price-tbl input::placeholder { color: var(--muted); }
.route input:focus, .price-tbl input:focus { border-color: var(--ink-2); }
.price-wrap { overflow-x: auto; }
.price-tbl { min-width: 680px; }
.price-tbl td { padding: 6px 10px; }
.price-tbl th:nth-child(2), .price-tbl th:nth-child(3), .price-tbl td:nth-child(2), .price-tbl td:nth-child(3) { width: 120px; }
.price-tbl td:nth-child(2) input, .price-tbl td:nth-child(3) input { text-align: right; font-family: var(--mono); }
.price-tbl th:last-child, .price-tbl td:last-child { width: 56px; text-align: center; }
.price-tbl input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--ink-2); }
.price-tbl .mname { font-family: var(--mono); font-size: 13px; color: var(--ink); overflow-wrap: anywhere; }
.price-tbl td small { display: inline; margin-left: 8px; }
.price-tbl tr.new td { background: var(--bg); }
@media (max-width: 640px) { .route { grid-template-columns: minmax(0, 1fr) 130px; } }
</style>
</head>
<body>
{% macro eur(v) %}{% if v is none %}–{% else %}€ {{ v|num(4) }}{% endif %}{% endmacro %}
{% macro row(label, g) %}
<tr>
  <td>{{ label }}</td>
  <td class="num">{{ g.calls|tok }}{% if g.errors %} <span class="hint">· {{ _('{n} errori', n=g.errors) }}</span>{% endif %}</td>
  <td class="num">{{ g['in']|tok }}</td>
  <td class="num">{{ g.out|tok }}</td>
  <td class="num">{{ g.avg_s|num(1) }} s</td>
  <td class="num">{{ eur(g.cost) }}</td>
  <td class="num">{{ eur(g.estimate) }}{% if g.unpriced %} <span class="hint" title="{{ _('Modelli senza prezzo di riferimento: non contati nella stima.') }}">*</span>{% endif %}</td>
</tr>
{% endmacro %}
{% macro head(first) %}<thead><tr><th>{{ first }}</th><th>{{ _('Chiamate') }}</th><th>{{ _('Token in entrata') }}</th><th>{{ _('Token in uscita') }}</th><th>{{ _('Durata media') }}</th><th>{{ _('Costo registrato') }}</th><th>{{ _('Costo stimato') }}</th></tr></thead>{% endmacro %}
<div class="shell">
{% include "_admin_nav.html.j2" %}
<main class="main">
  {% include "_admin_top.html.j2" %}
  {% if notice %}<p class="notice" role="status" id="flash">{{ notice }}</p>{% endif %}
  <header class="page-head">
    <div class="ph-text">
      <h1>{{ _('Consumi del modello') }}</h1>
      <p class="ph-sub">{{ _("Ogni chiamata al modello è registrata quando avviene, anche se il lavoro poi fallisce: redazione, sito, articolo, passo, modello che ha risposto, token in entrata e in uscita, durata ed errore. Il costo registrato è quello dei prezzi in core.yaml (0 per un modello gratuito); il costo stimato usa i prezzi di riferimento qui sotto.") }}</p>
    </div>
    <div class="ph-actions">
      {% for d in (1, 7, 30, 90) %}<a class="btn sm{% if d == r.days %} pri{% endif %}" href="/admin/usage?days={{ d }}">{{ _('{n} giorni', n=d) if d > 1 else _('Ultime 24 ore') }}</a>{% endfor %}
      <a class="btn sm" href="/admin/usage.csv?days={{ r.days }}">{{ _('Scarica CSV') }}</a>
    </div>
  </header>

  <section class="card" aria-labelledby="h-total">
    <div class="card-head"><h2 id="h-total">{{ _('Totale degli ultimi {n} giorni', n=r.days) }}</h2></div>
    <div class="pad">
      <table class="tbl">{{ head(_('Tutto')) }}<tbody>{{ row(_('Tutte le redazioni'), r.total) }}</tbody></table>
      <p class="hint" style="margin: 8px 0 0;">{{ _('Costo registrato: con i prezzi di core.yaml, 0 per un modello gratuito. Costo stimato: con i prezzi di riferimento in fondo alla pagina. * vuol dire che alcuni modelli non hanno un prezzo di riferimento e mancano dalla stima.') }}</p>
      {% if r.average %}
      <p class="lead" style="margin: 12px 0 0;">{{ _('Un articolo costa in media {calls} chiamate, {tin} token in entrata e {tout} in uscita (su {n} articoli scritti), proposta compresa.', calls=r.average.calls|num(1), tin=r.average['in']|tok, tout=r.average.out|tok, n=r.average.articles) }}{% if r.average.estimate is not none %} {{ _('Stima: € {eur} ad articolo.', eur=r.average.estimate|num(4)) }}{% endif %}</p>
      {% endif %}
    </div>
  </section>

  <nav class="tabs" id="usage-tabs" aria-label="{{ _('Consumi divisi') }}" style="margin: 4px 0 12px;">
    <a href="#p-purpose" class="on" aria-current="true">{{ _('Per passo') }}</a><a href="#p-model">{{ _('Per modello') }}</a><a href="#p-tenant">{{ _('Per redazione') }}</a><a href="#p-site">{{ _('Per sito') }}</a><a href="#articoli">{{ _('Per articolo') }}</a>
  </nav>
  <section class="card pane" id="p-purpose" aria-labelledby="h-purpose">
    <div class="card-head"><h2 id="h-purpose">{{ _('Per passo') }}</h2></div>
    <div class="pad"><table class="tbl">{{ head(_('Passo')) }}<tbody>
      {% for g in r.by_purpose %}{{ row(_(purposes.get(g.key, g.key)), g) }}{% else %}<tr><td colspan="7" class="hint">{{ _('Nessuna chiamata nel periodo.') }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="card pane" id="p-model" aria-labelledby="h-model">
    <div class="card-head"><h2 id="h-model">{{ _('Per modello') }}</h2></div>
    <div class="pad"><table class="tbl">{{ head(_('Modello che ha risposto')) }}<tbody>
      {% for g in r.by_model %}{{ row(g.key, g) }}{% else %}<tr><td colspan="7" class="hint">{{ _('Nessuna chiamata nel periodo.') }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="card pane" id="p-tenant" aria-labelledby="h-tenant">
    <div class="card-head"><h2 id="h-tenant">{{ _('Per redazione') }}</h2></div>
    <div class="pad"><table class="tbl">{{ head(_('Redazione')) }}<tbody>
      {% for g in r.by_tenant %}{{ row(names.get(g.key, g.key), g) }}{% else %}<tr><td colspan="7" class="hint">{{ _('Nessuna chiamata nel periodo.') }}</td></tr>{% endfor %}
    </tbody></table>
    {% if r.by_tenant %}
    <h3 style="margin: 18px 0 6px;">{{ _('Un articolo costa, rispetto a quanto lo paga il cliente') }}</h3>
    <table class="tbl">
      <thead><tr><th>{{ _('Redazione') }}</th><th class="num">{{ _('Articoli scritti') }}</th><th class="num">{{ _('Costo stimato per articolo') }}</th><th class="num">{{ _('Il piano per articolo') }}</th></tr></thead>
      <tbody>
      {% for g in r.by_tenant %}
      {% set mine = r.articles|selectattr('tenant', 'equalto', g.key)|list %}
      {% set sb = subs.get(g.key) %}{% set pl = plans.get(sb.plan_code) if sb else None %}
      <tr>
        <td>{{ names.get(g.key, g.key) }}{% if sb %}<small>{{ sb.plan_name }} · {{ sb.label }}</small>{% endif %}</td>
        <td class="num">{{ mine|length }}</td>
        <td class="num">{% if mine and g.estimate is not none %}{{ eur(g.estimate / mine|length) }}{% else %}–{% endif %}</td>
        <td class="num">{% if pl and pl.price_month_cents and pl.max_drafts_month %}{{ eur(pl.price_month_cents / 100 / pl.max_drafts_month) }}{% else %}–{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="hint">{{ _('Il costo per articolo divide tutto il costo stimato della redazione nel periodo (analisi, fonti, proposte comprese) per gli articoli scritti. Il piano per articolo è il prezzo al mese diviso per gli articoli al mese del piano: se il primo si avvicina al secondo, il piano non rende.') }}</p>
    {% endif %}
    </div>
  </section>

  <section class="card pane" id="p-site" aria-labelledby="h-site">
    <div class="card-head"><h2 id="h-site">{{ _('Per sito') }}</h2></div>
    <div class="pad"><table class="tbl">{{ head(_('Sito')) }}<tbody>
      {% for g in r.by_site %}{{ row(g.key[1] ~ ' · ' ~ names.get(g.key[0], g.key[0]), g) }}{% else %}<tr><td colspan="7" class="hint">{{ _('Nessuna chiamata nel periodo.') }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="card pane" id="articoli" aria-labelledby="h-art">
    <div class="card-head"><div><h2 id="h-art">{{ _('Costo per articolo') }}</h2>
      <span class="hint">{{ _("Scrittura: ogni tentativo della bozza, correzioni comprese. Proposta: le chiamate che hanno proposto articoli sullo stesso tema. Più versioni della stessa bozza: la scrittura è contata sulla più recente.") }}</span></div></div>
    <div class="pad"><table class="tbl">
      <thead><tr><th>{{ _('Articolo') }}</th><th>{{ _('Scrittura') }}</th><th>{{ _('Proposta') }}</th><th>{{ _('Token in entrata') }}</th><th>{{ _('Token in uscita') }}</th><th>{{ _('Costo stimato') }}</th></tr></thead>
      <tbody>
      {% for a in r.articles %}
      <tr>
        <td><strong>{{ a.title }}</strong><br><span class="hint">{{ names.get(a.tenant, a.tenant) }} · {{ _('bozza') }} {{ a.draft_id }}</span></td>
        <td class="num">{{ _('{n} chiamate', n=a.writing.calls) }}</td>
        <td class="num">{{ _('{n} chiamate', n=a.proposing.calls) }}</td>
        <td class="num">{{ a.total['in']|tok }}</td>
        <td class="num">{{ a.total.out|tok }}</td>
        <td class="num">{{ eur(a.total.estimate) }}</td>
      </tr>
      {% else %}<tr><td colspan="6" class="hint">{{ _('Nessuna bozza scritta nel periodo.') }}</td></tr>{% endfor %}
      </tbody>
    </table></div>
  </section>

  <script>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('#usage-tabs a'));
    var panes = Array.prototype.slice.call(document.querySelectorAll('section.pane'));
    function pick(id) {
      if (!panes.some(function (p) { return p.id === id; })) id = 'p-purpose';
      panes.forEach(function (p) { p.hidden = p.id !== id; });
      tabs.forEach(function (a) { var on = a.getAttribute('href') === '#' + id; a.classList.toggle('on', on); if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
    }
    tabs.forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); pick(a.getAttribute('href').slice(1)); history.replaceState(null, '', a.getAttribute('href')); }); });
    pick(location.hash.slice(1));
  })();
  </script>
  <section class="card" id="modelli" aria-labelledby="h-routes">
    <div class="card-head"><div><h2 id="h-routes">{{ _('Modello per passo') }}</h2>
      <span class="hint">{{ _('Il nome di un modello della sezione models di core.yaml (per esempio haiku, sonnet, opus); vuoto: il modello predefinito del Core. Un nome che core.yaml non conosce non ferma nulla: risponde il predefinito e il log lo segnala. Le redazioni non vedono quale modello usano.') }}</span></div></div>
    <form method="post" action="/admin/usage/models">
      <div class="pad route-grid">
        {% for p in routable %}
        <label class="route"><span>{{ _(purposes[p]) }}</span><input name="{{ p }}" value="{{ routes.get(p, '') }}" placeholder="default" list="model-names" maxlength="100" autocomplete="off"></label>
        {% endfor %}
      </div>
      <datalist id="model-names">{% for name in (['default', 'haiku', 'sonnet', 'opus'] + routes.values()|list)|unique %}<option value="{{ name }}">{% endfor %}</datalist>
      <div class="card-foot"><span class="hint">{{ _('Valgono dalla prossima chiamata, entro un minuto.') }}</span><button class="btn pri" type="submit">{{ _('Salva i modelli') }}</button></div>
    </form>
  </section>

  <section class="card" id="prezzi" aria-labelledby="h-prices">
    <div class="card-head"><div><h2 id="h-prices">{{ _('Prezzi di riferimento') }}</h2>
      <span class="hint">{{ _("Euro per milione di token, per modello (il nome come compare in \"Per modello\"). Servono a stimare il costo anche dei modelli gratuiti: metti il prezzo che pagheresti per un servizio equivalente.") }}</span></div></div>
    <form method="post" action="/admin/usage/prices/all">
      <div class="pad price-wrap"><table class="tbl price-tbl">
        <thead><tr><th>{{ _('Modello') }}</th><th class="num">{{ _('Entrata €/M') }}</th><th class="num">{{ _('Uscita €/M') }}</th><th>{{ _('Nota') }}</th><th class="num">{{ _('Togli') }}</th></tr></thead>
        <tbody>
        {% for model in r.models %}{% set p = r.prices.get(model) %}
        <tr>
          <td><input type="hidden" name="model" value="{{ model }}"><span class="mname">{{ model }}</span>{% if not p %}<small>{{ _('senza prezzo') }}</small>{% endif %}</td>
          <td class="num"><input name="input_per_mtok" inputmode="decimal" value="{{ '%g'|format(p.input) if p else '' }}" placeholder="–" aria-label="{{ _('Entrata €/M') }} · {{ model }}"></td>
          <td class="num"><input name="output_per_mtok" inputmode="decimal" value="{{ '%g'|format(p.output) if p else '' }}" placeholder="–" aria-label="{{ _('Uscita €/M') }} · {{ model }}"></td>
          <td><input name="note" value="{{ p.note if p else '' }}" maxlength="200" aria-label="{{ _('Nota') }} · {{ model }}"></td>
          <td class="num">{% if p %}<input type="checkbox" name="remove" value="{{ model }}" aria-label="{{ _('Togli') }} · {{ model }}">{% endif %}</td>
        </tr>
        {% endfor %}
        <tr class="new">
          <td><input name="model" placeholder="{{ _('Altro modello') }}" maxlength="200" aria-label="{{ _('Altro modello') }}"></td>
          <td class="num"><input name="input_per_mtok" inputmode="decimal" aria-label="{{ _('Entrata €/M') }}"></td>
          <td class="num"><input name="output_per_mtok" inputmode="decimal" aria-label="{{ _('Uscita €/M') }}"></td>
          <td><input name="note" maxlength="200" aria-label="{{ _('Nota') }}"></td>
          <td></td>
        </tr>
        </tbody>
      </table></div>
      <div class="card-foot"><span class="hint">{{ _('Entrata e uscita vuote: il modello resta senza prezzo. Spunta Togli per cancellare un prezzo.') }}</span><button class="btn pri" type="submit">{{ _('Salva i prezzi') }}</button></div>
    </form>
  </section>
</main>
</div>
{% include "_once.html.j2" %}
</body>
</html>
