{% extends "base.html.j2" %}
{% block title %}{{ _('Sito e profilo') }}{% endblock %}
{% block main %}
{% macro job_panel() %}
{% if jobs %}
<div class="dashed"><strong>{{ _('Lavori in coda, in corso o non riusciti') }}</strong>{% for j in jobs %}<span class="hint">{{ {'analysis': _('Analisi'), 'discovery': _('Ricerca fonti'), 'draft': _('Bozza'), 'maintain': _('Manutenzione fonti'), 'review': _('Revisione settimanale'), 'collect': _('Raccolta'), 'briefing': _('Briefing'), 'publish': _('Pubblicazione'), 'tick': _('Giro orario')}.get(j.kind, j.kind) }}{% if j.subject %} ({{ j.subject }}){% endif %}: {% if j.status == 'running' %}{{ _('in corso') }}{% elif j.status == 'queued' %}{{ _('in coda') }}{% else %}{{ _('non riuscito, {error}', error=j.error) }}{% endif %}</span>{% endfor %}</div>
{% endif %}
{% endmacro %}
{% if not site %}
<header class="head"><div><span class="kicker">{{ _('Sito e profilo editoriale') }}</span><h1>{{ _('Nessun sito') }}</h1></div></header>
{% with page="site" %}{% include "_help.html.j2" %}{% endwith %}
{{ job_panel() }}
{% else %}
<header class="head">
  <div>
    <span class="kicker">{{ _('Sito e profilo editoriale') }}</span>
    <h1>{{ site.domain }}</h1>
    {% if analysis %}
    <div class="row">
      {% set st = {'complete': ('green', _('Lettura del sito completa')), 'partial': ('amber', _('Lettura del sito parziale')), 'insufficient': ('red', _('Sito: dati insufficienti')), 'failed': ('red', _('Sito non letto'))}[analysis.status] %}
      <span class="chip {{ st[0] }}" title="{{ _('Quante pagine e articoli del sito sono stati letti, con date e lingua. Il motivo di una lettura parziale è sotto.') }}">{{ st[1] }}</span>
      {% if shown %}{% if (shown.body.get('sector') or {}).get('value') %}<span class="chip green" title="{{ _('Il modello ha ricavato settore, pubblico e stile.') }}">{{ _('Profilo completo') }}</span>{% else %}<span class="chip red" title="{{ _('Il modello non ha ricavato settore, pubblico e stile: il motivo è nel profilo, sotto.') }}">{{ _('Profilo da completare') }}</span>{% endif %}{% endif %}
      <span class="chip">{{ _('{n} pagine lette', n=analysis.pages_fetched or 0) }} · {{ when(analysis.started_at) }}</span>
      {% set read_langs = (shown.body.get('languages') if shown else None) or {} %}
      {% if read_langs|length > 1 %}<span class="chip">{{ _('Lingue:') }} {% for k, v in read_langs.items() %}{{ k }} ({{ v }}){{ ', ' if not loop.last }}{% endfor %}</span>
      {% elif site.language %}<span class="chip">{{ _('Lingua: {language}', language=site.language|langname) }}</span>{% endif %}
      <span class="chip">{{ _('robots.txt rispettato') }}</span>
    </div>
    {% endif %}
  </div>
  {% if caller.can('owner') %}
  <div class="row">
    {% if shown %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/review"><button class="btn" type="submit">{{ _('Rianalizza ora') }}</button></form>
    <a class="btn" href="/site?edit=1">{{ _('Modifica il profilo') }}</a>{% endif %}
  </div>
  {% endif %}
</header>
{% set tab = tab if tab in ['profile', 'auto', 'publish', 'site'] else 'profile' %}
{% if not caller.can('owner') and tab in ['auto', 'site'] %}{% set tab = 'profile' %}{% endif %}
<nav class="tabs" aria-label="{{ _('Sezioni della pagina') }}">
  <a href="/site" {% if tab == 'profile' %}class="on" aria-current="page"{% endif %}>{{ _('Profilo') }}</a>
  {% if caller.can('owner') %}<a href="/site?tab=auto" {% if tab == 'auto' %}class="on" aria-current="page"{% endif %}>{{ _('Redazione automatica') }}{% if numbers and numbers.auto.enabled %} <span class="chip green">{{ _('accesa') }}</span>{% endif %}</a>{% endif %}
  <a href="/site?tab=publish" {% if tab == 'publish' %}class="on" aria-current="page"{% endif %}>{{ _('Pubblicazione') }}</a>
  {% if caller.can('owner') %}<a href="/site?tab=site" {% if tab == 'site' %}class="on" aria-current="page"{% endif %}>{{ _('Il sito') }}</a>{% endif %}
</nav>

{{ job_panel() }}

{% macro reason_label(r) %}{% if r == 'already_covered' %}{{ _('già trattato') }}{% elif r == 'off_topic' %}{{ _('fuori tema') }}{% elif r == 'too_generic' %}{{ _('troppo generico') }}{% elif r == 'unreliable_source' %}{{ _('fonte poco affidabile') }}{% else %}{{ _('senza motivo') }}{% endif %}{% endmacro %}
{% if tab == 'auto' and numbers and caller.can('owner') %}
{% set n = numbers %}{% set a = numbers.auto %}{% set day = numbers.auto_today %}{% set last = numbers.auto_last %}
<section class="card pad" aria-labelledby="h-auto" id="h-auto">
  <div class="row" style="justify-content: space-between; align-items: center;">
    <h2 id="h-auto">{{ _('Redazione automatica') }}</h2>
    {% if a.enabled %}
    <div class="row" style="align-items: center; gap: 8px;">
      <span class="chip green">{{ _('Accesa') }}</span>
      <form class="inline" method="post" action="/ui/sites/{{ site.id }}/auto/stop"><button class="btn" type="submit">{{ _('Ferma subito') }}</button></form>
    </div>
    {% else %}
    <div class="row" style="align-items: center; gap: 8px;">
      <span class="chip">{{ _('Spenta') }}</span>
      {% if numbers.auto_allowed %}<button class="btn pri" type="submit" form="auto-rules" name="enabled" value="1" title="{{ _('Salva le regole qui sotto e accende la redazione automatica.') }}">{{ _('Accendi con queste regole') }}</button>{% endif %}
    </div>
    {% endif %}
  </div>
  {% if not a.enabled %}<p class="lead">{{ _("Il sito scrive e pubblica da solo: ogni ora sceglie le notizie migliori che rispettano le tue regole, scrive l'articolo con le fonti, fa la copertina, lo fa rileggere a un caporedattore AI e lo pubblica. Ogni articolo dice che è scritto dall'intelligenza artificiale senza revisione umana, come chiede l'AI Act.") }}</p>{% endif %}
  {% if a.enabled %}
  <p class="hint" id="auto-last"><strong>{{ _('Ultimo giro') }}</strong>{% if last %} {{ when(last.at, 'time') }}{% endif %}:
  {% if not last %}{{ _('non ancora fatto: parte al prossimo giro orario.') }}
  {% elif last.waiting == 'plan' %}{{ _('fermo, il piano della redazione non comprende la redazione automatica.') }}
  {% elif last.waiting == 'month' %}{{ _('fermo, finiti gli articoli del mese del piano: riparte il mese prossimo, oppure chiedi più articoli.') }}
  {% elif last.waiting == 'hours' %}{{ _('fuori orario, riparte alle {h}.', h=a.hours[0]) }}
  {% elif last.done %}{{ _('fatti gli articoli di oggi ({n}).', n=last.done) }}
  {% elif last.tried %}{{ _('fermo per oggi: ha già provato {t} articoli e ne ha tenuti {k}, gli altri non passavano i controlli. Riparte domani.', t=last.tried, k=last.kept) }}
  {% elif last.accepted %}{{ _('ha scelto {n} proposte, le scrive e le pubblica.', n=last.accepted|length) }}
  {% else %}{{ _('nessuna proposta adatta in quest\'ora: servono opportunità almeno {o} e una notizia non già raccontata. Riprova al prossimo giro.', o=(a.min_opportunity * 0.5)|int) }}{% endif %}</p>
  {% endif %}
  {% if day['items'] %}
  <p class="hint">{{ _('Oggi: {p} pubblicati, {d} scartati, {h} fermati per te.', p=day.published, d=day.discarded, h=day.held) }} <a href="/publications">{{ _('Vedi gli articoli') }}</a></p>
  {% endif %}
</section>

<section class="card pad" aria-labelledby="h-rules">
  <h2 id="h-rules">{{ _('Regole') }}</h2>
  <form method="post" action="/ui/sites/{{ site.id }}/auto" id="auto-rules" style="display: flex; flex-direction: column; gap: 12px;">
    <label class="field">{{ _('Contesto: di cosa parla il sito, per chi, con quale obiettivo') }}<textarea name="brief" rows="4" maxlength="4000" placeholder="{{ _('Es.: notizie dal mondo per lettori italiani curiosi; obiettivo: più lettori possibili, titoli che invogliano senza ingannare.') }}">{{ a.brief }}</textarea></label>
    <label class="field">{{ _('Rubriche, una per riga') }}<textarea name="sections" rows="4">{{ a.sections|join('\n') }}</textarea></label>
    <label class="field">{{ _('Direttive: come scrivere, cosa preferire') }}<textarea name="directives" rows="3" maxlength="4000">{{ a.directives }}</textarea></label>
    <label class="field">{{ _('Argomenti da non trattare mai, separati da virgola') }}<input name="avoid" value="{{ a.avoid|join(', ') }}"></label>
    <div class="form-stack" style="max-width: none; margin: 4px 0;">
      <fieldset class="group">
        <legend>{{ _('Quanti articoli') }}</legend>
        <div class="row fields top">
          <label class="field">{{ _('Articoli al giorno') }}<input name="per_day" type="number" min="1" max="48" value="{{ a.per_day }}"><span class="hint">{{ _('pubblicati; gli scartati si sostituiscono') }}</span></label>
          <label class="field">{{ _('Al mattino (%)') }}<input name="morning_share" type="number" min="0" max="100" value="{{ a.morning_share }}"><span class="hint">{{ _('quanti escono alla prima ora') }}</span></label>
          <label class="field">{{ _('Anticipi dal giorno dopo') }}<input name="borrow" type="number" min="0" max="20" value="{{ a.borrow }}"><span class="hint">{{ _('per una notizia forte a giornata finita; gratis') }}</span></label>
          <label class="field">{{ _('Extra con i crediti') }}<input name="extra_credits" type="number" min="0" max="20" value="{{ a.extra_credits }}"><span class="hint">{{ _('in più al giorno, pagati con i crediti; 0 = mai') }}</span></label>
          <label class="field">{{ _('Opportunità minima per gli extra') }}<input name="extra_min_opportunity" type="number" min="0" max="100" value="{{ a.extra_min_opportunity|int }}"><span class="hint">{{ _('solo notizie molto forti escono oltre il giorno') }}</span></label>
        </div>
      </fieldset>
      <fieldset class="group">
        <legend>{{ _('Quali notizie') }}</legend>
        <div class="row fields top">
          <label class="field">{{ _('Opportunità minima') }}<input name="min_opportunity" type="number" min="0" max="100" value="{{ a.min_opportunity|int }}"><span class="hint">{{ _('su 100: quanto la notizia conviene al sito') }}</span></label>
          <label class="field">{{ _('Testate sullo stesso fatto') }}<input name="min_sources" type="number" min="1" max="3" value="{{ a.min_sources }}"><span class="hint">{{ _('prima queste; se mancano, le notizie migliori con meno testate') }}</span></label>
          <label class="field">{{ _('Massimo per paese straniero (%)') }}<input name="country_share" type="number" min="0" max="100" value="{{ a.country_share }}"><span class="hint">{{ _('degli articoli del giorno sullo stesso paese, per esempio gli Stati Uniti; 0 = nessun limite') }}</span></label>
          <label class="field">{{ _('Paese del sito') }}<input name="home_country" maxlength="2" size="3" placeholder="{{ numbers.home_country }}" value="{{ a.home_country }}" style="width: 5em; text-transform: uppercase;"><span class="hint">{{ _('sigla di due lettere, senza limite; vuoto = dalla lingua del sito') }}</span></label>
          <label class="field">{{ _('Massimo per rubrica (%)') }}<input name="section_share" type="number" min="0" max="100" value="{{ a.section_share }}"><span class="hint">{{ _('degli articoli del giorno nella stessa rubrica, se il sito ne ha più di una; 0 = nessun limite') }}</span></label>
        </div>
      </fieldset>
      <fieldset class="group">
        <legend>{{ _('Quando e dove') }}</legend>
        <div class="row fields">
          <label class="field">{{ _('Dalle ore') }}<input name="start" type="number" min="0" max="23" value="{{ a.hours[0] }}"></label>
          <label class="field">{{ _('Alle ore') }}<input name="end" type="number" min="1" max="24" value="{{ a.hours[1] }}"></label>
          <label class="field">{{ _('Destinazione') }}<select name="target_id"><option value="">{{ _('La prima adatta') }}</option>{% for x in numbers.auto_targets %}<option value="{{ x.id }}" {% if a.target_id == x.id %}selected{% endif %}>{{ x.name }} ({{ x.kind }})</option>{% endfor %}</select></label>
          <label class="field">{{ _('Lingua del sito') }}<select name="language">{% for k in ['it', 'en', 'de', 'fr', 'es'] %}<option value="{{ k }}" {% if (own_language or site.language or 'it')[:2] == k %}selected{% endif %}>{{ k|langname }}</option>{% endfor %}</select></label>
        </div>
      </fieldset>
    </div>
    {% set am = numbers.auto_month %}
    {% if am %}
    {% if am.mine and am.month > am.limit %}
    <p class="notice amber" role="note">{{ _('{n} articoli al giorno qui', n=am.mine) }}{% if am.others %}{{ _(' e {n} negli altri siti', n=am.others) }}{% endif %} {{ _('fanno circa {month} articoli in 30 giorni, ma il piano ne ha {limit} al mese per tutta la redazione, traduzioni comprese. Questo mese ne restano {left}: bastano per circa {days} giorni.', month=am.month, limit=am.limit, left=am.left, days=am.days) }} {{ _('Poi gli articoli si pagano con i crediti, finché ci sono.') if am.credits else _('Poi la redazione automatica si ferma fino al mese dopo.') }}</p>
    {% elif am.mine %}
    <p class="hint">{{ _('Circa {month} articoli in 30 giorni, con gli altri siti, su {limit} del piano al mese (traduzioni comprese). Questo mese ne restano {left}.', month=am.month, limit=am.limit, left=am.left) }}</p>
    {% else %}
    <p class="hint">{{ _('Il piano ha {limit} articoli al mese per tutta la redazione, traduzioni comprese. Questo mese ne restano {left}.', limit=am.limit, left=am.left) }}</p>
    {% endif %}
    {% endif %}
    <label class="field">{{ _('Se un articolo non passa i controlli o il caporedattore AI') }}<select name="on_problem">
      <option value="fix" {% if a.on_problem != 'hold' %}selected{% endif %}>{{ _('Lo riscrive una volta col modello più forte, poi lo scarta: tutto automatico') }}</option>
      <option value="hold" {% if a.on_problem == 'hold' %}selected{% endif %}>{{ _('Lo ferma e aspetta me') }}</option>
    </select></label>
    <label class="row" style="gap: 6px; align-items: center;"><input type="checkbox" name="credit" value="1" {% if a.credit %}checked{% endif %}> {{ _('Sotto ogni articolo il link a Redazia') }}</label>
    <label class="row" style="gap: 6px; align-items: center;"><input type="checkbox" name="enabled" value="1" {% if a.enabled %}checked{% endif %}> {{ _('Accendi la redazione automatica') }}</label>
    {% if not numbers.auto_allowed %}<p class="hint">{{ _('Il tuo piano non comprende la redazione automatica: le regole restano salvate e partono quando passi a un piano che la comprende.') }} <a href="/plan">{{ _('Vedi i piani') }}</a></p>{% endif %}
    <p class="hint">{{ _("Il caporedattore AI ferma sempre: accuse non confermate contro persone o aziende, privati e minori, consigli medici, legali o finanziari, odio, violenza descritta nei dettagli, voci date per certe, titoli che promettono ciò che l'articolo non dice.") }}</p>
    <div class="row">
      <button class="btn pri" type="submit" name="action" value="save">{{ _('Salva') }}</button>
      <button class="btn" type="submit" name="action" value="profile">{{ _('Crea il profilo dal contesto') }}</button>
      {% if numbers.auto_targets|selectattr('kind', 'equalto', 'wordpress')|list %}<button class="btn" type="submit" name="action" value="menu" title="{{ _('Una categoria per ogni rubrica e una voce per ciascuna nel menu principale del sito. Le categorie le crea anche un editore, i menu li cambia solo un amministratore.') }}">{{ _('Crea categorie e menu su WordPress') }}</button>{% endif %}
      <span class="hint">{{ _('Per un sito nuovo, senza articoli da leggere: il profilo nasce dal contesto e dalle rubriche, poi lo approvi.') }}</span>
    </div>
  </form>
</section>

{% if n.per_day is not none %}
<section class="card pad" aria-labelledby="h-write">
  <h2 id="h-write">{{ _('Come scrive il sito') }}</h2>
  <div class="settings-grid">
    <form method="post" action="/ui/sites/{{ site.id }}/per-day">
      <label for="pd">{{ _('Proposte al giorno') }}</label>
      <div class="row"><input id="pd" name="n" type="number" min="0" max="50" value="{{ n.per_day }}" style="width: 5em;"><button class="btn" type="submit">{{ _('Salva') }}</button></div>
      <p class="hint">{% if n.auto.enabled %}{{ _('Sono le proposte del mattino per chi decide a mano. Con la redazione automatica accesa ne prepara da sola quante servono per i suoi {n} articoli al giorno.', n=n.auto.per_day) }}{% else %}{{ _('Una proposta costa una chiamata al modello; si scrive solo ciò che accetti.') }}{% endif %}</p>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/cover">
      <label for="cv">{{ _('Copertine') }}</label>
      <div class="row">
        <select id="cv" name="style" aria-label="{{ _('Stile delle copertine') }}">
          <option value="impact" {% if n.cover_style == 'impact' %}selected{% endif %}>{{ _("D'impatto: fatte per farsi cliccare") }}</option>
          <option value="editorial" {% if n.cover_style == 'editorial' %}selected{% endif %}>{{ _('Editoriali: foto di cronaca sobria') }}</option>
        </select>
        <button class="btn" type="submit">{{ _('Salva') }}</button>
      </div>
      <label class="row" style="gap: 4px; align-items: center;"><input type="checkbox" name="text" value="1" {% if n.cover_text %}checked{% endif %}> {{ _("con un titolo di 2-4 parole nell'immagine") }}</label>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/content-mode">
      <label for="cm">{{ _('Tipo di contenuti') }}</label>
      <div class="row">
        <select id="cm" name="mode">
          <option value="news" {% if n.content_mode == 'news' %}selected{% endif %}>{{ _('Notizie del giorno') }}</option>
          <option value="evergreen" {% if n.content_mode == 'evergreen' %}selected{% endif %}>{{ _('Contenuti senza scadenza: guide e approfondimenti') }}</option>
          <option value="mixed" {% if n.content_mode == 'mixed' %}selected{% endif %}>{{ _('Misto') }}</option>
        </select>
        <button class="btn" type="submit">{{ _('Salva') }}</button>
      </div>
      <label class="row" style="gap: 6px; align-items: center;">{{ _('Nel misto, senza scadenza') }} <input name="share" type="number" min="0" max="100" value="{{ n.evergreen_share }}" style="width: 5em;" aria-label="{{ _('Percentuale di contenuti senza scadenza') }}"> %</label>
      <p class="hint">{{ _('Senza scadenza: articoli sui temi del profilo che il sito tratta poco, sulle ricerche Google senza una tua pagina e sui temi del mese. Si scrivono dalle fonti delle ultime settimane: un tema senza almeno due fonti non viene proposto.') }}</p>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/sources-style">
      <label for="ss">{{ _('Fonti negli articoli pubblicati') }}</label>
      <div class="row">
        <select id="ss" name="style">
          <option value="list" {% if n.sources_style == 'list' %}selected{% endif %}>{{ _('Discrete: una riga in fondo, testo pulito') }}</option>
          <option value="notes" {% if n.sources_style == 'notes' %}selected{% endif %}>{{ _('Note: un numero dopo ogni frase') }}</option>
          <option value="none" {% if n.sources_style == 'none' %}selected{% endif %}>{{ _('Nessuna: le fonti restano solo in Redazia') }}</option>
        </select>
        <button class="btn" type="submit">{{ _('Salva') }}</button>
      </div>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/analysis">
      <label for="an">{{ _('Analisi negli articoli') }}</label>
      <div class="row">
        <select id="an" name="on">
          <option value="1" {% if n.auto.analysis %}selected{% endif %}>{{ _('Sì: in fondo «Cosa cambia», che collega e pesa i fatti') }}</option>
          <option value="0" {% if not n.auto.analysis %}selected{% endif %}>{{ _('No: solo i fatti') }}</option>
        </select>
        <button class="btn" type="submit">{{ _('Salva') }}</button>
      </div>
      <p class="hint">{{ _('Collegamenti e commento si reggono solo sui fatti delle fonti: niente numeri, cause o previsioni nuove. Il caporedattore AI toglie le frasi che non lo rispettano.') }}</p>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/breaking">
      <label>{{ _('Breaking news') }}</label>
      <label class="row" style="gap: 6px; align-items: center;"><input type="checkbox" name="on" value="1" {% if n.auto.breaking %}checked{% endif %}> {{ _('Una notizia che molte testate danno insieme esce comunque') }}</label>
      <div class="row">
        <label class="field">{{ _('Testate almeno') }}<input name="outlets" type="number" min="2" max="10" value="{{ n.auto.breaking_outlets }}" style="width: 5em;"></label>
        <label class="field">{{ _('Entro ore') }}<input name="hours" type="number" min="1" max="12" value="{{ n.auto.breaking_hours }}" style="width: 5em;"></label>
      </div>
      <div class="row"><button class="btn" type="submit">{{ _('Salva') }}</button></div>
      <p class="hint">{{ _('Con la redazione automatica accesa: anche quando gli articoli del giorno sono finiti o fuori orario, una notizia che danno almeno queste testate in queste ore esce lo stesso, dopo il caporedattore AI. Al massimo {n} al giorno; ognuna è un articolo in meno il giorno dopo.', n=3) }}</p>
    </form>
    <form method="post" action="/ui/sites/{{ site.id }}/evening">
      <label>{{ _('Il Punto della Sera') }}</label>
      <label class="row" style="gap: 6px; align-items: center;"><input type="checkbox" name="enabled" value="1" {% if n.evening.enabled %}checked{% endif %}> {{ _("Ogni sera l'analisi della giornata") }}</label>
      <div class="row">
        <label class="field">{{ _('Alle ore') }}<input name="hour" type="number" min="0" max="23" value="{{ n.evening.hour }}" style="width: 5em;"></label>
        <label class="field">{{ _('Se sono usciti almeno') }}<input name="min_articles" type="number" min="2" max="50" value="{{ n.evening.min_articles }}" style="width: 5em;"></label>
      </div>
      <label class="field">{{ _('Rubrica') }}<input name="section" maxlength="80" value="{{ n.evening.section }}" placeholder="{{ n.evening_section }}"></label>
      <div class="row"><button class="btn" type="submit">{{ _('Salva') }}</button></div>
      <p class="hint">{{ _("Il direttore AI legge tutti gli articoli pubblicati nelle 24 ore, sceglie il fatto che pesa di più e scrive un'analisi che ci ruota intorno e collega le altre notizie, con link agli articoli. Con la redazione automatica accesa esce da solo dopo il caporedattore AI, altrimenti lo trovi tra le bozze.") }}</p>
      {% if not n.evening_allowed %}<p class="hint">{{ _('Il tuo piano non comprende il Punto della Sera: le impostazioni restano salvate e partono quando passi a un piano che lo comprende.') }} <a href="/plan">{{ _('Vedi i piani') }}</a></p>{% endif %}
    </form>
  </div>
  {% if n.discards %}
  <p class="hint">{{ _('Perché hai scartato le proposte negli ultimi 30 giorni:') }}
    {% for reason, k in n.discards %}{{ reason_label(reason) }} {{ k }}{% if not loop.last %} · {% endif %}{% endfor %}.
    {{ _('Le prossime proposte ne tengono conto: niente temi già trattati o fuori tema, angoli più precisi, meno peso alle fonti poco affidabili.') }}</p>
  {% endif %}
</section>
{% endif %}
{% endif %}

{% if tab == 'profile' %}
{% with page="site" %}{% include "_help.html.j2" %}{% endwith %}
{% if analysis and analysis.problems %}
<div class="dashed"><strong>{{ _("Note sulla lettura del sito") if analysis.status == 'complete' else _("Perché la lettura del sito è parziale") }}</strong>{% for p in analysis.problems[:6] %}<span class="hint">{{ p|problem }}</span>{% endfor %}</div>
{% endif %}
{% if editing %}
<section class="card pad" aria-labelledby="h-edit">
  <h2 id="h-edit">{{ _('Modifica il profilo') }}</h2>
  <p class="lead">{{ _('Le modifiche diventano una nuova versione in bozza: la linea cambia solo quando la approvi.') }}</p>
  {% if error %}<p class="error">{{ error }}</p>{% endif %}
  <form method="post" action="/ui/sites/{{ site.id }}/profile" style="display: flex; flex-direction: column; gap: 12px;">
    <label class="field">{{ _('Profilo (JSON)') }}<textarea name="body" spellcheck="false">{{ body_json }}</textarea></label>
    <div class="row"><a class="btn" href="/site">{{ _('Annulla') }}</a><button class="btn pri" type="submit">{{ _('Salva come bozza') }}</button></div>
  </form>
</section>
{% elif shown %}
{% set incomplete = not (shown.body.get('sector') or {}).get('value') %}
{% set thin = (shown.body.get('analysis') or {}).get('posts_read', 99) < thin_posts and (shown.body.get('sector') or {}).get('by') != 'brief' %}
<section class="card {% if draft %}drift{% endif %}" aria-labelledby="h-profile">
  <div class="card-head">
    <div style="display: flex; flex-direction: column; gap: 4px;">
      {% if draft and approved %}
      <h2 id="h-profile">{{ _('Proposta di aggiornamento della linea · versione {version}', version=draft.version) }}</h2>
      <span style="font-size: 14px;">{% if draft.origin == 'reanalysis' %}{{ _("Dalla rianalisi del {date}. L'agente propone, la linea cambia solo se approvi.", date=when(draft.created_at, 'day')) }}{% else %}{{ _("Modifica del {date}. L'agente propone, la linea cambia solo se approvi.", date=when(draft.created_at, 'day')) }}{% endif %}</span>
      {% elif draft %}
      <h2 id="h-profile">{{ _('Profilo proposto · versione {version}', version=draft.version) }}</h2>
      <span style="font-size: 14px;">{{ _("Ricostruito dall'analisi del sito: controllalo e approvalo per avviare piano e opportunità.") }}</span>
      {% else %}
      <h2 id="h-profile">{{ _('Profilo approvato · versione {version}', version=approved.version) }}</h2>
      <span class="hint">{{ _('Approvato da {who} il {date}', who=approved.approved_by, date=when(approved.approved_at, 'day')) }}</span>
      {% endif %}
    </div>
    {% if draft and caller.can('owner') %}
    <div class="row">
      {% if approved %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/discard/{{ draft.version }}"><button class="btn" type="submit">{{ _('Mantieni la v{version}', version=approved.version) }}</button></form>{% endif %}
      <a class="btn" href="/site?edit=1">{{ _('Modifica') }}</a>
      {% if thin %}
      <a class="btn pri" href="/site?tab=auto">{{ _('Crea il profilo dal contesto') }}</a>
      {% elif incomplete %}
      <form class="inline" method="post" action="/ui/sites/{{ site.id }}/review"><button class="btn pri" type="submit">{{ _('Rianalizza') }}</button></form>
      <form class="inline" method="post" action="/ui/sites/{{ site.id }}/approve/{{ draft.version }}"><button class="btn" type="submit">{{ _('Approva comunque') }}</button></form>
      {% else %}
      <form class="inline" method="post" action="/ui/sites/{{ site.id }}/approve/{{ draft.version }}"><button class="btn pri" type="submit">{{ _('Approva la v{version}', version=draft.version) }}</button></form>
      {% endif %}
    </div>
    {% endif %}
  </div>

  {% if draft and approved %}
  <div class="pad" style="gap: 10px; border-bottom: 1px solid var(--line);" aria-labelledby="h-cmp">
    <h3 id="h-cmp">{{ _('Cosa cambia rispetto alla v{version} approvata', version=approved.version) }}</h3>
    {% if comparison %}
    <div class="scroll">
      <table style="min-width: 520px;">
        <thead><tr><th>{{ _('Cosa') }}</th><th>{{ _('Oggi (v{version})', version=approved.version) }}</th><th>{{ _('Proposta (v{version})', version=draft.version) }}</th></tr></thead>
        <tbody>
        {% for c in comparison %}
        {% if c.note %}<tr><td colspan="3" class="hint">{{ c.note }}</td></tr>
        {% else %}<tr><td>{{ c.what }}</td><td>{{ c.before }}</td><td><strong>{{ c.after }}</strong></td></tr>{% endif %}
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="hint" style="margin: 0;">{{ _('Nessuna differenza nella linea: la proposta nasce da un modo migliore di leggere il sito.') }}</p>
    {% endif %}
    <p class="hint" style="margin: 0;">{{ _('"Approva" rende attiva la proposta; "Mantieni" la scarta e resta la v{version}. Sotto trovi il profilo proposto per intero.', version=approved.version) }}</p>
  </div>
  {% endif %}

  {% set b = shown.body %}
  {% set subs = (b.get('subtopics') or [])[:4] %}
  {% set st = b.get('settings') or {} %}
  {% set sty = b.get('style') or {} %}
  {% set an = b.get('analysis') or {} %}
  {% set pl = b.get('languages') or {} %}
  <div class="pad" style="gap: 10px; border-bottom: 1px solid var(--line);" aria-labelledby="h-what">
    <h3 id="h-what">{{ _('La linea editoriale di {domain}', domain=site.domain) }}</h3>
    {% set sm = b.get('summary') %}{% if sm is mapping %}{% set sm = sm.get('value') %}{% endif %}
    {% if sm %}
    <p class="lead" style="margin: 0;">{{ sm }}</p>
    {% else %}
    {% set nm = b.get('name') or site.domain %}
    <p class="lead" style="margin: 0;">{% if pl|length > 1 %}{{ _('{name} pubblica in {languages}', name=nm, languages=pl.keys()|map('langname')|join(' ' ~ _('e') ~ ' ')) }}{% elif b.get('language') %}{{ _('{name} pubblica in {languages}', name=nm, languages=b.get('language')|langname) }}{% else %}{{ _('{name} pubblica', name=nm) }}{% endif %}{% if an.get('posts_per_week') %}{{ _(', circa {n} articoli a settimana', n=an.get('posts_per_week')|num) }}{% endif %}{% if sty.get('typical_words') %} {{ _('di circa {n} parole', n=sty.get('typical_words')) }}{% endif %}{% if subs %}{{ _(', soprattutto su {topics}', topics=subs|map(attribute='name')|join(', ')) }}{% endif %}.{% if b.get('site_keywords') %} {{ _('Si presenta con le parole chiave {keywords}.', keywords=b.get('site_keywords')|join(', ')) }}{% endif %}</p>
    {% endif %}
    {% if thin %}
    <p style="margin: 0;"><span class="chip amber">{{ _('Profilo da completare') }}</span> {{ _('Il sito ha ancora pochi articoli da leggere: questo profilo è ricavato dalla home e dalle rubriche e non basta per proposte e articoli su misura. Scrivi il contesto in &quot;Redazione automatica&quot; qui sotto e premi &quot;Crea il profilo dal contesto&quot;.') }}</p>
    {% elif incomplete %}
    <p class="error" style="margin: 0;">{{ _("Questa descrizione è parziale: il modello non ha completato l'analisi, quindi settore, pubblico e stile mancano (il motivo è in &quot;Non determinato&quot;). Riprovo da solo entro un'ora; puoi anche rianalizzare subito, oppure completarli tu con &quot;Modifica&quot; prima di approvare.") }}</p>
    {% endif %}
    {% if draft %}
    <p class="hint" style="margin: 0;">{{ _("Approvare vuol dire: &quot;questa è la mia linea&quot;. Da qui l'agente:") }}</p>
    <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px;">
      <li>{{ _('<strong>cerca le fonti</strong> che scrivono di {topics}, in tre modi: le testate che gli articoli del sito già citano, ricerche con le parole chiave dei temi (Hacker News, GitHub, Hugging Face, arXiv) e le testate che il modello indica per questi temi. Ogni fonte è letta e valutata prima di essere usata; in Fonti vedi da dove arriva ciascuna;', topics=subs|map(attribute='name')|join(', ') if subs else _('questi temi')) }}</li>
      <li>{{ _('<strong>raccoglie le notizie</strong> ogni ora e tiene quelle vicine ai temi (pertinenza almeno {pct}%)', pct=((st.get('min_relevance', 0.15)) * 100)|round|int) }}{% if st.get('exclude') %}{{ _(', scartando {terms}', terms=st.get('exclude')|join(', ')) }}{% endif %};</li>
      <li>{{ _("<strong>misura i trend</strong> con due punteggi separati: Hype, quanto se ne parla in giro, e Opportunità, quanto il tema è vicino al sito e quanto non l'avete già coperto;") }}</li>
      <li>{{ _('<strong>propone {n} articoli al giorno</strong> nel piano, con le fonti: la mattina e poi ogni tre ore fino alle 20, per i posti ancora liberi, finché non ne hai scritti {n}; decidi tu quali scrivere;', n=st.get('proposals_per_day', 6)) }}</li>
      <li>{{ _('<strong>scrive le bozze</strong> in {language}', language=(b.get('language')|langname) or _('lingua del sito')) }}{% if sty.get('tone') %}{{ _(', tono {tone}', tone=sty.get('tone')) }}{% endif %}{% if sty.get('typical_words') %}{{ _(', circa {n} parole', n=sty.get('typical_words')) }}{% endif %}{{ _(', con le fonti citate. Nulla si pubblica senza il tuo sì.') }}</li>
    </ul>
    {% endif %}
    {% if b.get('read_at') %}<p class="hint" style="margin: 0;">{{ _('{domain} porta a {target}: è stato letto quel sito.', domain=site.domain, target=b.get('read_at')) }}</p>{% endif %}
  </div>

  <div class="pad" style="flex-direction: row; flex-wrap: wrap; gap: 32px;">
    <div style="flex: 3 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span class="label-up">{{ _('Settore') }}</span>
        {% set old_sector = (approved.body.get('sector') or {}).get('value') if (approved and draft) else none %}
        {% set new_sector = (shown.body.get('sector') or {}).get('value') %}
        <div class="row" style="font-size: 16px; gap: 10px;">
          {% if old_sector and old_sector != new_sector %}<span style="text-decoration: line-through; color: var(--muted);">{{ old_sector }}</span><span aria-hidden="true" class="flat">→</span>{% endif %}
          <strong>{{ new_sector or _('Non determinato') }}</strong>
        </div>
      </div>

      <div style="display: flex; flex-direction: column;">
        <span class="label-up" style="padding-bottom: 6px;">{% if draft and approved %}{{ _("Temi · quota degli articoli letti che ne parlano, con articoli d'esempio") }}{% else %}{{ _('Temi che segue') }}{% endif %}</span>
        {% if draft and approved %}
        <div class="share head-row"><span>{{ _('Tema') }}</span><span>{% if draft and approved %}v{{ approved.version }}{% endif %}</span><span>{% if draft and approved %}v{{ draft.version }}{% else %}{{ _('Quota') }}{% endif %}</span><span>{% if draft and approved %}{{ _('Andamento') }}{% endif %}</span></div>
        {% for r in rows if r.current or not comparison %}
        <div class="share">
          <span>{{ r.name }}{% if r.fresh %} <span class="chip blue">{{ _('nuova') }}</span>{% endif %}
            {% if r.keywords %}<small class="hint" style="display: block;">{{ _('parole chiave: {keywords}', keywords=r.keywords|join(', ')) }}</small>{% endif %}
            {% for e in r.examples %}<small style="display: block;"><a href="{{ e.url }}" rel="noopener noreferrer" target="_blank">{{ e.title }}</a></small>{% endfor %}
            {% if r.current and caller.can('owner') %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/topics/remove"><input type="hidden" name="name" value="{{ r.name }}"><button class="btn" type="submit" style="margin-top: 4px; padding: 2px 10px; font-size: 12px;" title="{{ _('Non seguire più questo tema, anche nelle prossime analisi') }}">{{ _('Togli il tema') }}</button></form>{% endif %}
          </span>
          <span class="num">{% if r.old is not none %}{{ (100 * r.old)|round|int }}%{% endif %}</span>
          <span class="num">{{ (100 * r.new)|round|int }}%</span>
          <div class="row" style="flex-wrap: nowrap;">
            <div class="bar" style="flex: 1;"><i class="ink" style="width: {{ (100 * r.new)|round|int }}%"></i></div>
            <span class="{% if r.delta is not none %}{{ 'up' if r.delta > 0 else ('down' if r.delta < 0 else 'flat') }}{% endif %}" style="font-size: 12px; min-width: 28px;">{% if r.delta is not none %}{{ '+' if r.delta > 0 }}{{ r.delta }}{% endif %}</span>
          </div>
        </div>
        {% endfor %}
        {% else %}
        <div class="topic-list">
          {% for r in rows if r.current %}
          <div class="topic">
            <span><strong>{{ r.name }}</strong>{% if r.keywords %} <small class="hint">{{ r.keywords|join(', ') }}</small>{% endif %}</span>
            {% if caller.can('owner') %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/topics/remove"><input type="hidden" name="name" value="{{ r.name }}"><button class="btn sm" type="submit" title="{{ _('Non seguire più questo tema, anche nelle prossime analisi') }}">{{ _('Togli il tema') }}</button></form>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {% set removed = (shown.body.get('settings') or {}).get('removed') or [] %}
      {% if removed %}
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span class="label-up">{{ _("Temi tolti · non vengono seguiti, anche se l'analisi li ritrova") }}</span>
        <div class="row">{% for x in removed %}<span class="chip">{{ x.name }}</span>{% if caller.can('owner') %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/topics/restore"><input type="hidden" name="name" value="{{ x.name }}"><button class="btn" type="submit" style="padding: 2px 10px; font-size: 12px;">{{ _('Rimetti') }}</button></form>{% endif %}{% endfor %}</div>
      </div>
      {% endif %}

      <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); align-items: start;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <span class="label-up">{{ _('Pubblico') }}</span>
          <span>{{ (shown.body.get('audience') or {}).get('value') or _('Non determinato') }}</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <span class="label-up">{{ _('Stile') }}</span>
          {% set style = shown.body.get('style') or {} %}
          <span>{{ style.get('tone') or _('Tono non determinato') }}{% if style.get('formats') %} · {{ style.get('formats')|join(', ') }}{% endif %}</span>
        </div>
      </div>
    </div>

    {% if evidence or shown.body.get('gaps') %}
    <aside style="flex: 2 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px;" aria-labelledby="h-ev">
      {% if evidence %}<h3 id="h-ev">{{ _('Prove · {n} pagine del sito', n=evidence|length) }}</h3>
      <p class="hint">{{ _('Ogni affermazione del modello è legata a pagine lette. Quelle senza prova vengono scartate.') }}</p>{% endif %}
      <ol class="evlist">
        {% for e in evidence[:6] %}
        <li><a href="{{ e.url }}" rel="noopener noreferrer" target="_blank">{{ e.url|replace('https://', '')|replace('http://', '') }}</a>{% if e.label %}<small>{{ e.label }}</small>{% endif %}</li>
        {% endfor %}
      </ol>
      {% if evidence|length > 6 %}<span class="hint">{{ _('e altre {n}', n=evidence|length - 6) }}</span>{% endif %}
      {% if shown.body.get('gaps') %}
      <div class="dashed">
        <strong>{{ _('Non determinato') }}</strong>
        {% for g in shown.body.get('gaps')[:6] %}<span class="hint">{{ g|problem }}</span>{% endfor %}
      </div>
      {% endif %}
    </aside>
    {% endif %}
  </div>
</section>
{% else %}
<section class="card pad" aria-labelledby="h-prep">
  {% set ps = (prep or {}).get('state') %}
  {% if ps == 'failed' %}
  <h2 id="h-prep">{{ _('Profilo non creato') }}</h2>
  <p class="error" style="margin: 0;">{{ _("L'analisi del sito non è riuscita: {why}", why=(prep.error or _('motivo non registrato'))|problem) }}</p>
  <p class="hint">{{ _("Rianalizza quando il sito risponde. Se ha pochi articoli, scrivi tu di cosa parla in Redazione automatica › Crea il profilo dal contesto.") }}</p>
  {% elif ps == 'running' %}
  <h2 id="h-prep">{{ _('Profilo in preparazione') }}</h2>
  <p class="lead">{{ _('Analisi in corso') }}{% if prep.step %}: {{ prep.step }}{% endif %}. {{ _('Di solito bastano pochi minuti: la pagina si aggiorna da sola a fine lavoro.') }}</p>
  {% elif ps == 'queued' %}
  <h2 id="h-prep">{{ _('Profilo in preparazione') }}</h2>
  <p class="lead">{{ _("Analisi in coda: parte appena finiscono i lavori già avviati (due alla volta per redazione).") }}</p>
  {% elif ps == 'done' %}
  <h2 id="h-prep">{{ _('Profilo non creato') }}</h2>
  <p class="lead">{{ _("L'analisi è finita senza un profilo: il sito ha troppo poco da leggere. Scrivi tu di cosa parla in Redazione automatica › Crea il profilo dal contesto, oppure rianalizza dopo aver pubblicato qualche articolo.") }}</p>
  {% else %}
  <h2 id="h-prep">{{ _('Profilo da creare') }}</h2>
  <p class="lead">{{ _("Nessuna analisi avviata per questo sito. Avviala qui: legge fino a 25 articoli e ne ricava settore, pubblico, temi e tono.") }}</p>
  {% endif %}
  {% if caller.can('owner') and ps not in ('running', 'queued') %}
  <div class="row">
    <form class="inline" method="post" action="/ui/sites/{{ site.id }}/review"><button class="btn pri" type="submit">{{ _('Analizza il sito') if ps == 'none' else _('Rianalizza ora') }}</button></form>
    <a class="btn" href="/site?tab=auto#h-rules">{{ _('Crea il profilo dal contesto') }}</a>
  </div>
  {% endif %}
</section>
{% endif %}
{% endif %}
{% if tab == 'publish' %}
<section class="card pad" id="h-languages">
  <h2>{{ _('Lingue degli articoli') }}</h2>
  <p class="hint">{{ _("Gli articoli si scrivono nella lingua del sito ({language}). Scegli in quali altre lingue tradurli: quando approvi un articolo, l'agente scrive una traduzione per ogni lingua, con le stesse fonti e gli stessi controlli, da approvare a parte. Le traduzioni nelle lingue scelte qui sono comprese: l'articolo conta uno solo nel piano, in tutte le lingue.", language=langs.get(own_language, own_language or '?')) }}{% if max_languages %} {{ _('Il tuo piano permette {n} lingue per sito, compresa la sua.', n=max_languages) }}{% endif %}</p>
  {% if caller.can('owner') %}
  <form method="post" action="/ui/sites/{{ site.id }}/languages" class="row" style="gap: 14px; align-items: center;">
    {% for code, name in langs.items() if code != own_language %}
    <label class="row" style="gap: 6px;"><input type="checkbox" name="languages" value="{{ code }}" {% if code in site_langs %}checked{% endif %}>{{ name }}</label>
    {% endfor %}
    <button class="btn" type="submit">{{ _('Salva') }}</button>
  </form>
  {% else %}
  <p>{{ site_langs|map('extract', langs)|join(', ') or _('Solo la lingua del sito.') }}</p>
  {% endif %}
  {% if lang_offer %}
  <h3 style="margin-top: 18px;">{{ _('Lingue extra') }}</h3>
  <p class="hint">{{ _("Il piano dà {n} lingue per sito, compresa la sua. Ogni lingua in più per questo sito costa {month} al mese o {year} all'anno, IVA esclusa, e si rinnova con il piano.", n=plan_languages, month=lang_offer.month_s, year=lang_offer.year_s) }}{% if lang_offer.extra %} {{ _('Questo sito ne ha {n} in più: può avere {total} lingue.', n=lang_offer.extra, total=max_languages) }}{% endif %}</p>
  <div class="row" style="gap: 10px; align-items: center;">
    {% if lang_offer.ok %}
    <form class="inline" method="post" action="/account/{{ lang_offer.tenant_id }}/language"><input type="hidden" name="site_id" value="{{ site.id }}"><input type="hidden" name="back" value="site"><button class="btn" type="submit">+ {{ _('Aggiungi una lingua') }}</button></form>
    <span class="hint">{{ _('Oggi paghi {amount}, IVA compresa, per il resto del periodo già pagato, poi la lingua si rinnova con il piano sulla stessa carta.', amount=lang_offer.now_s) if lang_offer.vat else _('Oggi paghi {amount} per il resto del periodo già pagato, poi la lingua si rinnova con il piano sulla stessa carta.', amount=lang_offer.now_s) }}</span>
    {% else %}
    <span class="hint">{{ _('Per ora non si può comprare online: {why}.', why=lang_offer.why) }}</span>
    {% endif %}
    {% if lang_offer.extra %}
    <form class="inline" method="post" action="/account/{{ lang_offer.tenant_id }}/language/remove"><input type="hidden" name="site_id" value="{{ site.id }}"><input type="hidden" name="back" value="site"><button class="btn ghost sm" type="submit">{{ _('Togli una lingua extra') }}</button></form>
    {% endif %}
  </div>
  {% endif %}
</section>

{% if gsc and (gsc.configured or gsc.property or caller.operator) %}
<section class="card pad" id="h-gsc">
  <h2 id="h-gsc-t">{{ _('Google Search Console') }}</h2>
  <p class="hint">{{ _('Collegando Search Console la redazione vede cosa cerca la gente su Google per arrivare al sito e quali articoli cliccano: i temi più cercati salgono nelle proposte e i numeri arrivano nel rapporto del lunedì.') }}</p>
  {% if gsc.property %}
  <div class="list-row"><span>{{ _('Proprietà') }}</span><span class="num">{{ gsc.property }}</span></div>
  <div class="list-row"><span>{{ _('Stato') }}</span><span>{% if gsc.status == 'ok' %}<span class="chip green">{{ _('Collegata') }}</span>{% elif gsc.problem %}<span class="chip amber">{{ _('Da sistemare') }}</span> <small>{{ _(gsc.problem) }}</small>{% else %}<span class="chip">{{ _('In attesa della chiave del server') }}</span>{% endif %}{% if gsc.checked %} <small class="hint">{{ _('controllata il {when}', when=when(gsc.checked)) }}</small>{% endif %}</span></div>
  {% if gsc.data %}
  <section class="kpis" aria-label="{{ _('Ultimi 28 giorni') }}" style="margin-top: 12px;">
    <div class="card kpi"><span class="label">{{ _('Clic in 28 giorni') }}</span><span class="value">{{ gsc.data.totals.clicks|num }}</span></div>
    <div class="card kpi"><span class="label">{{ _('Impressioni') }}</span><span class="value">{{ gsc.data.totals.impressions|num }}</span></div>
    <div class="card kpi"><span class="label">{{ _('Posizione media') }}</span><span class="value">{{ gsc.data.totals.position or '–' }}</span></div>
  </section>
  <div class="cols">
    <div class="col-wide">
      <h3>{{ _('Le pagine più cliccate') }}</h3>
      {% for x in gsc.data.pages %}<div class="list-row"><a href="{{ x.key }}" target="_blank" rel="noopener" style="overflow-wrap: anywhere;">{{ x.key|replace('https://', '')|replace('http://', '') }}</a><span class="num">{{ x.clicks|num }}</span></div>{% endfor %}
    </div>
    <div class="col-side">
      <h3>{{ _('Le ricerche che portano più visite') }}</h3>
      {% for x in gsc.data.queries %}<div class="list-row"><span>{{ x.key }}</span><span class="num">{{ x.clicks|num }}</span></div>{% endfor %}
    </div>
  </div>
  {% elif gsc.status == 'ok' %}
  <p class="hint">{{ _('Nessun dato ancora: Google completa i numeri in due o tre giorni.') }}</p>
  {% endif %}
  {% endif %}
  {% if caller.can('owner') %}
  {% if not gsc.configured %}
  <p class="hint">{{ _('Manca la chiave di Google sul server (EDITOR_GSC_KEY).') }}</p>
  {% else %}
  <details class="act" {% if not gsc.property %}open{% endif %} data-tone="teal">
    <summary><span class="ico" aria-hidden="true">G</span>{{ _('Collega o cambia la proprietà') if gsc.property else _('Collega Search Console') }}<span class="sub">{{ _('due minuti, senza password') }}</span></summary>
    <ol>
      <li>{{ _('Apri <a href="https://search.google.com/search-console" target="_blank" rel="noopener">Search Console</a>, scegli la proprietà del sito e vai in Impostazioni › Utenti e autorizzazioni.') }}</li>
      <li>{{ _('Aggiungi come utente questo indirizzo con autorizzazione Limitata:') }} <input readonly value="{{ gsc.email }}" onclick="this.select()" style="width: 100%; max-width: 520px;"></li>
      <li>{{ _('Scrivi qui sotto la proprietà: sc-domain:dominio per una proprietà di dominio, oppure l\'indirizzo completo (https://…/) per un prefisso URL.') }}</li>
    </ol>
    <form method="post" action="/ui/sites/{{ site.id }}/search-console" class="form-grid">
      <label class="field">{{ _('Proprietà') }}<input name="prop" value="{{ gsc.property or gsc.suggest }}" required></label>
      <div><button class="btn pri" type="submit">{{ _('Salva e controlla') }}</button></div>
    </form>
    <p class="hint">{{ _("L'accesso si toglie quando vuoi da Search Console. Redazia legge solo i numeri, non cambia nulla.") }}</p>
  </details>
  {% if gsc.property %}
  <div class="row" style="margin-top: 10px;">
    <form class="inline" method="post" action="/ui/sites/{{ site.id }}/search-console/sync"><button class="btn sm" type="submit">{{ _('Aggiorna adesso') }}</button></form>
    <form class="inline" method="post" action="/ui/sites/{{ site.id }}/search-console" onsubmit='return confirm({{ _("Scollegare Search Console? I dati già letti vengono cancellati.")|string|tojson }})'><input type="hidden" name="prop" value=""><button class="btn sm danger" type="submit">{{ _('Scollega') }}</button></form>
  </div>
  {% endif %}
  {% endif %}
  {% endif %}
</section>
{% endif %}
<section class="card pad" id="h-delivery">
  <h2>{{ _('Feed per altri strumenti') }}</h2>
  <p class="hint">{{ _('Per Zapier, Make, n8n o un sito che importa un feed: contiene gli ultimi 50 articoli approvati, con testo, immagine e campi per Google. Il sito vero si collega da <a href="/publications">Pubblicazioni</a>.') }}</p>
  {% if feed_token %}
  <label class="field">{{ _('Feed JSON (consigliato per Zapier, Make e n8n)') }}<input readonly value="{{ feed_base }}/feeds/{{ feed_token }}.json" onclick="this.select()"></label>
  <label class="field">{{ _('Feed RSS') }}<input readonly value="{{ feed_base }}/feeds/{{ feed_token }}.rss" onclick="this.select()"></label>
  <p class="hint">{{ _('Per una sola lingua aggiungi ?lang= e il codice, per esempio ?lang=en. Chi conosce l\'indirizzo legge gli articoli approvati: non pubblicarlo.') }}</p>
  {% if caller.can('owner') %}
  <form class="inline" method="post" action="/ui/sites/{{ site.id }}/feed" onsubmit='return confirm({{ _("Cambiare gli indirizzi? Quelli vecchi smettono di funzionare.")|string|tojson }})'><input type="hidden" name="renew" value="1"><button class="btn sm" type="submit">{{ _('Cambia gli indirizzi') }}</button></form>
  {% endif %}
  {% elif caller.can('owner') %}
  <form class="inline" method="post" action="/ui/sites/{{ site.id }}/feed"><button class="btn" type="submit">{{ _('Crea il feed') }}</button></form>
  {% endif %}
</section>
{% endif %}

{% if tab == 'site' and caller.can('owner') %}
<section class="card pad" id="h-site-data">
  <h2>{{ _('Dati del sito') }}</h2>
  <form method="post" action="/ui/sites/{{ site.id }}/edit" class="form-grid">
    <label class="field">{{ _('Nome') }}<input name="name" value="{{ site.name }}" maxlength="100"></label>
    {% if domain_free %}
    <label class="field">{{ _('Dominio') }}<input name="domain" value="{{ site.domain }}" required></label>
    {% endif %}
    <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
  </form>
  <p class="hint">{% if domain_free %}{{ _("Hai sbagliato a scrivere il dominio? Correggilo qui: finché il profilo non è approvato, il sito riparte da capo con l'analisi del dominio giusto.") }}{% else %}{{ _('Il profilo è approvato: per passare a un altro dominio elimina il sito e aggiungi quello giusto.') }}{% endif %}</p>
</section>
{% if profiles %}
<section class="card pad">
  <h2 id="h-ver">{{ _('Versioni del profilo') }}</h2>
  <div class="scroll">
    <table style="min-width: 560px;">
      <thead><tr><th>{{ _('Versione') }}</th><th>{{ _('Origine') }}</th><th>{{ _('Stato') }}</th><th>{{ _('Decisione') }}</th>{% if caller.can('owner') %}<th></th>{% endif %}</tr></thead>
      <tbody>
      {% for p in profiles %}
      <tr>
        <td class="num">v{{ p.version }}</td>
        <td>{{ {'analysis': _('Prima analisi'), 'reanalysis': _('Rianalisi periodica'), 'manual': _('Modifica manuale')}.get(p.origin, p.origin) }}</td>
        <td>{% if p.status == 'approved' %}<span class="chip green">{{ _('Approvata') }}</span>{% elif p.status == 'draft' %}<span class="chip amber">{{ _('In attesa') }}</span>{% else %}<span class="chip">{{ _('Ritirata') }}</span>{% endif %}</td>
        <td>{% if p.approved_by %}{{ p.approved_by }} · {{ when(p.approved_at, 'day') }}{% else %}<span class="flat">–</span>{% endif %}</td>
        {% if caller.can('owner') %}<td>{% if p.status != 'approved' %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/versions/{{ p.version }}/delete" onsubmit='return confirm({{ _('Eliminare la v{version}? Non si può annullare.', version=p.version)|string|tojson }})'><button class="btn" type="submit" style="padding: 2px 10px; font-size: 12px;">{{ _('Elimina') }}</button></form>{% endif %}</td>{% endif %}
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% if confirm_delete %}
<section class="card pad" id="h-danger">
  <h2>{{ _('Elimina il sito') }}</h2>
  <p class="hint">{{ _('Si cancellano profilo e versioni, analisi, fonti seguite, proposte, bozze, destinazioni e storico delle pubblicazioni di {domain}. Gli articoli già pubblicati restano sul sito. Non si può annullare.', domain=site.domain) }}</p>
  <form method="post" action="/ui/sites/{{ site.id }}/delete" class="form-grid">
    <label class="field">{{ _('Scrivi {domain} per confermare', domain=site.domain) }}<input name="confirm" autocomplete="off" required></label>
    <div class="row"><a class="btn" href="/site?tab=site">{{ _('Annulla') }}</a><button class="btn danger" type="submit">{{ _('Elimina il sito') }}</button></div>
  </form>
</section>
{% else %}
<p class="hint" style="margin-top: 32px;"><a href="/site?tab=site&delete=1" style="color: var(--muted);">{{ _('Elimina il sito') }}…</a></p>
{% endif %}
{% endif %}
{% endif %}
{% if caller.can('owner') and not site %}
<details class="card pad fold">
  <summary><h2 id="h-add">{{ _('Aggiungi un dominio') }}</h2></summary>
  <form method="post" action="/ui/sites" class="form-grid">
    <label class="field">{{ _('Dominio') }}<input name="domain" placeholder="{{ _('esempio.it') }}" required></label>
    <div><button class="btn" type="submit">{{ _('Analizza il sito') }}</button></div>
  </form>
</details>
{% endif %}
{% endblock %}
