{# What a social video costs now: the plan's videos of the month, then credits. Needs `vstate`. #}
{% set a = vstate.allowance %}
<p class="hint">{% if a.included is not none and a.included > 0 %}{{ _('Video del piano questo mese: {used} su {n}.', used=a.used, n=a.included) }} {% endif %}{% if vstate.price %}{{ _('Un video di {s} secondi costa {n} crediti, solo se riesce (te ne restano {left}); il prezzo di ogni durata è accanto a «Genera il video».', s=vstate.choices[0].seconds if vstate.choices else 10, n=(vstate.choices[0].price if vstate.choices and vstate.choices[0].price else vstate.price), left=vstate.credits.left) }}{% elif vstate.price is none %}{{ _('I video del piano di questo mese sono finiti: ne arrivano altri il mese prossimo, oppure scegli un piano con più video in Il mio piano.') }}{% elif a.included is not none and a.left %}{{ _('Un video si conta solo se riesce.') }}{% endif %}</p>
