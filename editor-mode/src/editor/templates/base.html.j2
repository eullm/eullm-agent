<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Editor Mode{% endblock %} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
{% from "_icons.html.j2" import icon %}
<body>
<div class="shell">
<nav class="nav" aria-label="{{ _('Sezioni') }}">
  <a class="brand" href="/" title="{{ _('Desk') }}"><img class="logo" src="/static/redazia-logo.webp" alt="Redazia" width="111" height="36"></a>
<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="{{ _('Sezioni') }}">
<label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span><span></span><span></span></label>
<div class="nav-body">
  {% if newsrooms|length > 1 %}
  <form method="get" action="/newsroom" class="switch">
    <label for="room-pick">{{ _('Redazione') }}</label>
    <select id="room-pick" name="t" onchange="this.form.submit()">
      {% for x in newsrooms %}<option value="{{ x.tenant_id }}" {% if x.tenant_id == caller.tenant_id %}selected{% endif %}>{{ x.name }}</option>{% endfor %}
      {% if caller.tenant_id not in newsrooms|map(attribute='tenant_id') %}<option value="{{ caller.tenant_id }}" selected>{{ caller.tenant_id }}</option>{% endif %}
    </select>
    <noscript><button class="btn sm" type="submit">{{ _('Vai') }}</button></noscript>
  </form>
  {% endif %}
  {% if caller.can('owner') and sites %}<a href="/settings#h-sites" style="font-size: 12px; padding-top: 0;">{{ _('+ Aggiungi un sito') }}</a>{% endif %}
  {% if sites %}
  <form method="get" action="/switch" class="switch">
    <label for="site-pick">{{ _('Sito') }}</label>
    <select id="site-pick" name="site" onchange="this.form.submit()">
      {% set desk_all = all_sites and sites|length > 1 and active == 'today' %}
      {% if sites|length > 1 %}<option value="all" {% if desk_all %}selected{% endif %}>{{ _('Tutti i siti') }}</option>{% endif %}
      {% for x in sites %}<option value="{{ x.id }}" {% if site and x.id == site.id and not desk_all %}selected{% endif %}>{{ x.domain }}</option>{% endfor %}
    </select>
    <input type="hidden" name="back" value="{{ request.url.path }}">
    <noscript><button class="btn sm" type="submit">{{ _('Vai') }}</button></noscript>
  </form>
  {% endif %}
  {% if starting or active == 'start' %}<a href="/start" {% if active == 'start' %}class="on" aria-current="page"{% endif %}>{{ icon('start') }}{{ _('Primi passi') }}</a>{% endif %}
  <a href="/" {% if active == 'today' %}class="on" aria-current="page"{% endif %}>{{ icon('desk') }}{{ _('Desk') }}</a>
  <a href="/site" {% if active == 'site' %}class="on" aria-current="page"{% endif %}>{{ icon('site') }}{{ _('Sito e profilo') }}</a>
  <a href="/sources" {% if active == 'sources' %}class="on" aria-current="page"{% endif %}>{{ icon('sources') }}{{ _('Fonti') }}</a>
  <a href="/trends" {% if active == 'trends' %}class="on" aria-current="page"{% endif %}>{{ icon('trends') }}{{ _('Trend e piano') }}</a>
  <a href="/index" {% if active == 'index' %}class="on" aria-current="page"{% endif %}>{{ icon('index') }}{{ _('Indice notizie') }}</a>
  <a href="/drafts" {% if active == 'drafts' %}class="on" aria-current="page"{% endif %}>{{ icon('drafts') }}{{ _('Bozze') }}</a>
  <a href="/publications" {% if active == 'publications' %}class="on" aria-current="page"{% endif %}>{{ icon('publications') }}{{ _('Pubblicazioni') }}</a>
  <a href="/feedback" {% if active == 'feedback' %}class="on" aria-current="page"{% endif %}>{{ icon('feedback') }}{{ _('Feedback') }} <span class="chip" style="font-size: 10px; padding: 0 6px;">{{ _('in prova') }}</span>{% if feedback_new %} <span class="chip blue num" title="{{ _('Messaggi nuovi dei lettori') }}">{{ feedback_new }}</span>{% endif %}</a>
  <span class="grow"></span>
  <div class="nav-foot">
  <a href="/plan" class="plan-link{% if active == 'plan' %} on{% endif %}" {% if active == 'plan' %}aria-current="page"{% endif %}>{{ icon('plans') }}<span class="txt"><span>{{ _('Il mio piano') }}</span>{% if plan_state %}<small>{{ plan_state.plan_name }} · {{ (_('{n} giorno rimasto', n=plan_state.days_left) if plan_state.days_left == 1 else _('{n} giorni rimasti', n=plan_state.days_left)) if plan_state.status == 'trialing' else plan_state.label|lower }}</small>{% elif plan_name %}<small>{{ plan_name }}</small>{% endif %}</span></a>
  <a href="/guide" {% if active == 'guide' %}class="on" aria-current="page"{% endif %}>{{ icon('guide') }}{{ _('Guida') }}</a>
  <a href="/settings" {% if active == 'settings' %}class="on" aria-current="page"{% endif %}>{{ icon('settings') }}{{ _('Impostazioni') }}</a>
  {% if caller.operator %}<a href="/admin">{{ icon('admins') }}{{ _('Amministrazione') }}</a>{% endif %}
  <div class="who me">
    <span class="avatar" aria-hidden="true">{{ (caller.name or '?')[:1]|upper }}</span>
    <span class="id"><span class="name" title="{{ caller.name }}">{{ caller.name }}</span><span>{{ {'owner': _('direttore'), 'editor': _('redattore'), 'viewer': _('lettura')}[caller.role] }}</span></span>
    <form method="post" action="/logout"><button class="out" type="submit" title="{{ _('Esci') }}" aria-label="{{ _('Esci') }}">{{ icon('logout') }}</button></form>
  </div>
  {% if version %}<span class="version">Redazia {{ version }}</span>{% endif %}
  </div>
</div>
</nav>
<main class="main">
  <div class="topbar">{% include "_lang.html.j2" %}</div>
  {% if plan_state and plan_state.status in ('trialing', 'past_due', 'canceled', 'expired') %}
  <p class="notice" role="status" style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
    <span>{% if plan_state.status == 'trialing' %}{{ _('Prova gratuita: {n} giorno rimasto.', n=plan_state.days_left) if plan_state.days_left == 1 else _('Prova gratuita: {n} giorni rimasti.', n=plan_state.days_left) }}
    {% elif plan_state.status == 'expired' %}{{ _('La prova o il periodo pagato è finito: ricevi solo le proposte, due al giorno per sito. Scegli un piano per scrivere bozze e pubblicare.') }}
    {% elif plan_state.status == 'past_due' %}{{ _("L'ultimo pagamento non è riuscito: il circuito riprova nei prossimi giorni.") }}
    {% else %}{% if plan_state.current_period_end %}{{ _('Abbonamento disdetto: la redazione si ferma il {date}.', date=plan_state.current_period_end.strftime('%d/%m')) }}{% else %}{{ _('Abbonamento disdetto: la redazione si ferma a fine periodo.') }}{% endif %}{% endif %}</span>
    <a href="/plan">{{ _('Scegli il piano') if plan_state.status != 'past_due' else _("Vedi l'abbonamento") }}</a>
  </p>
  {% endif %}
  {% if notice %}<p class="notice" role="status" id="flash">{{ notice }}</p>{% endif %}
  {% if activity and not activity.full %}{% include "_activity.html.j2" %}{% endif %}
  {% block main %}{% endblock %}
</main>
</div>
{% if activity %}
<script>
/* Follows the work while it runs: the Attività box is fetched again every
   few seconds, and the page reloads when the last job ends, so what the
   work produced shows at once. */
(function () {
  var box = document.getElementById('activity');
  if (!box) return;
  var was = box.dataset.active === '1';
  function busy() {
    var a = document.activeElement;
    return a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName);
  }
  function poll() {
    fetch('/ui/activity?mode=' + box.dataset.mode, {credentials: 'same-origin'})
      .then(function (r) { return r.ok ? r.text() : null; })
      .then(function (html) {
        if (html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = html.trim();
          var fresh = tmp.firstElementChild;
          if (fresh) { box.replaceWith(fresh); box = fresh; }
        }
        var now = box.dataset.active === '1';
        if (was && !now && !busy()) { location.reload(); return; }
        was = now;
        setTimeout(poll, now ? 3000 : 20000);
      })
      .catch(function () { setTimeout(poll, 10000); });
  }
  setTimeout(poll, was ? 3000 : 20000);
})();
</script>
{% endif %}
{% if held %}
{# «Pubblica le autorizzate»: on every page while something authorized waits, so it is not forgotten. #}
<form method="post" action="/ui/publications/release" class="release" role="region" aria-label="{{ _('Da pubblicare') }}">
  <input type="hidden" name="back" value="{{ request.url.path }}">
  <span>{{ _('{n} articolo autorizzato da pubblicare', n=held) if held == 1 else _('{n} articoli autorizzati da pubblicare', n=held) }}</span>
  <button class="btn pri" type="submit">{{ _('Pubblica le autorizzate') }}</button>
</form>
<style>
.release { position: fixed; right: 24px; bottom: 24px; z-index: 50; display: flex; align-items: center; gap: 12px;
  padding: 12px 14px 12px 18px; border-radius: 12px; background: var(--surface); border: 2px solid var(--accent);
  box-shadow: 0 8px 28px rgba(0,0,0,.18); font-weight: 600; max-width: calc(100vw - 32px); }
@media (max-width: 640px) { .release { left: 16px; right: 16px; bottom: 16px; justify-content: space-between; } }
</style>
{% endif %}
{% include "_once.html.j2" %}
</body>
</html>
