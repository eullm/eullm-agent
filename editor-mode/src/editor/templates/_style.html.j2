<style>
/* Served by the dashboard (api.FONTS): the same letters on every computer and phone. */
@font-face { font-family: "IBM Plex Sans"; font-style: normal; font-weight: 400; font-display: swap; src: url("/static/ibm-plex-sans-latin-400-normal.woff2") format("woff2"); }
@font-face { font-family: "IBM Plex Sans"; font-style: normal; font-weight: 500; font-display: swap; src: url("/static/ibm-plex-sans-latin-500-normal.woff2") format("woff2"); }
@font-face { font-family: "IBM Plex Sans"; font-style: normal; font-weight: 600; font-display: swap; src: url("/static/ibm-plex-sans-latin-600-normal.woff2") format("woff2"); }
@font-face { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 400; font-display: swap; src: url("/static/ibm-plex-mono-latin-400-normal.woff2") format("woff2"); }
@font-face { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 500; font-display: swap; src: url("/static/ibm-plex-mono-latin-500-normal.woff2") format("woff2"); }
@font-face { font-family: "Source Serif 4"; font-style: normal; font-weight: 400; font-display: swap; src: url("/static/source-serif-4-latin-400-normal.woff2") format("woff2"); }
@font-face { font-family: "Source Serif 4"; font-style: normal; font-weight: 600; font-display: swap; src: url("/static/source-serif-4-latin-600-normal.woff2") format("woff2"); }
@font-face { font-family: "Source Serif 4"; font-style: italic; font-weight: 400; font-display: swap; src: url("/static/source-serif-4-latin-400-italic.woff2") format("woff2"); }
:root {
  --bg: #F4F5F2; --surface: #FFFFFF; --ink: #16191D; --ink-2: #3B4148; --muted: #5A6169;
  --line: #DDE0DC; --line-2: #ECEEEA; --track: #E9EBE6;
  --accent: #1C47C9; --accent-dark: #12328F; --accent-soft: #E6ECFB;
  --hype: #E8913A; --amber: #9A4A06; --amber-soft: #FDF1E3;
  --green: #1E6B43; --green-soft: #E5F3EA; --red: #A3271B; --red-soft: #FBE9E6; --teal: #1F6466; --teal-soft: #E3F0EF; --grey-soft: #EEF0EC;
  --sans: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --serif: "Source Serif 4", "Source Serif Pro", Georgia, serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--sans); }
a { color: var(--accent); } a:hover { color: var(--accent-dark); }
h1 { margin: 0; font-size: 30px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
h2 { margin: 0; font-size: 17px; font-weight: 600; }
h3 { margin: 0; font-size: 16px; font-weight: 600; }
p { margin: 0; }
.shell { display: flex; flex-wrap: wrap; min-height: 100vh; }
.nav { flex: 1 1 232px; max-width: 100%; padding: 24px 16px; background: var(--surface); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
.nav-body > a, .nav-foot > a { display: flex; align-items: center; gap: 10px; padding: 7px 10px; min-height: 38px; border-radius: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; font-weight: 500; }
.nav-body > a:hover, .nav-foot > a:hover { background: var(--grey-soft); color: var(--ink); }
.nav-body > a.on, .nav-foot > a.on { background: var(--accent-soft); color: var(--accent-dark); font-weight: 600; box-shadow: inset 3px 0 0 var(--accent); }
.nav .ico { flex: none; width: 18px; height: 18px; color: var(--muted); }
.nav a:hover .ico { color: var(--ink-2); }
.nav a.on .ico { color: var(--accent); }
.nav-body > a .txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-body > a .end { margin-left: auto; display: inline-flex; }
.nav-body > a .end .ico { width: 14px; height: 14px; }
.nav-body > a.sub, .nav-foot > a.sub { min-height: 30px; padding: 4px 10px 4px 38px; font-size: 13px; font-weight: 400; color: var(--muted); }
.nav-body > a.plan-link .txt, .nav-foot > a.plan-link .txt { display: flex; flex-direction: column; gap: 1px; white-space: normal; }
.nav-body > a.plan-link small, .nav-foot > a.plan-link small { font-size: 12px; font-weight: 400; color: var(--muted); }
.nav-body > a.plan-link.on small, .nav-foot > a.plan-link.on small { color: var(--accent-dark); opacity: 0.8; }
.who.me { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 12px 6px 4px 8px; margin-top: 8px; border-top: 1px solid var(--line-2); }
.who.me .avatar { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-dark); font-weight: 600; font-size: 13px; }
.who.me .id { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
.who.me .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; font-size: 13px; font-weight: 500; }
.who.me form { flex: none; }
.who.me .out { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; }
.who.me .out:hover { background: var(--grey-soft); color: var(--ink); }
.who.me .out .ico { color: inherit; }
.nav-foot .version, .nav-foot > a.version { display: block; min-height: 0; padding: 2px 10px 0; font-size: 11px; font-weight: 400; color: var(--muted); text-decoration: none; }
.nav-foot > a.version:hover { background: none; color: var(--accent); }
.form-grid.billing { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 760px; align-items: start; }
@media (max-width: 640px) { .form-grid.billing { grid-template-columns: 1fr; } .form-grid.billing .field { grid-column: auto !important; } }
.form-grid.billing .wide { grid-column: 1 / -1; }
.brand { text-decoration: none; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 0 12px 20px; }
.brand .logo { display: block; height: 36px; width: auto; }
.brand small { font-size: 12px; color: var(--muted); padding-left: 2px; }
.switch { display: flex; flex-direction: column; gap: 4px; padding: 0 0 16px; }
.switch label { font-size: 12px; color: var(--muted); padding: 0 12px; }
.grow { flex-grow: 1; min-height: 24px; }
.who .name { overflow-wrap: anywhere; color: var(--ink); }
.who { display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 12px; margin-top: 8px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
.main { flex: 999 1 560px; min-width: 0; padding: 32px clamp(16px, 3vw, 40px) 56px; display: flex; flex-direction: column; gap: 24px; }
.head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
.head > div:first-child { display: flex; flex-direction: column; gap: 6px; }
.kicker { font-size: 13px; color: var(--muted); }
.lead { font-size: 14px; color: var(--muted); }
tr.faded td { opacity: 0.55; }
.stack-sm { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.cols { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
.col-wide { flex: 3 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
.col-side { flex: 2 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.pad { padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; }
.card-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
.item { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--line-2); }
.item:last-child { border-bottom: 0; }
.item .what { flex: 1 1 260px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.item .what strong { font-weight: 600; }
.item .what span { font-size: 14px; color: var(--muted); }
.prop { margin: 4px 0 0; display: grid; gap: 2px; font-size: 14px; }
.prop dt { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; margin-top: 6px; }
.prop dd { margin: 0; overflow-wrap: anywhere; }
.prop ul { margin: 0; padding-left: 18px; }
.prop li { margin: 2px 0; }
.prop .hint { font-size: 12px; }
.empty { padding: 20px; color: var(--muted); font-size: 14px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; padding: 0 14px; border-radius: 8px; font: 500 14px var(--sans); border: 1px solid #C9CDC7; background: var(--surface); color: var(--ink); cursor: pointer; text-decoration: none; white-space: nowrap; }
.btn:hover { border-color: var(--ink-2); color: var(--ink); }
.btn.pri { background: var(--accent); border-color: var(--accent); color: #FFFFFF; }
.btn.pri:hover { background: var(--accent-dark); border-color: var(--accent-dark); color: #FFFFFF; }
.btn.danger { color: var(--red); border-color: var(--red); }
.btn.danger:hover { background: var(--red-soft); }
/* Panels that open on click: a full bar with a coloured badge and a chevron,
   so it reads as something to press, not as a footnote. --tone picks the colour. */
input.search { width: 100%; min-height: 42px; padding: 0 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); font: 14px var(--sans); color: var(--ink); }
input.search:focus { background: var(--surface); }
a.room-name { font-weight: 600; text-decoration: none; }
a.room-name:hover { text-decoration: underline; }
/* A small "more" inside a card or a table cell: an accent link with a chevron. */
details.mini > summary { list-style: none; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font: 500 13px var(--sans); color: var(--accent); }
details.mini > summary::-webkit-details-marker { display: none; }
details.mini > summary::after { content: ""; width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); transition: transform .15s; }
details.mini[open] > summary::after { transform: rotate(45deg); }
details.mini > summary:hover { color: var(--accent-dark); text-decoration: underline; }
details.mini[open] > summary { margin-bottom: 6px; }
.phases { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
.kinds { gap: 16px; align-items: stretch; }
.kinds .kind { flex: 1 1 240px; display: block; color: inherit; text-decoration: none; padding: 16px; }
.kinds .kind:hover { border-color: var(--accent); }
.kinds .kind h2 { margin-top: 0; }
details.fold > summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
details.fold > summary::-webkit-details-marker { display: none; }
details.fold > summary h2 { margin: 0; }
details.fold > summary::after { content: "▾"; color: var(--muted); }
details.fold[open] > summary::after { content: "▴"; }
details.fold[open] > summary { margin-bottom: 12px; }
.settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px 32px; }
.settings-grid form { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
.settings-grid label:not(.row) { font-weight: 600; font-size: 14px; }
.topic-list { display: flex; flex-direction: column; }
.topic { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 0; border-top: 1px solid var(--line-2); }
.topic small { display: block; }
.notice-up { background: var(--teal-soft); color: var(--teal); border-radius: 10px; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
ol.how { margin: 10px 0 10px 1.2em; padding: 0; }
ol.how li { margin: 6px 0; }
ol.steps { list-style: none; margin: 16px 0 0; padding: 0; }
ol.steps .step { display: flex; gap: 14px; padding: 0 0 18px; position: relative; }
ol.steps .step:not(:last-child)::before { content: ""; position: absolute; left: 15px; top: 34px; bottom: 2px; width: 2px; background: var(--line); }
ol.steps .dot { flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-weight: 600; font-size: 14px; background: var(--surface); border: 2px solid var(--line); color: var(--muted); z-index: 1; }
ol.steps .step.done .dot { background: var(--green-soft); border-color: var(--green); color: var(--green); }
ol.steps .step.now .dot { background: var(--accent); border-color: var(--accent); color: #fff; }
ol.steps .body { flex: 1; min-width: 0; padding-top: 4px; }
ol.steps .body h2 { margin: 0 0 4px; font-size: 16px; }
ol.steps .step.done .body h2 { color: var(--muted); font-weight: 500; }
ol.steps .step.now .body { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 10px; padding: 12px 16px; }
details.act { --tone: var(--accent); --tone-soft: var(--accent-soft); margin-top: 10px; border: 1px solid var(--line); border-left: 4px solid var(--tone); border-radius: 10px; background: var(--surface); scroll-margin-top: 16px; }
details.act[data-tone="green"] { --tone: var(--green); --tone-soft: var(--green-soft); }
details.act[data-tone="amber"] { --tone: var(--amber); --tone-soft: var(--amber-soft); }
details.act[data-tone="teal"] { --tone: var(--teal); --tone-soft: var(--teal-soft); }
details.act[data-tone="red"] { --tone: var(--red); --tone-soft: var(--red-soft); }
details.act > summary { list-style: none; display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 14px; cursor: pointer; border-radius: 6px; font: 600 14px var(--sans); color: var(--ink); }
details.act > summary::-webkit-details-marker { display: none; }
details.act > summary::after { content: ""; flex: none; width: 8px; height: 8px; margin: 0 4px 0 auto; border-right: 2px solid var(--tone); border-bottom: 2px solid var(--tone); transform: rotate(-45deg); transition: transform .15s; }
details.act[open] > summary::after { transform: rotate(45deg); }
details.act > summary .ico { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: var(--tone-soft); color: var(--tone); font-size: 15px; }
details.act > summary .sub { font-weight: 400; font-size: 13px; color: var(--muted); min-width: 0; overflow-wrap: anywhere; }
details.act > summary:hover { background: var(--tone-soft); }
details.act[open] { box-shadow: 0 0 0 3px var(--tone-soft); }
details.act[open] > summary { border-bottom: 1px solid var(--line-2); border-radius: 6px 6px 0 0; }
details.act > :not(summary) { margin-left: 16px; margin-right: 16px; }
details.act > :last-child:not(summary) { margin-bottom: 14px; }
details.act.sm > summary { min-height: 40px; font-size: 13px; }
details.act .notice { margin-top: 12px; }
.btn.sm { min-height: 32px; padding: 0 10px; font-size: 13px; }
.btn.ghost { border-style: dashed; color: var(--ink-2); }
.btn:focus-visible, a:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.link { background: none; border: 0; padding: 0; font: inherit; font-size: 12px; color: var(--accent); cursor: pointer; text-decoration: underline; }
form.inline { display: inline-flex; }
.chip { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font: 500 12px var(--sans); white-space: nowrap; background: var(--grey-soft); color: var(--ink-2); }
.chip.blue { background: var(--accent-soft); color: var(--accent); }
.chip.amber { background: var(--amber-soft); color: var(--amber); }
.chip.green { background: var(--green-soft); color: var(--green); }
.chip.red { background: var(--red-soft); color: var(--red); }
.chip.teal { background: var(--teal-soft); color: var(--teal); }
.chip.dark { background: var(--ink); color: #FFFFFF; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
.kpi { padding: 12px 16px; display: flex; flex-direction: column; gap: 2px; color: var(--ink); text-decoration: none; min-width: 0; }
a.kpi:hover { border-color: var(--ink-2); color: var(--ink); }
.kpi .label { font-size: 12px; color: var(--muted); }
.kpi .value { font: 500 24px/1.2 var(--mono); }
.kpi .note { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi.warn .value, .kpi.warn .note { color: var(--amber); }
.kpi.bad { border-color: #E3B3AC; } .kpi.bad .value, .kpi.bad .note { color: var(--red); }
.limits { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
.limit { display: flex; flex-direction: column; gap: 6px; padding: 10px 14px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); font-size: 13px; }
.limit .top { display: flex; justify-content: space-between; gap: 12px; color: var(--ink-2); }
.limit .gauge { height: 6px; border-radius: 3px; background: var(--track); overflow: hidden; }
.limit .gauge i { display: block; height: 100%; border-radius: 3px; background: var(--green); }
.limit.amber { background: var(--amber-soft); border-color: #E8C9A5; } .limit.amber .gauge i { background: var(--hype); }
.limit.red { background: var(--red-soft); border-color: #E3B3AC; } .limit.red .gauge i { background: var(--red); } .limit.red strong { color: var(--red); }
.limit small { color: var(--muted); }
.board { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 16px; align-items: start; }
.board.even { grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
.board.even .stack { display: contents; }
.stack { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
@media (max-width: 1100px) { .board { grid-template-columns: minmax(0, 1fr); } }
.item.line { flex-wrap: nowrap; gap: 12px; padding: 9px 20px; }
.item.line > .chip { flex: none; max-width: 160px; overflow: hidden; text-overflow: ellipsis; }
.item.line .what { flex: 1 1 auto; gap: 0; }
.item.line .what strong { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item.line .one { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
details.item.line.prop-line { display: block; padding: 0; }
details.prop-line > summary { display: flex; align-items: center; gap: 12px; padding: 9px 20px; cursor: pointer; list-style: none; min-width: 0; }
details.prop-line > summary::-webkit-details-marker { display: none; }
details.prop-line > summary .chip { flex: none; max-width: 160px; overflow: hidden; text-overflow: ellipsis; }
details.prop-line > summary .what { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; }
details.prop-line > summary .what strong { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
details.prop-line > summary .what .one { color: var(--muted); }
details.prop-line > summary .more { flex: none; font-size: 12px; }
details.prop-line[open] > summary .more { visibility: hidden; }
details.prop-line[open] > summary .what strong { white-space: normal; }
details.prop-line .detail { padding: 0 20px 14px; }
.plan-line { align-items: flex-start; scroll-margin-top: 16px; }
.plan-line > .chip { margin-top: 2px; }
.plan-line .plan-what { flex: 1 1 auto; min-width: 0; }
.plan-line .plan-what > summary { display: flex; flex-direction: column; cursor: pointer; list-style: none; min-width: 0; }
.plan-line .plan-what > summary::-webkit-details-marker { display: none; }
.plan-line .plan-what > summary strong { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.plan-line .plan-what[open] > summary strong { white-space: normal; }
.plan-line .plan-what > summary .one { font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.plan-line .plan-what[open] > summary .more { visibility: hidden; }
.plan-line .plan-what .detail { padding-top: 8px; }
.trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.trio > div { display: flex; flex-direction: column; }
.trio .num { font-size: 20px; }
.trio small { font-size: 12px; color: var(--muted); }
.trio-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; align-items: start; }
.rank { gap: 10px; }
.rank-row { display: grid; grid-template-columns: minmax(90px, 1.2fr) minmax(60px, 1fr) auto; gap: 10px; align-items: center; font-size: 13px; }
.rank-row a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-row .num { font-size: 12px; color: var(--muted); white-space: nowrap; }
.news-row { display: flex; flex-direction: column; gap: 1px; font-size: 13px; padding-bottom: 8px; border-bottom: 1px solid var(--line-2); }
.news-row:last-child { border-bottom: 0; padding-bottom: 0; }
.news-row a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--ink); text-decoration: none; }
.news-row a:hover { color: var(--accent); text-decoration: underline; }
.news-row small { font-size: 12px; color: var(--muted); }
table.sites { min-width: 1040px; }
.rank-item { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 14px; padding: 14px 20px; border-bottom: 1px solid var(--line-2); align-items: start; }
.rank-item:last-child { border-bottom: 0; }
.rank-item .pos { font-size: 18px; color: var(--muted); text-align: right; padding-top: 1px; }
.rank-item .body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.rank-item .body p { font-size: 14px; color: var(--ink-2); }
.rank-item .body ul { margin: 2px 0 0; padding-left: 18px; font-size: 13px; }
.rank-item .body li { margin: 1px 0; overflow-wrap: anywhere; }
.rank-item .side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
@media (max-width: 720px) { .rank-item { grid-template-columns: 28px minmax(0, 1fr); } .rank-item .side { grid-column: 2; align-items: flex-start; } }
