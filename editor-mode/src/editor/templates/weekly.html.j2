<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#f2f4f3">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f3"><tr><td align="center" style="padding:28px 12px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:14px;border:1px solid #e1e6e3;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1d2622;font-size:15px;line-height:1.55">
<tr><td style="padding:26px 32px 10px">{% if w.link %}<img src="{{ w.link }}static/redazia-mail.png" width="111" height="36" alt="Redazia" style="display:block;border:0">{% else %}<span style="font-size:22px;font-weight:700;color:#1f6f63">Redazia</span>{% endif %}</td></tr>
<tr><td style="padding:0 32px"><div style="height:3px;width:44px;background:#1f6f63;border-radius:2px"></div></td></tr>
<tr><td style="padding:18px 32px 4px">
  <h1 style="margin:0 0 6px;font-size:22px;line-height:1.3">{{ subject }}</h1>
  <p style="margin:0 0 8px;color:#56625c">{% if w.published %}{{ _('Questa settimana sono usciti {n} articoli.', n=w.published) }}{% else %}{{ _('Questa settimana non è uscito nessun articolo.') }}{% endif %}</p>
</td></tr>
{% for s in w.sites %}
<tr><td style="padding:14px 32px 6px">
  <h2 style="margin:8px 0 10px;font-size:18px">{{ s.name }} <span style="font-weight:400;color:#7a8580;font-size:14px">{{ s.domain }}</span></h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 14px;border-collapse:separate;border-spacing:6px 0"><tr>
    {% for value, label in [(s.published|length, _('pubblicati')), (s.numbers.drafts, _('bozze scritte')), (s.numbers.proposals, _('proposte')), (s.numbers.news, _('notizie lette'))] %}
    <td align="center" style="background:#f4f7f5;border-radius:10px;padding:10px 4px;width:25%"><div style="font-size:22px;font-weight:700;color:#1f6f63">{{ value }}</div><div style="font-size:12px;color:#56625c">{{ label }}</div></td>
    {% endfor %}
  </tr></table>
  {% if s.published %}
  <p style="margin:0 0 6px;font-weight:600">{{ _('Pubblicati') }}</p>
  <ul style="margin:0 0 14px;padding-left:20px">
    {% for a in s.published %}<li style="margin:0 0 6px">{% if a.url %}<a href="{{ a.url }}" style="color:#1f6f63">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %} <span style="color:#7a8580;font-size:13px">· {{ day(a.day) }}{% if a.language %} · {{ a.language|upper }}{% endif %}</span></li>{% endfor %}
  </ul>
  {% endif %}
  {% if s.search %}
  <p style="margin:0 0 6px;font-weight:600">{{ _('Da Google') }}</p>
  <p style="margin:0 0 6px">{{ _('{n} clic', n=s.search.this.clicks) }} <span style="color:#7a8580">({{ _('la settimana prima {n}', n=s.search.before.clicks) }})</span> · {{ _('{n} impressioni', n=s.search.this.impressions) }}{% if s.search.this.position %} · {{ _('posizione media {n}', n=s.search.this.position) }}{% endif %}</p>
  {% if s.search.pages %}<p style="margin:0 0 4px;color:#56625c;font-size:13px">{{ _('Le pagine più cliccate') }}</p>
  <ul style="margin:0 0 8px;padding-left:20px;font-size:14px">{% for x in s.search.pages %}<li><a href="{{ x.key }}" style="color:#1f6f63">{{ x.key|replace('https://', '')|replace('http://', '') }}</a> · {{ _('{n} clic', n=x.clicks) }}</li>{% endfor %}</ul>{% endif %}
  {% if s.search.queries %}<p style="margin:0 0 14px;font-size:14px"><span style="color:#56625c">{{ _('Le ricerche che portano più visite') }}:</span> {% for q in s.search.queries %}{{ q.key }} ({{ q.clicks }}){% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
  {% endif %}
  {% if s.search_problem %}<p style="margin:0 0 14px;font-size:14px;color:#8a5a00">Search Console: {{ _(s.search_problem) }}</p>{% endif %}
  {% if s.waiting.proposals or s.waiting.drafts or s.waiting.publications or s.waiting.profile %}
  <p style="margin:0 0 6px;font-weight:600">{{ _('Ti aspettano') }}</p>
  <ul style="margin:0 0 14px;padding-left:20px">
    {% if s.waiting.profile %}<li>{{ _('un profilo da approvare') }}</li>{% endif %}
    {% if s.waiting.proposals %}<li>{{ _('{n} proposte', n=s.waiting.proposals) }}</li>{% endif %}
    {% if s.waiting.drafts %}<li>{{ _('{n} bozze da rileggere', n=s.waiting.drafts) }}</li>{% endif %}
    {% if s.waiting.publications %}<li>{{ _('{n} pubblicazioni da approvare', n=s.waiting.publications) }}</li>{% endif %}
  </ul>
  {% endif %}
  <p style="margin:0 0 6px;font-weight:600">{{ _('La prossima settimana') }}</p>
  <p style="margin:0 0 6px">{% if s.auto_per_day %}{{ _('la redazione automatica pubblica fino a {n} articoli al giorno.', n=s.auto_per_day) }}{% elif s.proposals_per_day %}{{ _('{n} proposte nuove ogni mattina.', n=s.proposals_per_day) }}{% else %}{{ _('nuove proposte ogni mattina.') }}{% endif %}</p>
  {% if s.coming %}<p style="margin:0 0 4px;color:#56625c;font-size:13px">{{ _('In scrittura') }}</p><ul style="margin:0 0 10px;padding-left:20px;font-size:14px">{% for x in s.coming %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
</td></tr>
{% endfor %}
<tr><td style="padding:6px 32px 22px">
  {% if w.max_drafts_month %}<p style="margin:0 0 14px;color:#56625c">{{ _('Articoli del mese: {used} su {max} del piano.', used=w.drafts_month, max=w.max_drafts_month) }}</p>{% endif %}
  {% if w.link %}<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#1f6f63;border-radius:8px"><a href="{{ w.link }}" style="display:inline-block;padding:12px 24px;color:#ffffff;font-weight:600;text-decoration:none">{{ _('Apri la redazione') }}</a></td></tr></table>{% endif %}
</td></tr>
<tr><td style="padding:16px 32px 24px;border-top:1px solid #eef1ef;font-size:12px;color:#7a8580">{{ _('Il rapporto arriva ogni lunedì; si spegne in Impostazioni › Preferenze.') }}<br>Redazia &middot; <a href="https://redazia.com" style="color:#7a8580">redazia.com</a> &middot; I3K Technologies Srl &middot; Via Enrico Cosenz 54, 20158 Milano</td></tr>
</table></td></tr></table></body></html>
