{# One social video: its idea and, once made, the clip. Needs `v`, `vstate` and `back`. #}
{% set busy = v.id in vstate.making %}
{% set scs = v.scenes or [] %}
{% set chs = vstate.choices_for(scs|length if scs else 1) %}
<div class="video-idea" id="video-{{ v.id }}">
  <div class="row" style="justify-content: space-between; gap: 8px; flex-wrap: wrap;">
    <strong>{{ v.title }}</strong>
    {% if v.status == 'ready' %}<span class="chip green">{{ _('Pronto') }}</span>
    {% elif busy %}<span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('In preparazione') }}</span>
    {% elif v.status == 'failed' %}<span class="chip amber">{{ _('Non riuscito') }}</span>
    {% elif v.status in ('queued', 'making') %}<span class="chip amber">{{ _('Interrotto') }}</span>
    {% else %}<span class="chip">{{ _('Idea') }}</span>{% endif %}
  </div>
  {% if v.gain or v.auto %}<p class="hint" style="margin: 2px 0;">{% if v.gain %}<span class="chip teal">{{ _('In salita') }}</span> {{ _('+{n} punti di Hype nelle ultime ore', n=v.gain|round|int) }}{% if v.hype %} · {{ _('Hype {n}', n=v.hype|round|int) }}{% endif %}{% elif v.hype %}{{ _('Hype {n}', n=v.hype|round|int) }}{% endif %}{% if v.auto %} · {{ _('proposta del mattino') }}{% endif %}</p>{% endif %}
  {% if v.social %}{% set sb = v.social.get('bluesky') or [] %}{% set yt = v.social.get('youtube') or {} %}
  <p class="hint" style="margin: 2px 0;"><span class="chip blue">{{ _('Sui social') }}</span>
    {% for b in sb[:2] %}{% if b.url %}<a href="{{ b.url }}" rel="noopener" target="_blank">{% endif %}{{ _('Bluesky: «{t}», {n} post', t=b.label, n=b.posts|default(0)) }}{% if b.url %}</a>{% endif %}{% if not loop.last or yt %} · {% endif %}{% endfor %}
    {% if yt %}{{ _("YouTube: {n} Short in 48 ore, {v} visualizzazioni l'ora", n=yt.videos, v=yt.per_hour) }}{% if yt.top %} · <a href="{{ yt.top.url }}" rel="noopener" target="_blank">{{ _('il più visto') }}</a>{% endif %}{% endif %}</p>
  {% endif %}
  {% if v.status == 'ready' and v.has_file %}
  <video controls playsinline preload="metadata" src="/videos/{{ v.id }}/file" style="width: 100%; max-width: 280px; aspect-ratio: 9 / 16; background: #000; border-radius: 8px; display: block; margin: 8px 0;"></video>
  {% elif v.status == 'ready' %}
  <p class="hint">{{ _('Il file è stato cancellato dopo 30 giorni: restano i testi del post.') }}</p>
  {% endif %}
  <p class="hint" style="margin: 2px 0;">{{ _(vstate.languages.get((v.language or 'it')[:2], v.language or '')) }}{% if v.seconds %} · {{ _('voce scritta per {n} secondi', n=v.seconds) }}{% endif %}{% if scs|length > 1 %} · {{ _('{n} scene', n=scs|length) }}{% endif %}</p>
  {% if v.hook %}<p style="margin: 4px 0;"><span class="kicker">{{ _('Primo secondo') }}</span> {{ v.hook }}</p>{% endif %}
  {% if scs %}
  <ol class="video-scenes" style="margin: 4px 0; padding-left: 20px;">
    {% for sc in scs %}<li style="margin: 4px 0;">{% if sc.text %}<span class="chip">{{ sc.text }}</span> {% endif %}{% if sc.voice %}«{{ sc.voice }}»{% endif %}
      <details class="mini"><summary>{{ _('Inquadratura per il modello video') }}</summary><p class="hint" lang="en">{{ sc.shot }}</p></details></li>{% endfor %}
  </ol>
  {% if not vstate.montage %}<p class="hint">{{ _('Su questo server manca ffmpeg: il video esce in una sola clip, senza scritte.') }}</p>{% endif %}
  {% else %}
  {% if v.voiceover %}<p style="margin: 4px 0;"><span class="kicker">{{ _('Voce') }}</span> «{{ v.voiceover }}»</p>{% endif %}
  <details class="mini"><summary>{{ _('Scena per il modello video') }}</summary><p class="hint" lang="en">{{ v.scene }}</p></details>
  {% endif %}
  {% set post = v|video_post %}
  <p style="margin: 4px 0; white-space: pre-line;"><span class="kicker">{{ _('Testo del post') }}</span> {{ post }}</p>
  <textarea id="post-{{ v.id }}" hidden readonly>{{ post }}</textarea>
  {% if v.status == 'failed' and v.error %}<p class="hint">{{ _('Il servizio video ha risposto: {error}', error=v.error[:200]) }}</p>{% endif %}
  <div class="row" style="flex-wrap: wrap; gap: 6px; margin-top: 6px;">
    <button class="btn sm" type="button" data-copy="post-{{ v.id }}">{{ _('Copia il testo del post') }}</button>
    {% if v.status == 'ready' and v.has_file %}<a class="btn sm pri" href="/videos/{{ v.id }}/file?download=1" download>{{ _('Scarica il video') }}</a>{% endif %}
    {% if caller.can('editor') and not busy %}
      {% if v.status in ('idea', 'failed', 'queued', 'making') and vstate.on %}
      <form class="inline row" style="gap: 6px;" method="post" action="/ui/videos/{{ v.id }}/make"><input type="hidden" name="back" value="{{ back }}">
        {% if chs %}<label class="sr" for="sec-{{ v.id }}">{{ _('Durata') }}</label>
        <select id="sec-{{ v.id }}" name="seconds" class="sm" title="{{ _('Durata del video e prezzo') }}">
          {% set want = v.seconds or chs[0].seconds %}
          {% for ch in chs %}<option value="{{ ch.seconds }}"{% if ch.seconds == want or (loop.last and want > ch.seconds) %} selected{% endif %}>{{ _('{n} secondi', n=ch.seconds) }}{% if ch.price %} · {{ _('{n} crediti', n=ch.price) }}{% endif %}</option>{% endfor %}
        </select>{% endif %}
        <button class="btn sm{% if v.status == 'idea' %} pri{% endif %}" type="submit">{% if v.status == 'idea' %}{{ _('Genera il video') }}{% else %}{{ _('Riprova') }}{% endif %}{% if vstate.price and not chs %} · {{ _('{n} crediti', n=vstate.price) }}{% endif %}</button></form>
      {% endif %}
      {% if v.status == 'idea' and vstate.can_ideas %}
      <form class="inline row" style="gap: 6px;" method="post" action="/ui/videos/{{ v.id }}/language"><input type="hidden" name="back" value="{{ back }}">
        <label class="sr" for="lang-{{ v.id }}">{{ _('Lingua') }}</label>
        <select id="lang-{{ v.id }}" name="language" class="sm">{% for code, name in vstate.languages.items() if code != (v.language or '')[:2] %}<option value="{{ code }}">{{ _(name) }}</option>{% endfor %}</select>
        <button class="btn sm" type="submit">{{ _('Rifai in questa lingua') }}</button></form>
      {% endif %}
      {% if v.topic_id and not v.draft_id and site and site.kind != 'social' and vstate.can_ideas %}<form class="inline" method="post" action="/ui/videos/{{ v.id }}/article"><button class="btn sm" type="submit">{{ _("Scrivi anche l'articolo") }}</button></form>{% endif %}
      {% if v.status in ('idea', 'ready', 'failed') %}<form class="inline" method="post" action="/ui/videos/{{ v.id }}/delete"><input type="hidden" name="back" value="{{ back }}"><button class="btn sm" type="submit">{{ _('Togli') }}</button></form>{% endif %}
    {% endif %}
  </div>
</div>
