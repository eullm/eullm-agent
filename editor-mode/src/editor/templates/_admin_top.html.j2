{# The console's top bar: one search for everything, and the language. #}
<div class="topbar">
  <form class="topsearch" method="get" action="/admin/search" role="search">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <input type="search" name="q" value="{{ q or '' }}" placeholder="{{ _('Cerca redazioni, clienti, persone, P.IVA…') }}" aria-label="{{ _('Cerca in tutta la console') }}" autocomplete="off" enterkeyhint="search">
  </form>
  {% include "_lang.html.j2" %}
</div>
